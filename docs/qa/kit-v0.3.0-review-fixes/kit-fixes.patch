+class ActionReader:
+    def __init__(self, stream):
+        self.fd = stream.fileno()
+        self.blocking = os.get_blocking(self.fd)
+        self.buffer = bytearray()
+        os.set_blocking(self.fd, False)
+
+    def read(self, deadline: float) -> bytes | None:
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                return None
+            end = self.buffer.find(b"\n")
+            if end >= 0:
+                require(end + 1 <= 65536, "Action input too large")
+                line = bytes(self.buffer[:end + 1])
+                del self.buffer[:end + 1]
+                return line
+            require(len(self.buffer) <= 65536, "Action input too large")
+            ready, _, _ = select.select([self.fd], [], [], remaining)
+            if not ready:
+                return None
+            try:
+                chunk = os.read(self.fd, min(4096, 65537 - len(self.buffer)))
+            except (BlockingIOError, InterruptedError):
+                continue
+            if not chunk:
+                require(not self.buffer, "Unterminated action frame at EOF")
+                return b""
+            self.buffer.extend(chunk)
+
+    def close(self):
+        os.set_blocking(self.fd, self.blocking)
 
 
