name: Short Intel owned image and kernel readonly diagnosis
'on':
  push:
    branches: [codex/mac-native-boundary-recovery40-20261019]
permissions:
  contents: read
  actions: read
concurrency:
  group: isolated-intel-checkpoint-${{ github.ref }}
  cancel-in-progress: false
env:
  FLOORP_FIXTURE_SHA: 361b16aec48366e17e752dc833c38341a901c596
  HARNESS_SHA: cbe45a7d7480d713b2c40a9ed348420126e6ccb0
  RUNTIME_SHA: 7dd619742b25567e479eeda97ae071d10542ad0b
jobs:
  producer:
    name: checkpoint-producer
    runs-on: macos-15-intel
    timeout-minutes: 20
    steps:
      - name: Bound the initial diagnostic execution
        timeout-minutes: 1
        shell: bash
        run: |
          set -euo pipefail
          test "$GITHUB_REPOSITORY" = Floorp-Projects/Floorp-Runtime
          test "$GITHUB_REF" = refs/heads/codex/mac-native-boundary-recovery40-20261019
          test "$GITHUB_EVENT_NAME" = push
          test "$GITHUB_RUN_ATTEMPT" = 1
          test '${{ github.event.created }}' = true
          test '${{ github.event.before }}' = 0000000000000000000000000000000000000000
          TASK_PYTHON="$RUNNER_TOOL_CACHE/Python/3.12.10/x64/bin/python3"
          test -x "$TASK_PYTHON"
          echo "TASK_PYTHON=$TASK_PYTHON" >> "$GITHUB_ENV"
          echo "TASK_ROOT=$RUNNER_TEMP/floorp-native-checkpoint" >> "$GITHUB_ENV"
      - name: Checkout immutable reviewed fixture
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          repository: Floorp-Projects/Floorp
          ref: ${{ env.FLOORP_FIXTURE_SHA }}
          path: fixture
          persist-credentials: false
          fetch-depth: 1
      - name: Establish this job's fresh clock and private root
        timeout-minutes: 3
        env:
          CHECKPOINT_READ_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          "$TASK_PYTHON" fixture/tools/qa/native-nonpgo/checkpoint_transfer.py init --role producer --task "$TASK_ROOT"
      - name: Observe owned writer controls and native task APIs
        timeout-minutes: 16
        shell: bash
        run: |
          "$TASK_PYTHON" fixture/tools/qa/native-nonpgo/boundary_diagnostic.py --task "$TASK_ROOT" --expected-tests 84
      - name: Verify diagnostic receipt
        if: always()
        timeout-minutes: 1
        shell: bash
        run: |
          "$TASK_PYTHON" - <<'PYCODE'
          import json,os,pathlib
          path=pathlib.Path(os.environ['TASK_ROOT'])/'boundary-diagnostic.json'
          if not path.is_file():
              print('{"status":"failed","code":"boundary-diagnostic-receipt-missing"}',flush=True)
              raise SystemExit(1)
          value=json.loads(path.read_text())
          passed=value['status']=='passed' and value['firstFailure'] is None and value['monitorFailure'] is None
          print(json.dumps({'boundaryDiagnosticStatus':'passed' if passed else 'failed','newArtifacts':0,
                           'productionGateChanged':False,'checkpointEligibilityEstablished':False,
                           'longExecution':'ON_HOLD'}),flush=True)
          raise SystemExit(0 if passed else 1)
          PYCODE
