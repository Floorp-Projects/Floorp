2026-11-05T22:56:09.1575701Z [36;1m          | head -1 \[0m
2026-11-05T22:56:09.1575945Z [36;1m          | awk '{print $NF}' || true)[0m
2026-11-05T22:56:09.1576214Z [36;1m        if [ -z "$FLOORP_TEAM_ID" ]; then[0m
2026-11-05T22:56:09.1576745Z [36;1m          FLOORP_TEAM_ID=$(openssl pkcs12 -in floorpCert.p12 -passin file:floorpCertPassword.passwd -nokeys -clcerts -legacy $OPENSSL_NOENC 2>/dev/null \[0m
