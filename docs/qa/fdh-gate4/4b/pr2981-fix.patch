+++ b/browser-features/modules/common/notes-storage-types.ts
@@ -0,0 +1,51 @@
+export interface NotesPreferenceSnapshot {
+  value: string | null;
+  revision: number;
+  epoch: number;
+  origin: "local" | "external" | "sync";
+  incomingValue?: string;
+  baseValue?: string | null;
+  baseNotesValue?: string | null;
+  accountUid?: string;
+}
+
+export interface NotesSyncContext {
+  epoch: number;
+  revision: number;
+  accountUid: string | null;
+  origin: NotesPreferenceSnapshot["origin"];
+}
+
+export interface NotesSyncStateRead {
+  value: string | null;
+  context: NotesSyncContext;
+}
+
+export interface NotesStorageFunctions {
+  getNotesSnapshot(): Promise<NotesPreferenceSnapshot>;
+  readNotesSyncState(
+    snapshot: NotesPreferenceSnapshot,
+  ): Promise<NotesSyncStateRead>;
+  writeNotesPref(
+    value: string,
+    context?: NotesSyncContext,
+    baseValue?: string | null,
+  ): Promise<NotesPreferenceSnapshot>;
+}
+
+export interface NotesStorageService {
+  getSnapshot(): NotesPreferenceSnapshot;
+  readSyncState(snapshot: NotesPreferenceSnapshot): Promise<NotesSyncStateRead>;
+  writeLocal(
+    value: string,
+    context?: NotesSyncContext,
+    baseValue?: string | null,
+  ): NotesPreferenceSnapshot;
+  applyIncoming(
+    value: string,
+    apply: (merged: string) => Promise<unknown>,
+    expectedEpoch?: number,
+  ): Promise<{ result: unknown; needsUpload: boolean }>;
+  prepareUpload(): Promise<NotesSyncContext>;
+  acknowledgeUploaded(value: string, context: NotesSyncContext): Promise<void>;
+}
diff --git a/browser-features/modules/modules/notes/FloorpNotesPrefsEngine.sys.mts b/browser-features/modules/modules/notes/FloorpNotesPrefsEngine.sys.mts
new file mode 100644
index 000000000000..6a13e114b9bd
--- /dev/null
+++ b/browser-features/modules/modules/notes/FloorpNotesPrefsEngine.sys.mts
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: MPL-2.0
+
+import type {
+  NotesStorageService,
+  NotesSyncContext,
+} from "../../common/notes-storage-types.ts";
+import { decodeNotes } from "../../common/notes-record.ts";
+
+// Use the same profile ESM instance as every Notes page and actor, independent
+// of bundler entry-point splitting.
+const { FloorpNotesStorage } = ChromeUtils.importESModule(
+  "resource://noraneko/modules/notes/FloorpNotesStorage.sys.mjs",
+) as { FloorpNotesStorage: NotesStorageService };
+const { PrefsEngine: NativePrefsEngine } = ChromeUtils.importESModule(
+  "resource://services-sync/engines/prefs.sys.mjs",
+);
+const { Utils } = ChromeUtils.importESModule(
+  "resource://services-sync/util.sys.mjs",
+);
+const NOTES_PREF = "floorp.browser.note.memos";
+const CONTROL_PREF = `services.sync.prefs.sync.${NOTES_PREF}`;
+interface NotesPrefRecord {
+  id: string;
+  value: Record<string, unknown>;
+  cleartext: unknown;
+  deleted?: boolean;
+}
+
+function enabled(): boolean {
+  return Services.prefs.getBoolPref(CONTROL_PREF, false);
+}
+function validNotes(value: unknown): value is string {
+  if (typeof value !== "string") return false;
+  try {
+    decodeNotes(value);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+class NotesPrefStore extends NativePrefsEngine.prototype._storeObj {
+  declare engine: FloorpNotesPrefsEngine;
+
+  async update(record: NotesPrefRecord): Promise<unknown> {
+    if (!await this.itemExists(record.id)) return await super.update(record);
+    const expected = FloorpNotesStorage.getSnapshot().epoch;
+    if (Object.hasOwn(record.value, CONTROL_PREF)) {
+      await super.update({
+        id: record.id,
+        value: { [CONTROL_PREF]: record.value[CONTROL_PREF] },
+      });
+    }
+    if (!enabled()) return await super.update(record);
+
+    const raw = record.value[NOTES_PREF];
+    if (!validNotes(raw)) {
+      const values = { ...record.value };
+      delete values[NOTES_PREF];
+      const result = await super.update({ id: record.id, value: values });
+      if (validNotes(FloorpNotesStorage.getSnapshot().value)) {
+        this.engine.notesChanged(record.id, expected);
+      }
+      return result;
+    }
+    let applied = false;
+    try {
+      const outcome = await FloorpNotesStorage.applyIncoming(
+        raw,
+        async (merged) => {
+          applied = true;
+          const result = await super.update({
+            id: record.id,
+            value: { ...record.value, [NOTES_PREF]: merged },
+          });
+          return result;
+        },
+        expected,
+      );
+      if (outcome.needsUpload) this.engine.notesChanged(record.id, expected);
+      return outcome.result;
+    } catch (error) {
+      this.engine.notesFailed(record.id, expected);
+      if (
+        !applied && FloorpNotesStorage.getSnapshot().epoch === expected
+      ) {
+        const values = { ...record.value };
+        delete values[NOTES_PREF];
+        try {
+          await super.update({ id: record.id, value: values });
+        } catch (fallbackError) {
+          console.error(
+            "[Floorp Notes] Failed to apply unrelated preferences.",
+            fallbackError,
+          );
+        }
+      }
+      throw error;
+    } finally {
+      this._incomingPrefs = record.value;
+    }
+  }
+}
+
+export class FloorpNotesPrefsEngine extends NativePrefsEngine {
+  private notesPending = new Map<string, number>();
+  private notesFailures = new Map<string, number>();
+  private notesUpload: {
+    context: NotesSyncContext;
+    record?: { id: string; value: string };
+  } | null = null;
+
+  notesChanged(id: string, expected: number): void {
+    if (FloorpNotesStorage.getSnapshot().epoch !== expected) return;
+    this.notesPending.set(id, expected);
+    this._tracker.modified = true;
+  }
+
+  notesFailed(id: string, expected: number): void {
+    if (FloorpNotesStorage.getSnapshot().epoch !== expected) return;
+    this.notesFailures.set(id, expected);
+    this.notesChanged(id, expected);
+  }
+
+  async _processIncoming(...args: unknown[]): Promise<unknown> {
+    try {
+      return await super._processIncoming(...args);
+    } finally {
+      const currentEpoch = FloorpNotesStorage.getSnapshot().epoch;
+      for (const [id, expected] of this.notesPending) {
+        if (expected === currentEpoch) this._modified.set(id, 0);
+      }
+      this.notesPending.clear();
+      // Native Sync drops repeatedly failing IDs after two attempts. Keep this
+      // whole prefs record backlogged until its Notes can actually be applied.
+      const failed = this.previousFailedIn;
+      let retain = false;
+      for (const [id, expected] of this.notesFailures) {
+        if (expected === currentEpoch) {
+          failed.add(id);
+          retain = true;
+        }
+      }
+      if (retain) this.previousFailedIn = failed;
+      this.notesFailures.clear();
+    }
+  }
+
+  async _reconcile(record: NotesPrefRecord): Promise<boolean> {
+    const expected = FloorpNotesStorage.getSnapshot().epoch;
+    const shouldApply = await super._reconcile(record);
+    if (
+      !shouldApply && !record.deleted && enabled() &&
+      validNotes(record.value?.[NOTES_PREF]) &&
+      await this._store.itemExists(record.id)
+    ) {
+      const localRecord = await this._createRecord(record.id);
+      if (Utils.deepEquals(record.cleartext, localRecord.cleartext)) {
+        try {
+          const outcome = await FloorpNotesStorage.applyIncoming(
+            record.value[NOTES_PREF] as string,
+            () => Promise.resolve(undefined),
+            expected,
+          );
+          if (outcome.needsUpload) this.notesChanged(record.id, expected);
+        } catch (error) {
+          this.notesFailed(record.id, expected);
+          throw error;
+        }
+      }
+    }
+    return shouldApply;
+  }
+
+  async _uploadOutgoing(): Promise<unknown> {
+    const expected = FloorpNotesStorage.getSnapshot().epoch;
+    const deferred = new Map<string, number>();
+    for (const id of this._modified.ids()) {
+      if (this.previousFailedIn.has(id)) {
+        deferred.set(id, this._modified.getModifiedTimestamp(id));
+        this._modified.delete(id);
+      }
+    }
+    try {
+      if (
+        !enabled() || this._modified.count() === 0 ||
+        !validNotes(FloorpNotesStorage.getSnapshot().value)
+      ) return await super._uploadOutgoing();
+      this.notesUpload = {
+        context: await FloorpNotesStorage.prepareUpload(),
+      };
+      return await super._uploadOutgoing();
+    } finally {
+      this.notesUpload = null;
+      if (FloorpNotesStorage.getSnapshot().epoch === expected) {
+        for (const [id, timestamp] of deferred) this._modified.set(id, timestamp);
+        if (deferred.size) this._tracker.modified = true;
+      }
+    }
+  }
+
+  async _createRecord(id: string): Promise<NotesPrefRecord> {
+    const record = await super._createRecord(id);
+    const value = record.value?.[NOTES_PREF];
+    if (this.notesUpload && !record.deleted && enabled() && validNotes(value)) {
+      this.notesUpload.record = { id: record.id, value };
+    }
+    return record;
+  }
+
+  async _onRecordsWritten(
+    successful: string[],
+    failed: string[],
+    serverTime: number,
+  ): Promise<void> {
+    await super._onRecordsWritten(successful, failed, serverTime);
+    const upload = this.notesUpload;
+    if (!upload?.record || !successful.includes(upload.record.id)) return;
+    try {
+      await FloorpNotesStorage.acknowledgeUploaded(
+        upload.record.value,
+        upload.context,
+      );
+    } catch (error) {
+      // Native Sync already removed successful IDs before invoking this hook.
+      // Keep this acknowledgement failure retryable in memory and on disk.
+      if (FloorpNotesStorage.getSnapshot().epoch === upload.context.epoch) {
+        this._modified.set(upload.record.id, 0);
+        this._tracker.modified = true;
+      }
+      throw error;
+    }
+  }
+}
+FloorpNotesPrefsEngine.prototype._storeObj = NotesPrefStore;
diff --git a/browser-features/modules/modules/notes/FloorpNotesStorage.sys.mts b/browser-features/modules/modules/notes/FloorpNotesStorage.sys.mts
new file mode 100644
index 000000000000..9c105e76f19b
--- /dev/null
+++ b/browser-features/modules/modules/notes/FloorpNotesStorage.sys.mts
@@ -0,0 +1,343 @@
+// SPDX-License-Identifier: MPL-2.0
+
+import type {
+  NotesPreferenceSnapshot,
+  NotesSyncContext,
+  NotesSyncStateRead,
+} from "../../common/notes-storage-types.ts";
+import {
+  decodeNotes,
+  decodeNotesBase,
+  encodeNotes,
+  notesBase,
+} from "../../common/notes-record.ts";
+import { mergeNotesThreeWay } from "../../../pages-notes/src/lib/merge.ts";
+
+const NOTES_PREF = "floorp.browser.note.memos";
+const BASE_PREF = "floorp.browser.note.syncState";
+const CONTEXT_CHANGED = "floorp-notes:context-changed";
+const ACCOUNT_TOPICS = [
+  "weave:service:start-over",
+  "fxaccounts:onlogout",
+  "fxaccounts:onlogin",
+];
+let epoch = 0;
+let revision = 0;
+let accountUid: string | null | undefined;
+let accountLookup: Promise<string | null> | null = null;
+let localWrite: { baseValue?: string | null } | null = null;
+let incoming: {
+  value: string;
+  merged: string;
+  baseValue: string | null;
+  accountUid: string;
+  delivered: boolean;
+} | null = null;
+
+function readNotes(): string | null {
+  return Services.prefs.getPrefType(NOTES_PREF) === Services.prefs.PREF_STRING
+    ? Services.prefs.getStringPref(NOTES_PREF)
+    : null;
+}
+function localNotes(value: string | null) {
+  return value
+    ? decodeNotes(
+      value,
+      true,
+      () => Services.uuid.generateUUID().toString().replace(/[{}]/g, ""),
+    )
+    : [];
+}
+let currentSnapshot: NotesPreferenceSnapshot = {
+  value: readNotes(),
+  epoch,
+  revision,
+  origin: "local",
+};
+
+function assertEpoch(expected: number): void {
+  if (expected !== epoch) throw new Error("Notes account context changed");
+}
+function assertContext(context: NotesSyncContext): void {
+  assertEpoch(context.epoch);
+  if (
+    context.accountUid !== null && accountUid !== undefined &&
+    context.accountUid !== accountUid
+  ) {
+    throw new Error("Notes account identity changed");
+  }
+}
+function invalidateAccount(): void {
+  ++epoch;
+  accountUid = undefined;
+  accountLookup = null;
+  if (Services.prefs.prefHasUserValue(BASE_PREF)) {
+    Services.prefs.clearUserPref(BASE_PREF);
+  }
+  currentSnapshot = {
+    value: readNotes(),
+    epoch,
+    revision: ++revision,
+    origin: "local",
+  };
+  Services.obs.notifyObservers(Services.prefs, CONTEXT_CHANGED);
+}
+async function readAccount(expected: number): Promise<string | null> {
+  if (!accountLookup) {
+    const lookup = (async () => {
+      const { getFxAccountsSingleton } = ChromeUtils.importESModule(
+        "resource://gre/modules/FxAccounts.sys.mjs",
+      ) as {
+        getFxAccountsSingleton(): {
+          getSignedInUser(): Promise<{ uid?: string } | null>;
+        };
+      };
+      const user = await getFxAccountsSingleton().getSignedInUser();
+      assertEpoch(expected);
+      const uid = user?.uid ?? null;
+      if (accountUid !== undefined && accountUid !== uid) {
+        invalidateAccount();
+        throw new Error("Notes account identity changed");
+      }
+      accountUid = uid;
+      return uid;
+    })();
+    accountLookup = lookup;
+    lookup.finally(() => {
+      if (accountLookup === lookup) accountLookup = null;
+    }).catch(() => {});
+  }
+  return await accountLookup;
+}
+function boundBase(uid: string | null): string | null {
+  if (!uid) return null;
+  const raw = Services.prefs.getStringPref(BASE_PREF, "");
+  try {
+    const parsed: unknown = raw ? JSON.parse(raw) : null;
+    if (
+      typeof parsed === "object" && parsed !== null && "accountUid" in parsed &&
+      parsed.accountUid === uid
+    ) return raw;
+  } catch { /* An unreadable base cannot authorize deletion. */ }
+  if (raw && Services.prefs.prefHasUserValue(BASE_PREF)) {
+    Services.prefs.clearUserPref(BASE_PREF);
+  }
+  return null;
+}
+function acknowledge(value: string, uid: string): void {
+  const intended = JSON.stringify({
+    accountUid: uid,
