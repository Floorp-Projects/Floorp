        "line": 58,
        "text": "                Urls.openUrl('extensions-that-conflict-with-stg', true);"
      },
      {
        "line": 59,
        "text": "                return true;"
      },
      {
        "line": 60,
        "text": "            }"
      },
      {
        "line": 61,
        "text": "        } else if (extensionsStorage[id] && isIgnoredConflictedExtension(id)) {"
