{
  "id": "native-lepton-setting",
  "script": "const p=Services.prefs;const d=JSON.parse(p.getStringPref(\"floorp.design.configs\"));d.globalConfigs.userInterface=\"lepton\";p.setStringPref(\"floorp.design.configs\",JSON.stringify(d));return {design:JSON.parse(p.getStringPref(\"floorp.design.configs\")).globalConfigs.userInterface,disableFloorpStart:d.uiCustomization.disableFloorpStart};"
