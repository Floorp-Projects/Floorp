Program("floorp-app-shim")
DisableStlWrapping()
NO_PGO = True

SOURCES += [
    "ColdLaunch.mm",
    "MachTransport.mm",
    "main.mm",
    "PeerIdentity.mm",
    "Protocol.mm",
    "Session.mm",
    "ShimApplication.mm",
    "ShimView.mm",
]

CXXFLAGS += ["-fobjc-arc"]
OS_LIBS += [
    "-framework Carbon",
    "-framework Cocoa",
    "-framework IOSurface",
    "-framework QuartzCore",
    "-framework Security",
    "bsm",
]
