    "excerpt": [
      {
        "line": 262,
        "text": "function getRenderableTreeItems(windowId = null) {"
      },
      {
        "line": 263,
        "text": "  if (!windowId) {"
      },
      {
        "line": 264,
        "text": "    windowId = TabsStore.getCurrentWindowId();"
      },
      {
        "line": 265,
        "text": "  }"
      },
      {
        "line": 266,
        "text": ""
      },
      {
        "line": 267,
        "text": "  if (TabsStore.nativelyGroupedTabsInWindow.get(windowId).size == 0) {"
      },
      {
        "line": 268,
        "text": "    log('getRenderableTreeItems: no native tab group');"
      },
      {
        "line": 269,
        "text": "    return TabsStore.queryAll({"
      },
      {
        "line": 270,
        "text": "      windowId,"
      },
      {
        "line": 271,
        "text": "      tabs:         TabsStore.getTabsMap(TabsStore.virtualScrollRenderableTabsInWindow, windowId),"
      },
      {
        "line": 272,
        "text": "      skipMatching: true,"
      },
      {
        "line": 273,
        "text": "      ordered:      true,"
      },
      {
        "line": 274,
        "text": "    }).filter(splitViewHiddenTabFilter);"
      },
      {
        "line": 275,
        "text": "  }"
      },
      {
        "line": 276,
        "text": ""
      },
      {
        "line": 277,
        "text": "  const mixedItems = TreeItem.sort(["
      },
      {
        "line": 278,
        "text": "    ...TabsStore.queryAll({"
      },
      {
        "line": 279,
        "text": "      windowId,"
      },
      {
        "line": 280,
        "text": "      tabs:         TabsStore.getTabsMap(TabsStore.virtualScrollRenderableTabsInWindow, windowId),"
      },
      {
        "line": 281,
        "text": "      skipMatching: true,"
      },
      {
        "line": 282,
        "text": "    }).filter(splitViewHiddenTabFilter),"
      },
      {
        "line": 283,
        "text": "    ...mapAndFilter("
      },
      {
        "line": 284,
        "text": "      [...TabsStore.windows.get(windowId).tabGroups.values()],"
      },
      {
        "line": 285,
        "text": "      group => {"
      },
      {
        "line": 286,
        "text": "        group.$TST.reindex();"
      },
      {
        "line": 287,
        "text": "        if (group.collapsed) {"
      },
      {
        "line": 288,
        "text": "          const members = group.$TST.members;"
      },
      {
        "line": 289,
        "text": "          if (members.length > 1 && members.some(tab => tab.active)) {"
      },
      {
        "line": 290,
        "text": "            const counterItem = group.$TST.collapsedMembersCounterItem;"
      },
      {
        "line": 291,
        "text": "            counterItem.$TST.update();"
      },
      {
        "line": 292,
        "text": "            return [group, counterItem];"
      },
      {
        "line": 293,
        "text": "          }"
      },
      {
        "line": 294,
        "text": "        }"
      },
      {
        "line": 295,
        "text": "        return group;"
      },
      {
        "line": 296,
        "text": "      }"
      },
      {
        "line": 297,
        "text": "    ).flat(),"
      },
      {
        "line": 298,
        "text": "  ]);"
      },
      {
        "line": 299,
        "text": "  log('getRenderableTreeItems: mixedItems = ', mixedItems);"
      },
      {
        "line": 300,
        "text": "  return mixedItems;"
      },
      {
        "line": 301,
        "text": "}"
      }
