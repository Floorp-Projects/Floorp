    "matchesSignedXpi": true,
    "excerpt": [
      {
        "line": 534,
        "text": "export function updateVirtualScrollRenderabilityIndexForTab(tab) {"
      },
      {
        "line": 535,
        "text": "  if (!tab)"
      },
      {
        "line": 536,
        "text": "    return;"
      },
      {
        "line": 537,
        "text": ""
      },
      {
        "line": 538,
        "text": "  if (tab.pinned ||"
      },
      {
        "line": 539,
        "text": "      (tab.hidden &&"
      },
      {
        "line": 540,
        "text": "       ((tab.url == 'about:firefoxview' &&"
      },
      {
        "line": 541,
        "text": "         tab.cookieStoreId == 'firefox-default') ||"
      },
      {
        "line": 542,
        "text": "        !configs.renderHiddenTabs)) ||"
      },
      {
        "line": 543,
        "text": "      tab.$TST?.states.has(Constants.kTAB_STATE_COLLAPSED_DONE) ||"
      },
      {
        "line": 544,
        "text": "      (tabGroups.get(tab.groupId)?.$TST?.states.has(Constants.kTAB_STATE_COLLAPSED_DONE) &&"
      },
      {
        "line": 545,
        "text": "       !tab.active))"
      },
      {
        "line": 546,
        "text": "    removeVirtualScrollRenderableTab(tab);"
      },
      {
        "line": 547,
        "text": "  else"
      },
      {
        "line": 548,
        "text": "    addVirtualScrollRenderableTab(tab);"
      },
      {
        "line": 549,
        "text": "}"
      }
    ]
  },
