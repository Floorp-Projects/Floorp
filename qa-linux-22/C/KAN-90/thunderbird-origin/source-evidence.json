        "line": 625,
        "text": "  // method to check if the URI scheme is supported and then use"
      },
      {
        "line": 626,
        "text": "  // generic nsFlatpakHandlerApp which forwards launch call to the system."
      },
      {
        "line": 627,
        "text": "  if (widget::ShouldUsePortal(widget::PortalKind::MimeHandler)) {"
      },
      {
        "line": 628,
        "text": "    if (mozilla::net::IsLoopbackHostname(aURIScheme)) {"
      },
      {
        "line": 629,
        "text": "      // When the user writes foo:1234, we try to handle it natively using"
      },
      {
        "line": 630,
        "text": "      // GetAppForURIScheme, and if that fails, we carry on. On flatpak there's"
      },
      {
        "line": 631,
        "text": "      // no way to know if an app has handlers or not. Some things like"
      },
      {
        "line": 632,
        "text": "      // localhost:1234 are really unlikely to be handled by native"
      },
      {
        "line": 633,
        "text": "      // apps, and we're much better off returning an error here instead."
      },
      {
        "line": 634,
        "text": "      return NS_ERROR_FAILURE;"
