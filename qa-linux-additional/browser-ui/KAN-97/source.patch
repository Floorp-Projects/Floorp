diff --git a/browser-features/chrome/common/mouse-gesture/utils/scroll-target.ts b/browser-features/chrome/common/mouse-gesture/utils/scroll-target.ts
new file mode 100644
index 00000000..d29e2769
--- /dev/null
+++ b/browser-features/chrome/common/mouse-gesture/utils/scroll-target.ts
@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: MPL-2.0
+
+/** Keep scrolling in the selected tab, including its focused child frame. */
+export function getScrollTargetContext<T extends { readonly top: unknown }>(
+  selected: T,
+  focused: T | null | undefined,
+): T {
+  return focused && focused.top === selected ? focused : selected;
+}
