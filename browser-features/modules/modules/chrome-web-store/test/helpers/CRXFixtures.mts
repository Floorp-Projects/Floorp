export function concatBytes(...parts: Uint8Array[]): Uint8Array<ArrayBuffer> {
  const output = new Uint8Array(
    parts.reduce((size, part) => size + part.length, 0),
  );
  let offset = 0;
  for (const part of parts) {
    output.set(part, offset);
    offset += part.length;
  }
  return output;
}

export function uint32(value: number): Uint8Array<ArrayBuffer> {
  const bytes = new Uint8Array(4);
  new DataView(bytes.buffer).setUint32(0, value, true);
  return bytes;
}

function fromBase64(base64: string): Uint8Array<ArrayBuffer> {
  return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0));
}

export function protobufBytes(
  number: number,
  data: Uint8Array,
): Uint8Array<ArrayBuffer> {
  const varint = (value: number): Uint8Array => {
    const bytes = [];
    do {
      bytes.push((value & 127) | (value > 127 ? 128 : 0));
      value >>>= 7;
    } while (value);
    return new Uint8Array(bytes);
  };
  return concatBytes(varint(number * 8 + 2), varint(data.length), data);
}

const MAGIC = new TextEncoder().encode("Cr24");

export async function createSignedCRX2(zip: Uint8Array): Promise<ArrayBuffer> {
  const publicKey = fromBase64(RSA_PUBLIC_KEY);
  const key = await crypto.subtle.importKey(
    "pkcs8",
    fromBase64(RSA_PRIVATE_KEY),
    { name: "RSASSA-PKCS1-v1_5", hash: "SHA-1" },
    false,
    ["sign"],
  );
  const signature = new Uint8Array(
    await crypto.subtle.sign("RSASSA-PKCS1-v1_5", key, concatBytes(zip)),
  );
  return concatBytes(
    MAGIC,
    uint32(2),
    uint32(publicKey.length),
    uint32(signature.length),
    publicKey,
    signature,
    zip,
  ).buffer;
}

/** Convert WebCrypto P-256 r || s into the CRX3 DER sequence. */
function encodeECDSA(raw: Uint8Array): Uint8Array<ArrayBuffer> {
  const integer = (scalar: Uint8Array): Uint8Array => {
    let start = 0;
    while (start < scalar.length - 1 && scalar[start] === 0) start++;
    const value = scalar.subarray(start);
    const positive =
      value[0] & 128 ? concatBytes(new Uint8Array([0]), value) : value;
    return concatBytes(new Uint8Array([2, positive.length]), positive);
  };
  const sequence = concatBytes(
    integer(raw.subarray(0, 32)),
    integer(raw.subarray(32)),
  );
  return concatBytes(new Uint8Array([0x30, sequence.length]), sequence);
}

export interface CRX3FixtureOptions {
  algorithm?: "rsa" | "ecdsa";
  /** Deliberately declare another ID while signing with the fixture key. */
  declaredChromeId?: string;
  /** Deliberately sign another domain-separation context. */
  signatureContext?: string;
  /** Sign malformed signed-header protobuf while retaining a genuine proof. */
  signedHeader?: Uint8Array;
  /** Malform signature bytes after a real signing operation. */
  transformSignature?: (signature: Uint8Array<ArrayBuffer>) => Uint8Array;
  /** Add unsigned protobuf data for strict parser cases. */
  extraHeader?: Uint8Array;
}

export async function createSignedCRX3(
  zip: Uint8Array,
  options: CRX3FixtureOptions = {},
): Promise<ArrayBuffer> {
  const ecdsa = options.algorithm === "ecdsa";
  const declaredChromeId =
    options.declaredChromeId ?? (ecdsa ? CRX_ECDSA_TEST_ID : CRX_TEST_ID);
  const id = new Uint8Array(16);
  for (let index = 0; index < 16; index++) {
    id[index] =
      (declaredChromeId.charCodeAt(index * 2) - 97) * 16 +
      declaredChromeId.charCodeAt(index * 2 + 1) -
      97;
  }
  const signedHeader = options.signedHeader ?? protobufBytes(1, id);
  const signedData = concatBytes(
    new TextEncoder().encode(options.signatureContext ?? "CRX3 SignedData\x00"),
    uint32(signedHeader.length),
    signedHeader,
    zip,
  );
  const publicKey = fromBase64(ecdsa ? ECDSA_PUBLIC_KEY : RSA_PUBLIC_KEY);
  let signature: Uint8Array<ArrayBuffer>;
  if (ecdsa) {
    const key = await crypto.subtle.importKey(
      "pkcs8",
      fromBase64(ECDSA_PRIVATE_KEY),
      { name: "ECDSA", namedCurve: "P-256" },
      false,
      ["sign"],
    );
    signature = encodeECDSA(
      new Uint8Array(
        await crypto.subtle.sign(
          { name: "ECDSA", hash: "SHA-256" },
          key,
          signedData,
        ),
      ),
    );
  } else {
    const key = await crypto.subtle.importKey(
      "pkcs8",
      fromBase64(RSA_PRIVATE_KEY),
      { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" },
      false,
      ["sign"],
    );
    signature = new Uint8Array(
      await crypto.subtle.sign("RSASSA-PKCS1-v1_5", key, signedData),
    );
  }
  signature = concatBytes(options.transformSignature?.(signature) ?? signature);
  const proof = concatBytes(
    protobufBytes(1, publicKey),
    protobufBytes(2, signature),
  );
  const header = concatBytes(
    protobufBytes(ecdsa ? 3 : 2, proof),
    protobufBytes(10000, signedHeader),
    options.extraHeader ?? new Uint8Array(),
  );
  return concatBytes(MAGIC, uint32(3), uint32(header.length), header, zip)
    .buffer;
}
