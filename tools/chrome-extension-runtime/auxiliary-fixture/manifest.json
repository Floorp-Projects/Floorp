{
  "manifest_version": 3,
  "name": "Floorp authored auxiliary API contract",
  "version": "1.0",
  "key": "",
  "permissions": [
    "storage",
    "notifications",
    "declarativeContent",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
