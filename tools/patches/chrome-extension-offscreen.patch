+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+Cu.importGlobalProperties(["AbortController"]);
+
+var { ExtensionParent } = ChromeUtils.importESModule(
+  "resource://gre/modules/ExtensionParent.sys.mjs"
+);
+var { setTimeout: offscreenSetTimeout, clearTimeout: offscreenClearTimeout } =
+  ChromeUtils.importESModule("resource://gre/modules/Timer.sys.mjs");
+
+class FloorpOffscreenPage extends ExtensionParent.HiddenExtensionPage {
+  constructor(extension) {
+    super(extension, "offscreen");
+    this.abortController = new AbortController();
+    this.audioTimer = null;
+    this.mediaController = null;
+    this.onAudibleChange = null;
+  }
+
+  async build(url) {
+    await this.createBrowserElement();
+    ExtensionParent.apiManager.emit("extension-browser-inserted", this.browser);
+    const loaded = ExtensionParent.promiseExtensionViewLoaded(
+      this.browser, "Extension:OffscreenViewLoaded", this.abortController.signal
+    );
+    this.browser.fixupAndLoadURIString(url, {
+      triggeringPrincipal: this.extension.principal,
+    });
+    const context = await loaded;
+    if (!context || this.unloaded) {
+      throw new ExtensionUtils.ExtensionError("Offscreen document failed to load");
+    }
+    return context;
+  }
+
+  watchAudio(onSilent) {
+    this.mediaController = this.browser.browsingContext.mediaController;
+    this.onAudibleChange = () => {
+      offscreenClearTimeout(this.audioTimer);
+      this.audioTimer = null;
+      if (!this.mediaController.isAudible) {
+        this.audioTimer = offscreenSetTimeout(onSilent, 30000);
+      }
+    };
+    this.mediaController.addEventListener("audiblechange", this.onAudibleChange);
+    this.onAudibleChange();
+  }
+
+  close() {
+    if (this.unloaded) {
+      return;
+    }
+    this.abortController.abort();
+    offscreenClearTimeout(this.audioTimer);
+    this.mediaController?.removeEventListener("audiblechange", this.onAudibleChange);
+    this.mediaController = null;
+    super.shutdown();
+  }
+}
+
+// Owned by the extension API instance, never by the calling background context.
+this.offscreen = class extends ExtensionAPI {
+  page = null;
+
+  onShutdown() {
+    this.closePage();
+  }
+
+  closePage() {
+    const page = this.page;
+    this.page = null;
+    page?.close();
+  }
+
+  getAPI(context) {
+    const { extension } = this;
+    const marker = extension.manifest.browser_specific_settings?.gecko
+      ?.floorp_chrome_extension;
+    if (marker?.schema_version !== 1 ||
+        !/^[a-p]{32}$/.test(marker.original_id) ||
+        extension.id !== `${marker.original_id}@chromium-extension`) {
+      return {};
+    }
+    return {
+      offscreen: {
+        createDocument: async options => {
+          if (this.page) {
+            throw new ExtensionUtils.ExtensionError(
+              "Only a single offscreen document may be created."
+            );
+          }
+          const uri = Services.io.newURI(extension.baseURI.resolve(options.url));
+          if (!uri.schemeIs("moz-extension") ||
+              uri.prePath !== extension.baseURI.prePath) {
+            throw new ExtensionUtils.ExtensionError(
+              "Offscreen document URL must belong to the extension."
+            );
+          }
+          if (!options.justification.trim()) {
+            throw new ExtensionUtils.ExtensionError("Justification must be specified.");
+          }
+          const page = new FloorpOffscreenPage(extension);
+          // Reserve before awaiting: concurrent callers cannot create two hosts.
+          this.page = page;
+          try {
+            const offscreenContext = await page.build(uri.spec);
+            offscreenContext.callOnClose({ close: () => {
+              if (this.page === page) {
+                this.closePage();
+              }
+            }});
+            if (options.reasons.includes("AUDIO_PLAYBACK")) {
+              page.watchAudio(() => {
+                if (this.page === page) {
+                  this.closePage();
+                }
+              });
+            }
+          } catch (error) {
+            if (this.page === page) {
+              this.page = null;
+            }
+            page.close();
+            throw error;
+          }
+        },
+        closeDocument: async () => {
+          if (!this.page) {
+            throw new ExtensionUtils.ExtensionError("No current offscreen document.");
+          }
+          this.closePage();
+        },
+        hasDocument: async () => !!this.page && !this.page.unloaded,
+      },
+    };
+  }
+};
