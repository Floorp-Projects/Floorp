+// Public Chrome URLs are presentation/resource aliases only. Keep internal
+// extension.getURL/baseURI/principals, schema resolution and IPC addresses native.
+function getExtensionPublicURL(extension, path) {
+  const id = getChromeExtensionId(extension);
+  if (!id) return extension.getURL(path);
+  // Match Chrome's UrlFromPathAndId fixed-prefix construction. Resolving path
+  // against a base would let absolute or protocol-relative input change origin.
+  const slash = path.startsWith("/") ? "" : "/";
+  // Chrome registers its extension scheme as a standard hierarchical GURL;
+  // Gecko's dynamically registered alias uses the unknown-scheme parser.
+  // A fixed-own-host standard URI gives the same path canonicalization
+  // (including backslashes). This constructs a string, never a channel.
+  const canonical = Services.io.newURI(`https://${id}${slash}${path}`);
+  if (canonical.host !== id || canonical.userPass || canonical.port !== -1) {
+    throw new ExtensionError("Invalid public Chrome extension URL");
+  }
+  return "chrome-extension:" + canonical.spec.slice("https:".length);
+}
+
+// Use only at an API boundary which accepts an absolute own resource URL.
+// Foreign aliases cannot become privileged own URLs, including public WAR URLs.
+function canonicalizeChromeExtensionResourceURL(extension, value) {
+  const id = getChromeExtensionId(extension);
+  if (!id || !/^chrome-extension:/i.test(value)) return value;
+  let alias;
+  try { alias = new URL(value); } catch {
+    throw new ExtensionError("Invalid Chrome extension resource URL");
+  }
+  if (alias.protocol !== "chrome-extension:" || alias.hostname !== id ||
+      alias.username || alias.password || alias.port) {
+    throw new ExtensionError("Resource URL must belong to the extension");
+  }
+  // Concatenate the path; resolving a // path could replace the native host.
+  return Services.io.newURI(extension.baseURI.prePath +
+    alias.pathname + alias.search + alias.hash).spec;
 }
 
