+      const lastError = Cu.cloneInto(
+        { message: context.normalizeError(error, caller).message },
+        context.cloneScope
+      );
+      Services.tm.dispatchToMainThreadWithMicroTask(() => {
+        if (!context.active || context.unloaded) {
+          return;
+        }
