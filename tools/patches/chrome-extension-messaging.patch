+/**
+ * Get the original Chrome ID only for an explicitly converted extension whose
+ * installed Gecko ID agrees with its compatibility metadata. Internal identity
+ * (permissions, URLs, storage and IPC addressing) continues to use the Gecko ID.
+ *
+ * @param {object} extension Extension or ExtensionChild instance.
+ * @returns {string|null} Validated original Chrome extension ID.
+ */
+function getChromeExtensionId(extension) {
+  const marker =
+    extension?.manifest?.browser_specific_settings?.gecko
+      ?.floorp_chrome_extension;
+  const id = marker?.original_id;
+  return marker?.schema_version === 1 &&
+    typeof id === "string" &&
+    /^[a-p]{32}$/.test(id) &&
+    extension.id === `${id}@chromium-extension`
+    ? id
+    : null;
+}
+
 export var ExtensionUtils = {
   flushJarCache,
   getInnerWindowID,
   getMessageManager,
   getUniqueId,
+  getChromeExtensionId,
   makeDataURI,
   isExtensionUrl,
   parseMatchPatterns,
