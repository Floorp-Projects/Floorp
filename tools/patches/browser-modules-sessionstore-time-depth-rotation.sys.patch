+   */
+  async #maybeRotateRecovery() {
+    const ROTATION_PREFIX = "rotation-";
+    let interval = Services.prefs.getIntPref(
+      "floorp.sessionstore.rotation.interval",
+      3600000
+    );
+    let maxCopies = Services.prefs.getIntPref(
+      "floorp.sessionstore.rotation.max",
+      48
+    );
+    if (interval <= 0 || maxCopies <= 0) {
+      return;
+    }
+
+    let children;
+    try {
+      children = await IOUtils.getChildren(this.#paths.backups);
+    } catch (ex) {
+      // The backups directory may not be listable yet; rotations can
+      // resume at the next write.
+      return;
+    }
+    let copies = children.filter(path =>
+      PathUtils.filename(path).startsWith(ROTATION_PREFIX)
+    );
+
+    if (!this.#rotationScanned) {
+      this.#rotationScanned = true;
+      for (let copy of copies) {
+        let ts = parseInt(
+          PathUtils.filename(copy).slice(ROTATION_PREFIX.length, -".jsonlz4".length),
+          10
+        );
+        if (!isNaN(ts) && ts > this.#lastRotationMs) {
+          this.#lastRotationMs = ts;
+        }
+      }
+    }
+
+    let now = Date.now();
+    if (now - this.#lastRotationMs < interval) {
+      return;
+    }
+
+    let target = PathUtils.join(
+      this.#paths.backups,
+      `${ROTATION_PREFIX}${now}.jsonlz4`
+    );
+    await IOUtils.copy(this.#paths.recovery, target);
+    this.#lastRotationMs = now;
+    copies.push(target);
+
