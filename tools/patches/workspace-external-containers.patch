+/**
+ * Floorp's fallback for an external open with no Firefox container guess.
+ * Resolve it before creating the browser: changing a tab's attribute at
+ * TabOpen is too late to change its browsing context or cookie/storage jar.
+ * A new or not-yet-initialized window uses the persisted default workspace.
+ *
+ * @param {ChromeWindow|null} [win=null] The final target window, if available.
+ * @param {boolean} [forcePrivate=false]
+ * @returns {number}
+ */
+export function getWorkspaceUserContextIdForExternalOpen(
+  win = null,
+  forcePrivate = false
+) {
+  try {
+    if (
+      forcePrivate ||
+      lazy.PrivateBrowsingUtils.permanentPrivateBrowsing ||
+      (win && lazy.PrivateBrowsingUtils.isWindowPrivate(win)) ||
+      !Services.prefs.getBoolPref("floorp.workspaces.enabled", true) ||
+      !Services.prefs.getBoolPref("privacy.userContext.enabled", false) ||
+      Services.prefs.getBoolPref(
+        "browser.link.force_default_user_context_id_for_external_opens",
+        false
+      )
+    ) {
+      return 0;
+    }
+
+    let userContextId;
+    if (
+      typeof win?.workspacesFuncs?.getCurrentWorkspaceUserContextId ==
+      "function"
+    ) {
+      userContextId = win.workspacesFuncs.getCurrentWorkspaceUserContextId();
+    } else {
+      const store = JSON.parse(
+        Services.prefs.getStringPref("floorp.workspaces.v4.store", "{}")
+      );
+      // data.ts persists its Map as [workspace UUID, workspace] pairs.
+      if (
+        typeof store?.defaultID != "string" ||
+        !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
+          store.defaultID
+        ) ||
+        !Array.isArray(store.data) ||
+        !store.data.every(entry => Array.isArray(entry) && entry.length == 2)
+      ) {
+        return 0;
+      }
+      userContextId = new Map(store.data).get(store.defaultID)?.userContextId;
+    }
+
+    // A deleted, malformed, or internal identity must never choose a jar.
+    if (
+      !Number.isInteger(userContextId) ||
+      userContextId <= 0 ||
+      userContextId > 0xffffffff ||
+      !lazy.ContextualIdentityService.getPublicIdentityFromId(userContextId)
+    ) {
+      return 0;
+    }
+    return userContextId;
+  } catch {
+    // Preference migration and window startup must not prevent external opens.
+    return 0;
+  }
+}
