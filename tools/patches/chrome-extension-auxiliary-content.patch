+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+export class ChromeDeclarativeContentChild extends JSWindowActorChild {
+  handleEvent() {
+    if (!this.observer && this.document.documentElement) {
+      this.observer = new this.contentWindow.MutationObserver(() =>
+        this.changed()
+      );
+      this.progress = this.docShell.QueryInterface(Ci.nsIInterfaceRequestor)
+        .getInterface(Ci.nsIWebProgress);
+      this.progressListener = {
+        QueryInterface: ChromeUtils.generateQI([
+          "nsIWebProgressListener",
+          "nsISupportsWeakReference",
+        ]),
+        onLocationChange: () => this.changed(),
+      };
+      this.progress.addProgressListener(
+        this.progressListener,
+        Ci.nsIWebProgress.NOTIFY_LOCATION,
+      );
+      this.observer.observe(this.document.documentElement, {
+        childList: true,
+        subtree: true,
+        attributes: true,
+        characterData: true,
+      });
+      for (const name of ["input", "change", "click", "focusin", "focusout"]) {
+        this.document.addEventListener(name, this, { capture: true });
+      }
+    }
+    this.changed();
+  }
+  changed() {
+    if (this.queued) {
+      return;
+    }
+    this.queued = true;
+    this.contentWindow.setTimeout(() => {
+      this.queued = false;
+      this.sendAsyncMessage("Changed");
+    }, 0);
+  }
+  receiveMessage({ name, data }) {
+    if (name === "Match") {
+      if (!this.observer) {
+        this.handleEvent();
+      }
+      return {
+        url: this.document.documentURI,
+        results: data.selectors.map((selectors) =>
+          selectors.every((selector) =>
+            Boolean(this.document.querySelector(selector))
+          )
+        ),
+      };
+    }
+    return undefined;
+  }
+  didDestroy() {
+    this.progress?.removeProgressListener(this.progressListener);
+    this.progressListener = null;
+    this.progress = null;
+    this.observer?.disconnect();
+    for (const name of ["input", "change", "click", "focusin", "focusout"]) {
+      this.document.removeEventListener(name, this, { capture: true });
+    }
+  }
+}
