+        },
+        child: {
+          esModuleURI:
+            "resource://gre/modules/ChromeDeclarativeContentChild.sys.mjs",
+          events: { DOMContentLoaded: {}, pageshow: {} },
+        },
+        matches: ["http://*/*", "https://*/*", "file://*/*"],
+      });
