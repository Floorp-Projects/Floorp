+      "extension-store",
+      "chrome-declarative-content",
+      this.id + ".json",
+    );
+    this.permissionChanged = () => {
+      this.epoch++;
+      if (!extension.hasPermission("declarativeContent")) {
+        this.clearEffects();
+      } else {
