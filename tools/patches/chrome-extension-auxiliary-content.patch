+    if (conditions.some((c) => c.isBookmarked !== undefined)) {
+      bookmarked = Boolean(
+        await PlacesUtils.bookmarks.fetch({ url: uri.spec }),
+      );
+    }
+    if (
+      this.closed || state.revision !== revision || this.epoch !== epoch ||
+      !extension.hasPermission("declarativeContent") ||
+      !extension.canAccessWindow(win) ||
+      WebExtensionPolicy.isRestrictedURI(uri) ||
+      WebExtensionPolicy.isQuarantinedURI(uri) ||
+      extension.policy.checkGuarded(uri) ||
+      browser.browsingContext.currentWindowGlobal !== wg ||
+      result.url !== uri.spec
+    ) {
+      return;
+    }
+    if (state.document !== wg.innerWindowId) {
+      state.document = wg.innerWindowId;
+      state.executed.clear();
+    }
+    let index = 0;
+    const matched = candidates.filter((rule) => {
+      let any = false;
+      for (const condition of rule.conditions) {
+        const css = result.results[index++];
+        any ||= css && condition.url(uri.spec) &&
+          (condition.isBookmarked === undefined ||
+            condition.isBookmarked === bookmarked);
+      }
+      return any;
+    });
