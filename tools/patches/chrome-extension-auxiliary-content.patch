+import { ExtensionUtils } from "resource://gre/modules/ExtensionUtils.sys.mjs";
+import { MatchURLFilters } from "resource://gre/modules/MatchURLFilters.sys.mjs";
+import { PlacesUtils } from "resource://gre/modules/PlacesUtils.sys.mjs";
+
+const { ExtensionError, getChromeExtensionId } = ExtensionUtils;
+const managers = new Set();
+const pendingWrites = new Map();
+let actorsRegistered = false;
+const ACTOR = "ChromeDeclarativeContent";
+Cu.importGlobalProperties(["DOMParser"]);
+const selectorDocument = new DOMParser().parseFromString(
+  "<!doctype html>",
+  "text/html",
+);
+const MAX_RULES = 1000;
+const URL_KEYS = new Set([
+  "schemes",
+  "ports",
+  "urlMatches",
+  "originAndPathMatches",
+]);
+for (const part of ["host", "path", "query", "url"]) {
+  for (const test of ["Contains", "Equals", "Prefix", "Suffix"]) {
+    URL_KEYS.add(part + test);
+  }
+}
+
+export function documentChanged(browsingContext) {
+  for (const manager of managers) {
+    manager.changed(browsingContext);
+  }
+}
+
+function allTabs() {
+  const tabs = [];
+  for (const win of Services.wm.getEnumerator("navigator:browser")) {
+    tabs.push(...(win.gBrowser?.tabs || []));
+  }
+  return tabs;
+}
+
+function ownKeys(value, allowed) {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    throw new ExtensionError("Expected a declarative condition/action object.");
+  }
+  for (const key of Object.keys(value)) {
+    if (!allowed.includes(key)) {
+      throw new ExtensionError(`Unexpected declarative property '${key}'.`);
+    }
+  }
+}
+
+function compileURL(filter, extension) {
+  if (!filter || typeof filter !== "object" || Array.isArray(filter)) {
+    throw new ExtensionError("pageUrl must be a URL filter object.");
+  }
+  const plain = {};
+  const regexes = [];
+  for (const [key, value] of Object.entries(filter)) {
+    if (!URL_KEYS.has(key)) {
+      throw new ExtensionError(`Unexpected URL filter property '${key}'.`);
+    }
+    if (key === "schemes") {
+      if (!Array.isArray(value) || value.some((v) => typeof v !== "string")) {
+        throw new ExtensionError("schemes must be an array of strings.");
+      }
+    } else if (key === "ports") {
+      const port = (n) => Number.isInteger(n) && n >= 0 && n <= 65535;
+      if (
+        !Array.isArray(value) || value.some((v) =>
+          !port(v) &&
+          !(Array.isArray(v) && v.length === 2 && v.every(port) && v[0] <= v[1])
+        )
+      ) {
+        throw new ExtensionError("Invalid URL filter port/range.");
+      }
+    } else if (typeof value !== "string") {
+      throw new ExtensionError(`${key} must be a string.`);
+    }
+    if (key === "urlMatches" || key === "originAndPathMatches") {
+      if (!("@floorp.app/extensions/chrome-dnr-regex;1" in Cc)) {
+        throw new ExtensionError(
+          "URL regular expressions require the native Chrome regex engine.",
+        );
+      }
+      const regex = ExtensionDNR.compileRegexFilter(value, true, extension);
+      regexes.push({ key, regex });
+    } else {
+      plain[key] = value;
+    }
+  }
+  const native = new MatchURLFilters([plain]);
+  return (url) =>
+    native.matches(url) && regexes.every(({ key, regex }) => {
+      const target = key === "urlMatches" ? url : (() => {
+        const uri = Services.io.newURI(url).QueryInterface(Ci.nsIURL);
+        return uri.prePath + uri.filePath;
+      })();
+      return regex.test(target);
+    });
