+      const data = await IOUtils.readJSON(this.path);
+      if (
+        data.schemaVersion !== 1 || !Array.isArray(data.rules) ||
+        data.rules.length > MAX_RULES
+      ) {
+        throw new Error("Invalid declarativeContent persistence format");
+      }
+      for (const rule of data.rules) {
+        const compiled = this.validate(rule, new Set(this.rules.keys()));
+        this.rules.set(compiled.rule.id, compiled);
+      }
+    } catch (error) {
+      if (error.name !== "NotFoundError") {
+        console.error(
+          "[ChromeDeclarativeContent] Cannot load persisted rules",
+          error,
+        );
+        this.rules.clear();
+      }
+    }
+    if (!this.closed) {
+      this.updateAll();
+    }
+  }
+  action() {
+    if (this.closed || this.nativeAction) return this.nativeAction;
+    const manifest = this.extension.manifest;
+    if (!(manifest.page_action || manifest.action || manifest.browser_action)) {
+      return undefined;
+    }
+    const name = this.extension.manifest.page_action
+      ? "pageAction"
+      : "browserAction";
+    return this.nativeAction = this.extension.apiManager.getAPI(
+      name,
+      this.extension,
+    )?.action;
+  }
+  validate(rule, existing) {
+    ownKeys(rule, ["id", "priority", "conditions", "actions"]);
+    const id = rule.id ?? Services.uuid.generateUUID().toString().slice(1, -1);
+    if (typeof id !== "string" || !id.length || existing.has(id)) {
+      throw new ExtensionError("Duplicate or invalid declarative rule id.");
+    }
+    const priority = rule.priority ?? 100;
+    if (
+      !Number.isInteger(priority) || priority < 1 ||
+      !Array.isArray(rule.conditions) || !rule.conditions.length ||
+      !Array.isArray(rule.actions) || !rule.actions.length
+    ) {
+      throw new ExtensionError("Invalid declarative rule.");
+    }
+    const conditions = rule.conditions.map((condition) => {
+      ownKeys(condition, ["instanceType", "pageUrl", "css", "isBookmarked"]);
+      if (condition.instanceType !== "declarativeContent.PageStateMatcher") {
+        throw new ExtensionError("Expected PageStateMatcher.");
+      }
+      const css = condition.css ?? [];
+      if (!Array.isArray(css) || css.some((s) => typeof s !== "string")) {
+        throw new ExtensionError("css must be an array of selectors.");
+      }
