+        typeof condition.isBookmarked !== "boolean"
+      ) {
+        throw new ExtensionError("isBookmarked must be a boolean.");
+      }
+      return {
+        css,
+        isBookmarked: condition.isBookmarked,
+        url: condition.pageUrl === undefined
+          ? () => true
+          : compileURL(condition.pageUrl, this.extension),
+      };
+    });
+    const actions = rule.actions.map((action) => {
+      if (
+        action.instanceType === "declarativeContent.ShowAction" ||
+        action.instanceType === "declarativeContent.ShowPageAction"
+      ) {
+        ownKeys(action, ["instanceType"]);
+        return { type: "show" };
+      }
+      if (action.instanceType === "declarativeContent.SetIcon") {
+        ownKeys(action, ["instanceType", "imageData"]);
+        const icons = action.imageData;
+        if (
+          !icons || !Object.keys(icons).length ||
+          Object.entries(icons).some(([size, data]) =>
+            !/^[1-9][0-9]*$/.test(size) || typeof data !== "string" ||
+            !data.startsWith("data:image/png;base64,")
+          )
+        ) {
+          throw new ExtensionError(
+            "SetIcon requires canonical native ImageData.",
+          );
+        }
+        return { type: "icon", icon: icons };
+      }
+      if (action.instanceType === "declarativeContent.RequestContentScript") {
+        ownKeys(action, [
+          "instanceType",
+          "js",
+          "css",
+          "allFrames",
+          "matchAboutBlank",
+        ]);
+        for (const key of ["js", "css"]) {
+          if (
+            action[key] &&
+            (!Array.isArray(action[key]) ||
+              action[key].some((path) =>
+                typeof path !== "string" ||
+                !this.extension.isExtensionURL(
+                  this.extension.baseURI.resolve(path),
+                )
+              ))
+          ) {
+            throw new ExtensionError(
+              "Content script files must belong to this extension.",
+            );
+          }
+        }
+        for (const key of ["allFrames", "matchAboutBlank"]) {
+          if (action[key] !== undefined && typeof action[key] !== "boolean") {
+            throw new ExtensionError(`${key} must be a boolean.`);
+          }
+        }
+        if (!(action.js?.length || action.css?.length)) {
+          throw new ExtensionError(
+            "RequestContentScript requires js or css files.",
+          );
+        }
+        return { type: "script", options: action };
+      }
+      throw new ExtensionError("Unsupported declarative action.");
+    });
+    return {
+      rule: { ...structuredClone(rule), id, priority },
+      conditions,
+      actions,
+    };
+  }
+  mutate(callback) {
+    const task = this.serial.catch(() => {}).then(async () => {
+      this.check();
+      const next = callback(new Map(this.rules));
+      await IOUtils.makeDirectory(PathUtils.parent(this.path), {
+        createAncestors: true,
+        permissions: 0o700,
+      });
+      await IOUtils.writeJSON(this.path, {
+        schemaVersion: 1,
+        rules: [...next.values()].map((v) => v.rule),
+      }, { tmpPath: this.path + ".tmp" });
+      this.check();
+      this.rules = next;
+      this.epoch++;
+      this.updateAll();
+      return next;
+    });
+    this.serial = task;
+    pendingWrites.set(this.extension.id, task);
+    task.catch(() => {}).finally(() => {
+      if (pendingWrites.get(this.extension.id) === task) {
+        pendingWrites.delete(this.extension.id);
+      }
+    });
+    return task;
+  }
+  async addRules(rules) {
+    let added;
+    await this.mutate((next) => {
+      if (next.size + rules.length > MAX_RULES) {
+        throw new ExtensionError("Too many declarative rules.");
+      }
+      const ids = new Set(next.keys());
+      added = rules.map((rule) => {
+        const value = this.validate(rule, ids);
+        ids.add(value.rule.id);
+        return value;
+      });
+      for (const value of added) {
+        next.set(value.rule.id, value);
+      }
+      return next;
+    });
+    return added.map((v) => structuredClone(v.rule));
+  }
+  async getRules(ids) {
+    await this.serial;
+    this.check();
+    return [...this.rules.values()].filter((v) =>
+      !ids || ids.includes(v.rule.id)
+    ).map((v) => structuredClone(v.rule));
+  }
+  async removeRules(ids) {
+    await this.mutate((next) => {
+      for (const id of ids ?? next.keys()) {
+        next.delete(id);
+      }
+      return next;
+    });
+  }
+  updateAll() {
+    for (const tab of allTabs()) {
+      this.changed(tab.linkedBrowser.browsingContext);
+    }
+  }
+  changed(bc) {
+    if (this.closed || !bc) {
+      return;
+    }
+    const tab = allTabs().find((t) => t.linkedBrowser.browsingContext === bc);
+    if (!tab) {
+      return;
+    }
+    let state = this.tabs.get(tab);
+    if (!state) {
+      state = { revision: 0, executed: new Set() };
+      this.tabs.set(tab, state);
+      tab.addEventListener("TabClose", () => this.tabs.delete(tab), {
+        once: true,
+      });
+    }
+    state.revision++;
+    if (state.running) {
+      return;
+    }
+    state.running = true;
+    (async () => {
+      try {
+        let revision;
+        do {
+          revision = state.revision;
+          await this.evaluate(tab, state, revision);
+        } while (!this.closed && revision !== state.revision);
+      } catch (error) {
+        if (!this.closed) {
+          console.error("[ChromeDeclarativeContent] Evaluation failed", error);
+        }
+      } finally {
+        state.running = false;
+      }
+    })();
+  }
+  clearTab(tab) {
+    const action = this.action();
+    action?.setProperty(tab, "floorpDeclarativeContentEnabled", null);
+    action?.setProperty(tab, "floorpDeclarativeContentIcon", null);
+  }
+  async evaluate(tab, state, revision) {
+    await this.ready;
+    if (this.closed) return;
+    const { extension } = this;
+    const win = tab.documentGlobal;
+    const browser = tab.linkedBrowser;
+    const wg = browser.browsingContext.currentWindowGlobal;
+    const uri = wg?.documentURI || browser.currentURI;
+    if (
+      !wg || !extension.hasPermission("declarativeContent") ||
+      !extension.canAccessWindow(win) ||
+      !["http", "https", "file"].includes(uri.scheme) ||
+      (uri.scheme === "file" && !extension.policy.fileSchemeAllowed) ||
+      WebExtensionPolicy.isRestrictedURI(uri) ||
+      WebExtensionPolicy.isQuarantinedURI(uri) ||
+      extension.policy.checkGuarded(uri)
