new file mode 100644
index 0000000000000000000000000000000000000000..be680a95893eef4703f4e5c1e5ed7559ce013191
--- /dev/null
+++ b/chrome/toolkit/content/extensions/parent/ext-debugger.js
@@ -0,0 +1,166 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+ChromeUtils.defineESModuleGetters(this, {
+  ChromeDebuggerSession: "resource://gre/modules/ChromeDebugger.sys.mjs",
+  isChromeDebuggerAttached: "resource://gre/modules/ChromeDebugger.sys.mjs",
+});
+this.debugger = class extends ExtensionAPIPersistent {
+  sessions = new Map();
+  events = new Set();
+  detaches = new Set();
+  PERSISTENT_EVENTS = {
+    onEvent({ fire }) {
+      const listener = (...args) => fire.async(...args);
+      this.events.add(listener);
+      return {
+        unregister: () => this.events.delete(listener),
+        convert: (value) => {
+          fire = value;
+        },
+      };
+    },
+    onDetach({ fire }) {
+      const listener = (...args) => fire.async(...args);
+      this.detaches.add(listener);
+      return {
+        unregister: () => this.detaches.delete(listener),
+        convert: (value) => {
+          fire = value;
+        },
+      };
+    },
+  };
+  onShutdown() {
+    for (const session of this.sessions.values()) session.close(null);
+    this.sessions.clear();
+    this.events.clear();
+    this.detaches.clear();
+  }
+  resolve(source) {
+    if (
+      source.extensionId ||
+      (source.tabId != null) === (source.targetId != null)
+    ) {
+      throw new ExtensionUtils.ExtensionError(
+        "Exactly one supported tabId or targetId is required",
+      );
+    }
+    const id = source.tabId ?? /^floorp-tab:(\d+)$/.exec(source.targetId)?.[1];
+    if (id === undefined) {
+      throw new ExtensionUtils.ExtensionError("Unknown debugger targetId");
+    }
+    const tab = tabTracker.getTab(Number(id));
+    if (
+      !this.extension.canAccessWindow(tab.documentGlobal) ||
+      tab.closing ||
+      tab.getAttribute("pending") === "true"
+    ) {
+      throw new ExtensionUtils.ExtensionError("Debugger target is unavailable");
+    }
+    return { tab, tabId: Number(id) };
+  }
+  getAPI(context) {
+    const extension = this.extension;
+    if (!ExtensionUtils.getChromeExtensionId(extension)) return {};
+    return {
+      debugger: {
+        attach: async (source, version) => {
+          if (!/^1\.[0-3]$/.test(version)) {
+            throw new ExtensionUtils.ExtensionError(
+              `Unsupported debugger protocol version: ${version}`,
+            );
+          }
+          if (source.sessionId) {
+            throw new ExtensionUtils.ExtensionError(
+              "Cannot attach an existing child session",
+            );
+          }
+          const { tab, tabId } = this.resolve(source);
+          if (this.sessions.has(tabId)) {
+            throw new ExtensionUtils.ExtensionError(
+              "Debugger is already attached",
+            );
+          }
+          const session = new ChromeDebuggerSession(
+            extension,
+            tab,
+            tabId,
+            (...args) => {
+              for (const listener of this.events) listener(...args);
+            },
+            (reason) => {
+              if (this.sessions.get(tabId) === session) {
+                this.sessions.delete(tabId);
+              }
+              if (reason) {
+                for (const listener of this.detaches) {
+                  listener({ tabId }, reason);
+                }
+              }
+            },
+          );
+          this.sessions.set(tabId, session);
+          try {
+            await session.open();
+          } catch (error) {
+            this.sessions.delete(tabId);
+            throw error;
+          }
+        },
+        detach: async (source) => {
+          if (source.sessionId) {
+            throw new ExtensionUtils.ExtensionError(
+              "Detach a child with Target.detachFromTarget",
+            );
+          }
+          const { tabId } = this.resolve(source);
+          const session = this.sessions.get(tabId);
+          if (!session) {
+            throw new ExtensionUtils.ExtensionError("Debugger is not attached");
+          }
+          await session.close(null);
+        },
+        getTargets: async () => {
+          const targets = [];
+          for (const window of windowTracker.browserWindows()) {
+            if (!extension.canAccessWindow(window)) continue;
+            for (const tab of window.gBrowser.tabs) {
+              const tabId = tabTracker.getId(tab);
+              targets.push({
+                id: `floorp-tab:${tabId}`,
+                tabId,
+                type: "page",
+                title: tab.label,
+                url: tab.linkedBrowser.currentURI.spec,
+                attached: isChromeDebuggerAttached(tab),
+              });
+            }
+          }
+          return targets;
+        },
+        sendCommand: async (source, method, params) => {
+          const { tabId } = this.resolve(source);
+          const session = this.sessions.get(tabId);
+          if (!session) {
+            throw new ExtensionUtils.ExtensionError("Debugger is not attached");
+          }
+          return session.command(source, method, params || {});
+        },
+        onEvent: new EventManager({
+          context,
+          module: "debugger",
+          event: "onEvent",
+          extensionApi: this,
+        }).api(),
+        onDetach: new EventManager({
+          context,
+          module: "debugger",
+          event: "onDetach",
+          extensionApi: this,
+        }).api(),
+      },
+    };
+  }
+};
