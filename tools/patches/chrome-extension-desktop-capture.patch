diff --git a/modules/ChromeExtensionCapturePicker.sys.mjs b/modules/ChromeExtensionCapturePicker.sys.mjs
new file mode 100644
index 0000000..f1a7235
--- /dev/null
+++ b/modules/ChromeExtensionCapturePicker.sys.mjs
@@ -0,0 +1,32 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+const requests = new Map();
+
+// This nonce is created by the privileged API after its own source choice.
+// It is delivered only to the owned capture actor, never to an extension page.
+export const ChromeExtensionCapturePicker = {
+  reserve(extension, sourceGlobal, browser, kind) {
+    if (!sourceGlobal?.isCurrentGlobal ||
+        !sourceGlobal.documentPrincipal.equals(extension.principal) ||
+        !extension.hasPermission("desktopCapture") ||
+        !browser?.isConnected || !["screen", "window"].includes(kind))
+      throw new Error("Invalid desktop picker owner.");
+    const token = String(Services.uuid.generateUUID());
+    requests.set(token, {extension, sourceGlobal, browser, kind});
+    return token;
+  },
+  claim(token, actor) {
+    const request = requests.get(token);
+    requests.delete(token);
+    if (!request || actor.manager !== request.sourceGlobal ||
+        !actor.manager.isCurrentGlobal ||
+        !actor.manager.documentPrincipal.equals(request.extension.principal) ||
+        !request.extension.hasPermission("desktopCapture") ||
+        !request.browser.isConnected ||
+        request.browser.documentGlobal.closed)
+      throw new Error("Invalid or expired desktop picker token.");
+    return request;
+  },
+  drop(token) { requests.delete(token); },
+};
