@@ -0,0 +1,43 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+
+this.desktopCapture = class extends ExtensionAPI {
+  getAPI(context) {
+    const marker = context.extension.manifest.browser_specific_settings?.gecko
+      ?.floorp_chrome_extension;
+    if (marker?.schema_version !== 1 ||
+        context.extension.id !== `${marker.original_id}@chromium-extension` ||
+        !/^[a-p]{32}$/.test(marker.original_id)) return {};
+    let nextRequestId = 0;
+    const pending = new Map();
+    context.callOnClose({close() { pending.clear(); }});
+    return {desktopCapture: {
+      chooseDesktopMedia(sources, targetTab, callback) {
+        const id = ++nextRequestId;
+        pending.set(id, callback);
+        context.childManager.callParentAsyncFunction(
+          "desktopCapture._choose", [id, sources, targetTab]
+        ).then(result => {
+          if (!pending.delete(id) || context.unloaded) return;
+          context.runSafe(callback, result.streamId, {
+            canRequestAudioTrack: result.canRequestAudioTrack,
+          });
+        }, error => {
+          if (!pending.delete(id) || context.unloaded) return;
+          context.withLastError(error, () =>
+            context.runSafe(callback)
+          );
+        });
+        return id;
+      },
+      cancelChooseDesktopMedia(id) {
+        if (!pending.delete(id)) return;
+        context.childManager.callParentAsyncFunction(
+          "desktopCapture._cancel", [id]
+        ).catch(Cu.reportError);
+      },
+    }};
+  }
+};
