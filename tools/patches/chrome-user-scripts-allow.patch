+
+import { AddonManager } from "resource://gre/modules/AddonManager.sys.mjs";
+import { ExtensionPermissions } from "resource://gre/modules/ExtensionPermissions.sys.mjs";
+import { ExtensionTaskScheduler } from "resource://gre/modules/ExtensionTaskScheduler.sys.mjs";
+import { ExtensionUtils } from "resource://gre/modules/ExtensionUtils.sys.mjs";
+import { NetUtil } from "resource://gre/modules/NetUtil.sys.mjs";
+
+export const CHROME_USER_SCRIPTS_ALLOWED_PERMISSION =
+  "internal:floorpChromeUserScriptsAllowed";
+
+const queues = new ExtensionTaskScheduler();
+const generations = new Map();
+function generation(id) {
+  if (!generations.has(id)) generations.set(id, {});
+  return generations.get(id);
+}
+function replaced(addon) {
+  if (generations.has(addon.id)) generations.set(addon.id, {});
+}
+AddonManager.addAddonListener({
+  onInstalling: replaced,
+  onInstalled: replaced,
+  onUninstalling: replaced,
+  onUninstalled: replaced,
+});
+
+function isEligible(extension) {
+  const { manifest } = extension;
+  return !!ExtensionUtils.getChromeExtensionId(extension) &&
+    manifest.manifest_version === 3 &&
+    !!(manifest.permissions?.includes("userScripts") ||
+      manifest.optional_permissions?.includes("userScripts"));
+}
+
+function activeExtension(id) {
+  return WebExtensionPolicy.getByID(id)?.extension ?? null;
+}
+
+function assertCurrent(snapshot) {
+  if (generation(snapshot.id) !== snapshot.generation ||
+      snapshot.addon.version !== snapshot.version ||
+      activeExtension(snapshot.id) !== snapshot.extension) {
+    throw new Error("The extension changed while its user script setting was being read or changed.");
+  }
+}
+
+function readManifest(uri) {
+  return new Promise((resolve, reject) => {
+    NetUtil.asyncFetch({
+      uri,
+      loadingPrincipal: Services.scriptSecurityManager.getSystemPrincipal(),
+      securityFlags: Ci.nsILoadInfo.SEC_ALLOW_CROSS_ORIGIN_SEC_CONTEXT_IS_NULL,
+      contentPolicyType: Ci.nsIContentPolicy.TYPE_OTHER,
+    }, (stream, result) => {
+      try {
+        if (!Components.isSuccessCode(result)) {
+          throw new Error("The installed extension manifest could not be read.");
+        }
+        const length = stream.available();
+        if (length > 1024 * 1024) throw new Error("The installed extension manifest is too large.");
+        resolve(JSON.parse(NetUtil.readInputStreamToString(stream, length, {
+          charset: "UTF-8",
+        })));
+      } catch (error) {
+        reject(error);
+      }
+    });
+  });
+}
+
+async function snapshotFor(id) {
+  if (typeof id !== "string" || !/^[a-p]{32}@chromium-extension$/.test(id)) return null;
+  const captured = generation(id);
+  const addon = await AddonManager.getAddonByID(id);
+  if (generation(id) !== captured) throw new Error("The extension changed while its user script setting was being read.");
+  if (!addon || addon.type !== "extension") return null;
+  const snapshot = {
+    id,
+    generation: captured,
+    addon,
+    version: addon.version,
+    extension: activeExtension(id),
+  };
+  snapshot.manifest = snapshot.extension?.manifest ??
+    await readManifest(addon.getResourceURI("manifest.json"));
+  assertCurrent(snapshot);
+  return snapshot;
+}
+
+async function statusFor(snapshot) {
+  if (!snapshot || !isEligible(snapshot)) {
+    return { eligible: false, allowed: false, permissionGranted: false };
+  }
+  const stored = await ExtensionPermissions.get(snapshot.id);
+  assertCurrent(snapshot);
+  const permissionGranted = snapshot.extension
+    ? snapshot.extension.hasPermission("userScripts")
+    : snapshot.manifest.permissions?.includes("userScripts") ||
+      stored.permissions.includes("userScripts");
+  return {
+    eligible: true,
+    allowed: stored.permissions.includes(CHROME_USER_SCRIPTS_ALLOWED_PERMISSION),
+    permissionGranted: !!permissionGranted,
+  };
+}
+
+export const ChromeExtensionUserScriptsConsent = {
+  isEligible,
+
+  // Required declarations remain public permissions. This independent native
+  // setting authorizes execution only after the user changes the browser UI.
+  isAllowed(extension) {
+    return isEligible(extension) && extension.hasPermission("userScripts") &&
+      extension.hasPermission(CHROME_USER_SCRIPTS_ALLOWED_PERMISSION);
+  },
+
+  async getStatus(id) {
+    return statusFor(await snapshotFor(id));
+  },
+
+  async setAllowed(id, allowed) {
+    if (typeof allowed !== "boolean") throw new TypeError("The user script setting must be a boolean.");
+    const captured = generation(id);
+    return queues.runWriteTask(id, async () => {
+      if (generation(id) !== captured) throw new Error("The extension changed before its user script setting could be changed.");
+      const snapshot = await snapshotFor(id);
+      if (!snapshot || !isEligible(snapshot)) throw new Error("This extension has no Chrome user script setting.");
+      assertCurrent(snapshot);
+      // Enqueue into the native permission store synchronously after checking
+      // the package generation. A subsequent uninstall's removeAll is ordered
+      // after this operation. Never roll back a later install's permissions.
+      await ExtensionPermissions[allowed ? "add" : "remove"](id, {
+        permissions: [CHROME_USER_SCRIPTS_ALLOWED_PERMISSION],
+        origins: [],
+        data_collection: [],
+      }, snapshot.extension ?? undefined);
+      assertCurrent(snapshot);
+      // Disabling suspends execution through live policy checks. Registrations
+      // and world configuration persist so re-enabling restores them.
+      return statusFor(snapshot);
+    });
+  },
+};
