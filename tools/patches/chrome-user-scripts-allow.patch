@@ -0,0 +1,131 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { AboutAddonsHTMLElement } from "../aboutaddons-utils.mjs";
+
+const { ChromeExtensionUserScriptsConsent } = ChromeUtils.importESModule(
+  "resource://gre/modules/ChromeExtensionUserScriptsConsent.sys.mjs"
+);
+const { AddonManager } = ChromeUtils.importESModule(
+  "resource://gre/modules/AddonManager.sys.mjs"
+);
+const { ExtensionPermissions } = ChromeUtils.importESModule(
+  "resource://gre/modules/ExtensionPermissions.sys.mjs"
+);
+const { PERMISSION_L10N } = ChromeUtils.importESModule(
+  "resource://gre/modules/ExtensionPermissionMessages.sys.mjs"
+);
+
+class FloorpChromeUserScriptsToggle extends AboutAddonsHTMLElement {
+  static get markup() {
+    return `<template>
+      <moz-toggle data-chrome-user-scripts-allow>
+        <moz-message-bar type="warning" slot="nested"></moz-message-bar>
+      </moz-toggle>
+      <p role="status" data-chrome-user-scripts-error></p>
+    </template>`;
+  }
+
+  constructor() {
+    super();
+    this.generation = 0;
+    this.permissionsChanged = (_event, change) => {
+      if (change.extensionId === this.addon?.id) this.refresh();
+    };
+    const addonChanged = addon => {
+      if (addon.id === this.addon?.id) this.refresh();
+    };
+    this.addonListener = {
+      onInstalled: addonChanged,
+      onEnabled: addonChanged,
+      onDisabled: addonChanged,
+      onUninstalled: addonChanged,
+    };
+  }
+
+  connectedCallback() {
+    if (!this.listening) {
+      ExtensionPermissions.addListener(this.permissionsChanged);
+      AddonManager.addAddonListener(this.addonListener);
+      this.listening = true;
+    }
+    this.refresh();
+  }
+
+  disconnectedCallback() {
+    ++this.generation;
+    if (this.listening) {
+      ExtensionPermissions.removeListener(this.permissionsChanged);
+      AddonManager.removeAddonListener(this.addonListener);
+      this.listening = false;
+    }
+  }
+
+  setAddon(addon) {
+    this.addon = addon;
+    this.refresh();
+  }
+
+  string(name) {
+    const suffix = Services.locale.appLocaleAsBCP47.startsWith("ja") ? "-ja" : "";
+    return PERMISSION_L10N.formatValueSync(`floorp-user-scripts-${name}${suffix}`);
+  }
+
+  async refresh() {
+    const generation = ++this.generation;
+    const addon = this.addon;
+    if (!addon || !this.isConnected) return;
+    try {
+      const status = await ChromeExtensionUserScriptsConsent.getStatus(addon.id);
+      if (generation !== this.generation || addon !== this.addon || !this.isConnected) return;
+      this.hidden = !status.eligible;
+      if (!status.eligible) {
+        this.textContent = "";
+        return;
+      }
+      if (!this.firstElementChild) {
+        this.appendChild(FloorpChromeUserScriptsToggle.fragment);
+        const toggle = this.querySelector("moz-toggle");
+        toggle.addEventListener("toggle", event => this.toggle(event));
+        this.querySelector("moz-message-bar").messageL10nId =
+          "webext-perms-extra-warning-userScripts-long";
+      }
+      const toggle = this.querySelector("moz-toggle");
+      toggle.setAttribute("label", this.string("allow"));
+      toggle.pressed = status.allowed;
+      toggle.disabled = this.changing === true;
+    } catch (error) {
+      if (generation !== this.generation || addon !== this.addon || !this.isConnected) return;
+      const toggle = this.querySelector("moz-toggle");
+      this.hidden = !toggle;
+      if (toggle) {
+        toggle.disabled = true;
+        this.querySelector("[data-chrome-user-scripts-error]").textContent = this.string("error");
+      }
+      console.error("[ChromeUserScriptsConsent]", error);
+    }
+  }
+
+  async toggle(event) {
+    const toggle = this.querySelector("moz-toggle");
+    if (event.target !== toggle || this.changing || !this.addon) return;
+    event.stopPropagation();
+    const addon = this.addon;
+    const error = this.querySelector("[data-chrome-user-scripts-error]");
+    error.textContent = "";
+    this.changing = true;
+    toggle.disabled = true;
+    try {
+      await ChromeExtensionUserScriptsConsent.setAllowed(addon.id, toggle.pressed);
+    } catch (failure) {
+      if (addon === this.addon && this.isConnected) error.textContent = this.string("error");
+      console.error("[ChromeUserScriptsConsent]", failure);
+    } finally {
+      this.changing = false;
+      if (addon === this.addon && this.isConnected) await this.refresh();
+    }
+  }
+}
+
+customElements.define("floorp-chrome-user-scripts-toggle", FloorpChromeUserScriptsToggle);
