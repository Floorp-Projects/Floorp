+[
+  {
+    "namespace": "manifest",
+    "types": [
+      {
+        "$extend": "OptionalPermissionNoPrompt",
+        "choices": [
+          {
+            "type": "string",
+            "enum": [
+              "power"
+            ]
+          }
+        ]
+      }
+    ]
+  },
+  {
+    "namespace": "power",
+    "description": "Native extension-owned system and display wake locks.",
+    "permissions": [
+      "power"
+    ],
+    "types": [
+      {
+        "id": "Level",
+        "type": "string",
+        "enum": [
+          "system",
+          "display"
+        ]
+      }
+    ],
+    "functions": [
+      {
+        "name": "requestKeepAwake",
+        "type": "function",
+        "parameters": [
+          {
+            "name": "level",
+            "$ref": "Level"
+          }
+        ]
+      },
+      {
+        "name": "releaseKeepAwake",
+        "type": "function",
+        "parameters": []
+      }
+    ]
+  }
+]
