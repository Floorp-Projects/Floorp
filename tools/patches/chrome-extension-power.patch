diff --git a/chrome/toolkit/content/extensions/parent/ext-power.js b/chrome/toolkit/content/extensions/parent/ext-power.js
new file mode 100644
--- /dev/null
+++ b/chrome/toolkit/content/extensions/parent/ext-power.js
@@ -0,0 +1,98 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+
+function compatiblePower(extension) {
+  const marker =
+    extension.manifest.browser_specific_settings?.gecko
+      ?.floorp_chrome_extension;
+  return (
+    marker?.schema_version === 1 &&
+    /^[a-p]{32}$/.test(marker.original_id) &&
+    extension.id === `${marker.original_id}@chromium-extension`
+  );
+}
+
+this.power = class extends ExtensionAPI {
+  constructor(extension) {
+    super(extension);
+    this.wakeLocks = [];
+    this.level = null;
+    this.closed = false;
+    this.permissionsRemoved = (event, permissions) => {
+      if (
+        permissions?.permissions?.includes("power") ||
+        !extension.hasPermission("power")
+      )
+        this.release();
+    };
+    extension.on("remove-permissions", this.permissionsRemoved);
+  }
+  release() {
+    const previous = this.wakeLocks;
+    this.wakeLocks = [];
+    this.level = null;
+    for (const lock of previous) {
+      try {
+        lock.unlock();
+      } catch (error) {
+        Cu.reportError(error);
+      }
+    }
+  }
+  onShutdown() {
+    this.closed = true;
+    this.extension.off("remove-permissions", this.permissionsRemoved);
+    this.release();
+  }
+  getAPI(context) {
+    const { extension } = this;
+    const authorized = () => {
+      if (
+        this.closed ||
+        !compatiblePower(extension) ||
+        !extension.hasPermission("power")
+      )
+        throw new ExtensionUtils.ExtensionError(
+          "Chrome power requires its current extension permission."
+        );
+    };
+    return {
+      power: {
+        requestKeepAwake: level => {
+          authorized();
+          if (level !== "system" && level !== "display")
+            throw new ExtensionUtils.ExtensionError("Unknown power level.");
+          if (this.level === level) return;
+          const service = Cc[
+            "@mozilla.org/power/powermanagerservice;1"
+          ].getService(Ci.nsIPowerManagerService);
+          if (typeof service.newWakeLockForChromeExtension !== "function")
+            throw new ExtensionUtils.ExtensionError(
+              "Chrome power requires the compiled Floorp wake-lock backend."
+            );
+          const acquired = [];
+          try {
+            acquired.push(service.newWakeLockForChromeExtension("cpu"));
+            if (level === "display")
+              acquired.push(service.newWakeLockForChromeExtension("screen"));
+            authorized();
+          } catch (error) {
+            for (const lock of acquired) lock.unlock();
+            throw error;
+          }
+          // Acquire the replacement before releasing the former level, avoiding
+          // a transient suspend window while another view changes this extension.
+          this.release();
+          this.wakeLocks = acquired;
+          this.level = level;
+        },
+        releaseKeepAwake: () => {
+          authorized();
+          this.release();
+        },
+      },
+    };
+  }
+};
