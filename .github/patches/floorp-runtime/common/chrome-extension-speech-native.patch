+static nsCString SpeechTextWithMarks(const nsAString& aText) {
+  nsAutoString markup(u"<speak>");
+  bool sentence = true;
+  uint32_t i = 0;
+  while (i < aText.Length()) {
+    const char16_t ch = aText[i];
+    if (ch > ' ' && (i == 0 || aText[i - 1] <= ' ')) {
+      uint32_t end = i + 1;
+      while (end < aText.Length() && aText[end] > ' ') {
+        ++end;
+      }
+      markup.AppendLiteral("<mark name=\"floorp:");
+      markup.AppendInt(i);
+      markup.Append(':');
+      markup.AppendInt(end - i);
+      markup.Append(':');
+      markup.AppendInt(sentence ? 1 : 0);
+      markup.AppendLiteral("\"/>");
+      sentence = false;
+    }
+    switch (ch) {
+      case '&':
+        markup.AppendLiteral("&amp;");
+        break;
+      case '<':
+        markup.AppendLiteral("&lt;");
+        break;
+      case '>':
+        markup.AppendLiteral("&gt;");
+        break;
+      default:
+        if (ch >= 0x20 || ch == '\t' || ch == '\n' || ch == '\r') {
+          markup.Append(ch);
+        }
+        break;
+    }
+    if (ch == '.' || ch == '!' || ch == '?' || ch == 0x3002 || ch == 0xff01 ||
+        ch == 0xff1f) {
+      sentence = true;
+    }
+    ++i;
+  }
+  markup.AppendLiteral("</speak>");
+  return NS_ConvertUTF16toUTF8(markup);
+}
