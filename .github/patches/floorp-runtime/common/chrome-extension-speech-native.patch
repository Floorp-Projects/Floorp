+      markup.Append(':');
+      markup.AppendInt(end - i);
+      markup.Append(':');
+      markup.AppendInt(aSentence ? 1 : 0);
+      markup.AppendLiteral("\"/>");
+      aSentence = false;
+    }
+    switch (ch) {
+      case '&':
+        markup.AppendLiteral("&amp;");
+        break;
+      case '<':
+        markup.AppendLiteral("&lt;");
+        break;
+      case '>':
