+nsresult SpeechDispatcherService::SpeakNextChunk(
+    SpeechDispatcherCallback* aCallback) {
+  MOZ_ASSERT(NS_IsMainThread());
+  MOZ_ASSERT(!aCallback->mMessageActive);
+  if (aCallback->mFinalized || aCallback->mCancelled ||
+      aCallback->mChunkEnd >= aCallback->mTextLength)
+    return NS_ERROR_UNEXPECTED;
+  const uint32_t start = aCallback->mChunkEnd;
+  uint32_t end = aCallback->mTextLength;
+  if (aCallback->mChromeTts) {
+    const uint32_t limit = std::min(start + 256, aCallback->mTextLength);
+    end = limit;
+    uint32_t whitespace = start;
+    for (uint32_t i = start; i < limit; ++i) {
+      const char16_t ch = aCallback->mText[i];
+      if (ch <= ' ') whitespace = i + 1;
+      if (SentenceBoundaryAt(aCallback->mText, i)) {
+        end = i + 1;
+        break;
+      }
+    }
+    if (end == limit && limit < aCallback->mTextLength && whitespace > start)
+      end = whitespace;
+    // A pathological token still has bounded native input. Preserve UTF-16
+    // scalar boundaries, and the markup helper does not invent a new word.
+    if (end < aCallback->mTextLength && end > start &&
+        aCallback->mText[end - 1] >= 0xd800 &&
+        aCallback->mText[end - 1] <= 0xdbff &&
+        aCallback->mText[end] >= 0xdc00 && aCallback->mText[end] <= 0xdfff)
+      --end;
+  }
+  const nsCString markup =
+      aCallback->mChromeTts
+          ? ChromeSpeechTextWithMarks(aCallback->mText, start, end,
+                                      aCallback->mNextStartsSentence)
+          : SpeechTextWithMarks(aCallback->mText);
+  const int messageId = spd_say(mSpeechdClient, SPD_MESSAGE, markup.get());
+  if (messageId < 0) return NS_ERROR_FAILURE;
+  aCallback->mChunkStart = start;
+  aCallback->mChunkEnd = end;
+  aCallback->mMessageActive = true;
+  mCallbacks.InsertOrUpdate(messageId,
+                            RefPtr<SpeechDispatcherCallback>(aCallback));
+  return NS_OK;
+}
