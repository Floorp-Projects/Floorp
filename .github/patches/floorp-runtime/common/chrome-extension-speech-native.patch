+void SpeechDispatcherCallback::OnMark(const nsCString& aMark) {
+  uint32_t index, length, sentence;
+  if (sscanf(aMark.get(), "floorp:%u:%u:%u", &index, &length, &sentence) != 3 ||
+      index > mTextLength || length > mTextLength - index) {
+    return;
+  }
+  mCharIndex = index;
+  float elapsed = (TimeStamp::Now() - mStartTime).ToSeconds();
+  if (sentence) {
+    mTask->DispatchBoundary(u"sentence"_ns, elapsed, index, length, 1);
+  }
+  mTask->DispatchBoundary(u"word"_ns, elapsed, index, length, 1);
+}
+
+static void speechd_mark_cb(size_t aMsgId, size_t aClientId,
+                            SPDNotificationType aState, char* aMark) {
+  auto* service = SpeechDispatcherService::GetInstance(false);
+  if (service && aMark) {
+    NS_DispatchToMainThread(NewRunnableMethod<uint32_t, const nsCString>(
+        "dom::SpeechDispatcherService::MarkNotify", service,
+        &SpeechDispatcherService::MarkNotify, static_cast<uint32_t>(aMsgId),
+        nsCString(aMark)));
+  }
+}
