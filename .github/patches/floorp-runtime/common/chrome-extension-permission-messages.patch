diff --git a/toolkit/components/extensions/ExtensionPermissionMessages.sys.mjs b/toolkit/components/extensions/ExtensionPermissionMessages.sys.mjs
index b85f41a..4bf086a 100644
--- a/toolkit/components/extensions/ExtensionPermissionMessages.sys.mjs
+++ b/toolkit/components/extensions/ExtensionPermissionMessages.sys.mjs
@@ -15,7 +15,7 @@ export const PERMISSION_L10N = new Localization(
     "toolkit/global/extensionPermissions.ftl",
     "branding/brand.ftl",
   ],
-  true
+  true,
 );
 
 /**
@@ -121,3 +121,53 @@ export function permissionToL10nId(permission, short = false) {
 
   return `webext-perms-description-${sanitized}`;
 }
+
+// These UI hints come from the normalized manifest; they do not establish XPI
+// provenance or grant an API. Keep the same exact opt-in identity as the runtime.
+export function floorpChromePermissionInfo(manifest, addonId) {
+  const gecko = manifest?.browser_specific_settings?.gecko ||
+    manifest?.applications?.gecko;
+  const marker = gecko?.floorp_chrome_extension;
+  const id = marker?.original_id;
+  return marker?.schema_version === 1 && typeof id === "string" &&
+      /^[a-p]{32}$/.test(id) && addonId === `${id}@chromium-extension`
+    ? { floorpChromeOriginalId: id }
+    : {};
+}
+
+export function floorpChromePermissionMessages(
+  addon,
+  permissions,
+  optionalPermissions,
+) {
+  const id = permissions?.floorpChromeOriginalId ||
+    optionalPermissions?.floorpChromeOriginalId ||
+    addon?.userPermissions?.floorpChromeOriginalId;
+  const result = { messages: [], optionalPermissions: {} };
+  if (
+    typeof id !== "string" || !/^[a-p]{32}$/.test(id) ||
+    addon?.id !== `${id}@chromium-extension`
+  ) {
+    return result;
+  }
+  const capture = permissions?.permissions?.includes("tabCapture");
+  const optionalCapture = optionalPermissions?.permissions?.includes(
+    "tabCapture",
+  );
+  if (!capture && !optionalCapture) {
+    return result;
+  }
+  // Floorp ships both descriptions in the base resource so ja / ja-JP-mac can
+  // use the capture warning even when the upstream language pack lacks this key.
+  const messageId = /^ja(?:-|$)/i.test(Services.locale.appLocaleAsBCP47)
+    ? "floorp-webext-perms-description-tab-capture-ja"
+    : "floorp-webext-perms-description-tab-capture";
+  const message = PERMISSION_L10N.formatValueSync(messageId);
+  if (capture) {
+    result.messages.push(message);
+  }
+  if (optionalCapture) {
+    result.optionalPermissions.tabCapture = message;
+  }
+  return result;
+}
