+gboolean nsWindow::OnWorkspaceSwipeEvent(GdkEventTouchpadSwipe* aEvent) {
+  if (!Preferences::GetBool("floorp.workspaces.gestures.native.enabled",
+                            false) ||
+      !Preferences::GetBool("floorp.workspaces.gestures.native.verified",
+                            false) ||
+      !Preferences::GetBool("floorp.workspaces.enabled", true) || IsPopup()) {
+    mWorkspaceSwipeGesture.Reset();
+    return FALSE;
+  }
+
+  widget::WorkspaceSwipePhase phase;
+  switch (aEvent->phase) {
+    case GDK_TOUCHPAD_GESTURE_PHASE_BEGIN:
+      phase = widget::WorkspaceSwipePhase::Start;
+      break;
+    case GDK_TOUCHPAD_GESTURE_PHASE_UPDATE:
+      phase = widget::WorkspaceSwipePhase::Update;
+      break;
+    case GDK_TOUCHPAD_GESTURE_PHASE_END:
+      phase = widget::WorkspaceSwipePhase::End;
+      break;
+    case GDK_TOUCHPAD_GESTURE_PHASE_CANCEL:
+      phase = widget::WorkspaceSwipePhase::Cancel;
+      break;
+    default:
+      phase = widget::WorkspaceSwipePhase::None;
+      break;
+  }
+  if (!mWorkspaceSwipeGesture.Update(aEvent->n_fingers, phase, aEvent->dx,
+                                     aEvent->dy)) {
+    return FALSE;
+  }
+
+  // Dispatch exclusively to browser chrome. Web content must not observe or
+  // claim this browser action, and this stream must not trigger history APZ.
+  WidgetSimpleGestureEvent event(true, eWorkspaceSwipeGesture, this);
+  event.mFlags.mOnlyChromeDispatch = true;
+  event.mFingerCount = 3;
+  event.mGesturePhase = mWorkspaceSwipeGesture.Phase();
+  event.mOperationId = mWorkspaceSwipeGesture.OperationId();
+  event.mDelta = mWorkspaceSwipeGesture.DeltaX();
+  event.mDeltaY = mWorkspaceSwipeGesture.DeltaY();
+  event.mRefPoint = GetRefPoint(this, aEvent);
+  event.AssignEventTime(GetWidgetEventTime(aEvent->time));
+  KeymapWrapper::InitInputEvent(event, aEvent->state);
+  DispatchWindowEvent(event);
+  return event.DefaultPrevented() ? TRUE : FALSE;
+}
