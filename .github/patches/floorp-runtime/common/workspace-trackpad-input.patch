diff --git a/widget/tests/gtest/TestWorkspaceSwipeGesture.cpp b/widget/tests/gtest/TestWorkspaceSwipeGesture.cpp
new file mode 100644
index 0000000..41ada91
--- /dev/null
+++ b/widget/tests/gtest/TestWorkspaceSwipeGesture.cpp
@@ -0,0 +1,93 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include <limits>
+
+#include "gtest/gtest.h"
+#include "mozilla/TouchEvents.h"
+#include "mozilla/UniquePtr.h"
+#include "mozilla/WorkspaceSwipeGesture.h"
+
+using mozilla::widget::WorkspaceSwipeGestureState;
+using mozilla::widget::WorkspaceSwipePhase;
+
+TEST(WorkspaceSwipeGesture, CumulativeStreamEndsOnce)
+{
+  WorkspaceSwipeGestureState state;
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::Start, 0, 0));
+  const auto operation = state.OperationId();
+  EXPECT_NE(operation, 0U);
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::Update, -20, 2));
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::Update, -40, -1));
+  EXPECT_DOUBLE_EQ(state.DeltaX(), -60);
+  EXPECT_DOUBLE_EQ(state.DeltaY(), 1);
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::End, 0, 0));
+  EXPECT_EQ(state.Phase(), WorkspaceSwipePhase::End);
+  EXPECT_EQ(state.OperationId(), operation);
+  EXPECT_FALSE(state.Update(3, WorkspaceSwipePhase::Update, -50, 0));
+  EXPECT_FALSE(state.Update(3, WorkspaceSwipePhase::End, 0, 0));
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::Start, 0, 0));
+  EXPECT_NE(state.OperationId(), operation);
+  EXPECT_DOUBLE_EQ(state.DeltaX(), 0);
+}
+
+TEST(WorkspaceSwipeGesture, UnknownOrChangedFingerCountNeverCommits)
+{
+  WorkspaceSwipeGestureState state;
+  EXPECT_FALSE(state.Update(0, WorkspaceSwipePhase::Start, 0, 0));
+  EXPECT_FALSE(state.Update(2, WorkspaceSwipePhase::Start, 0, 0));
+  EXPECT_FALSE(state.Update(4, WorkspaceSwipePhase::Start, 0, 0));
+  EXPECT_FALSE(state.Update(3, WorkspaceSwipePhase::End, 100, 0));
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::Start, 0, 0));
+  EXPECT_TRUE(state.Update(4, WorkspaceSwipePhase::Update, 100, 0));
+  EXPECT_EQ(state.Phase(), WorkspaceSwipePhase::Cancel);
+  EXPECT_FALSE(state.Update(3, WorkspaceSwipePhase::End, 0, 0));
+}
+
+TEST(WorkspaceSwipeGesture, InvalidCoordinatesAndResetCancelTheStream)
+{
+  WorkspaceSwipeGestureState state;
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::Start, 0, 0));
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::Update,
+                           std::numeric_limits<double>::infinity(), 0));
+  EXPECT_EQ(state.Phase(), WorkspaceSwipePhase::Cancel);
+  EXPECT_TRUE(std::isfinite(state.DeltaX()));
+  EXPECT_TRUE(state.Update(3, WorkspaceSwipePhase::Start, 0, 0));
+  state.Reset();
+  EXPECT_FALSE(state.Update(3, WorkspaceSwipePhase::End, 100, 0));
+}
+
+TEST(WorkspaceSwipeGesture, MetadataSurvivesEventCopiesAndDuplicate)
+{
+  mozilla::WidgetSimpleGestureEvent original(
+      true, mozilla::eWorkspaceSwipeGesture, nullptr);
+  original.mFlags.mOnlyChromeDispatch = true;
+  original.mFingerCount = 3;
+  original.mGesturePhase = WorkspaceSwipePhase::Update;
+  original.mOperationId = 23;
+  original.mDelta = -120;
+  original.mDeltaY = 4;
+
+  mozilla::WidgetSimpleGestureEvent copy(original);
+  EXPECT_EQ(copy.mFingerCount, 3U);
+  EXPECT_EQ(copy.mGesturePhase, WorkspaceSwipePhase::Update);
+  EXPECT_EQ(copy.mOperationId, 23U);
+  EXPECT_DOUBLE_EQ(copy.mDelta, -120);
+  EXPECT_DOUBLE_EQ(copy.mDeltaY, 4);
+
+  mozilla::UniquePtr<mozilla::WidgetEvent> duplicate(original.Duplicate());
+  const auto* event = duplicate->AsSimpleGestureEvent();
+  ASSERT_NE(event, nullptr);
+  EXPECT_TRUE(event->mFlags.mOnlyChromeDispatch);
+  EXPECT_EQ(event->mFingerCount, 3U);
+  EXPECT_EQ(event->mGesturePhase, WorkspaceSwipePhase::Update);
+  EXPECT_EQ(event->mOperationId, 23U);
+  EXPECT_DOUBLE_EQ(event->mDeltaY, 4);
+
+  mozilla::WidgetSimpleGestureEvent history(true, mozilla::eSwipeGesture,
+                                            nullptr);
+  EXPECT_EQ(history.mFingerCount, 0U);
+  EXPECT_EQ(history.mGesturePhase, WorkspaceSwipePhase::None);
+  EXPECT_EQ(history.mOperationId, 0U);
+}
