new file mode 100644
index 0000000..36d2c76
--- /dev/null
+++ b/widget/WorkspaceSwipeGesture.h
@@ -0,0 +1,88 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_WorkspaceSwipeGesture_h
+#define mozilla_WorkspaceSwipeGesture_h
+
+#include <cmath>
+#include <cstdint>
+
+namespace mozilla::widget {
+
+enum class WorkspaceSwipePhase : uint8_t { None, Start, Update, End, Cancel };
+
+// A raw three-finger stream is separate from APZ's two-finger history stream.
+// No finger count is inferred from wheel deltas or history-swipe events.
+class WorkspaceSwipeGestureState final {
+ public:
+  bool Update(uint32_t aFingers, WorkspaceSwipePhase aPhase, double aDeltaX,
+              double aDeltaY) {
+    if (aPhase == WorkspaceSwipePhase::Start) {
+      if (aFingers != 3 || !std::isfinite(aDeltaX) || !std::isfinite(aDeltaY)) {
+        return Cancel();
+      }
+      if (++mOperationId == 0) {
+        ++mOperationId;
+      }
+      mActive = true;
+      mDeltaX = 0.0;
+      mDeltaY = 0.0;
+    } else if (!mActive) {
+      return false;
+    }
+    if (aFingers != 3 || !std::isfinite(aDeltaX) || !std::isfinite(aDeltaY) ||
+        (aPhase != WorkspaceSwipePhase::Start &&
+         aPhase != WorkspaceSwipePhase::Update &&
+         aPhase != WorkspaceSwipePhase::End &&
+         aPhase != WorkspaceSwipePhase::Cancel)) {
+      return Cancel();
+    }
+    mDeltaX += aDeltaX;
+    mDeltaY += aDeltaY;
+    if (!std::isfinite(mDeltaX) || !std::isfinite(mDeltaY)) {
+      return Cancel();
+    }
+    mPhase = aPhase;
+    if (aPhase == WorkspaceSwipePhase::End ||
+        aPhase == WorkspaceSwipePhase::Cancel) {
+      mActive = false;
+    }
+    return true;
+  }
+
+  void Reset() {
+    mActive = false;
+    mPhase = WorkspaceSwipePhase::None;
+    mDeltaX = mDeltaY = 0.0;
+  }
+
+  uint32_t OperationId() const { return mOperationId; }
+  WorkspaceSwipePhase Phase() const { return mPhase; }
+  double DeltaX() const { return mDeltaX; }
+  double DeltaY() const { return mDeltaY; }
+
+ private:
+  bool Cancel() {
+    if (!mActive) {
+      return false;
+    }
+    mActive = false;
+    mPhase = WorkspaceSwipePhase::Cancel;
+    // Invalid input must not escape into a DOM event or preview transform.
+    if (!std::isfinite(mDeltaX) || !std::isfinite(mDeltaY)) {
+      mDeltaX = mDeltaY = 0.0;
+    }
+    return true;
+  }
+
+  bool mActive = false;
+  uint32_t mOperationId = 0;
+  WorkspaceSwipePhase mPhase = WorkspaceSwipePhase::None;
+  double mDeltaX = 0.0;
+  double mDeltaY = 0.0;
+};
+
+}  // namespace mozilla::widget
+
+#endif  // mozilla_WorkspaceSwipeGesture_h
