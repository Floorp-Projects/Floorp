+    // call. The actual scripted caller identifies the isolated source world.
+    JSObject* caller = JS::GetScriptedCallerGlobal(aCx);
+    if (IsChromeDetailSourceGlobal(caller)) {
+      mDetailSourceGlobal = caller;
