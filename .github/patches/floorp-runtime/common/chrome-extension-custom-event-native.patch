+// Content-script principals are expanded principals; their direct AddonPolicy
+// is null. Resolve the actual addon principal rather than metadata or an ID
+// suffix. The ordinary serialized policy carries this validated Chrome bit.
+static bool IsChromeDetailSourceGlobal(JSObject* aGlobal) {
+  if (!aGlobal || !xpc::IsWebExtensionContentScriptSandbox(aGlobal)) {
+    return false;
+  }
+  auto* principal =
+      BasePrincipal::Cast(nsContentUtils::ObjectPrincipal(aGlobal));
+  RefPtr<extensions::WebExtensionPolicy> policy =
+      principal->ContentScriptAddonPolicy();
+  return policy && policy->Active() && policy->ChromeCompatibilityEnabled();
+}
