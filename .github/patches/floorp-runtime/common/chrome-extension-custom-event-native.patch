 }
 
 void CustomEvent::GetDetail(JSContext* aCx,
                             JS::MutableHandle<JS::Value> aRetval) {
   aRetval.set(mDetail);
+  JS::Rooted<JSObject*> source(aCx, mDetailSourceGlobal);
+  if (!source || !mDetail.isObject()) {
+    return;
+  }
+  JS::Rooted<JSObject*> target(aCx, JS::GetScriptedCallerGlobal(aCx));
+  if (!target || target == source || !IsChromeDetailSourceGlobal(source)) {
+    return;
+  }
+  auto* sourcePrincipal =
+      BasePrincipal::Cast(nsContentUtils::ObjectPrincipal(source));
+  auto* targetPrincipal =
+      BasePrincipal::Cast(nsContentUtils::ObjectPrincipal(target));
+  if (targetPrincipal->Kind() != BasePrincipal::eContentPrincipal ||
+      targetPrincipal->AddonPolicy() ||
+      !sourcePrincipal->Subsumes(targetPrincipal,
+                                 BasePrincipal::DontConsiderDocumentDomain)) {
+    return;
+  }
+
+  // Match Chrome's world-safe detail: clone for every cross-world read, never
+  // cache or export live objects/functions. Snapshot before getters can reenter
+  // and reinitialize this event. Source-world reads keep the original value.
+  JS::Rooted<JS::Value> detail(aCx, mDetail);
+  aRetval.setNull();
+  StructuredCloneHolder holder(StructuredCloneHolder::CloningSupported,
+                               StructuredCloneHolder::TransferringNotSupported,
+                               JS::StructuredCloneScope::SameProcess);
+  ErrorResult error;
+  error.MightThrowJSException();
+  {
+    JSAutoRealm sourceRealm(aCx, source);
+    if (!JS_WrapValue(aCx, &detail)) {
+      error.StealExceptionFromJSContext(aCx);
+    } else {
+      holder.Write(aCx, detail, error);
+    }
+  }
+  if (error.Failed()) {
+    error.SuppressException();
+    return;
+  }
+  {
+    JSAutoRealm targetRealm(aCx, target);
+    holder.Read(aCx, aRetval, error);
+  }
+  if (error.Failed()) {
+    aRetval.setNull();
+  }
+  // SerializeAndSwallowExceptions in Chrome returns null for unclonable detail
+  // or a throwing accessor. The normal binding must see no pending exception.
+  error.SuppressException();
 }
 
