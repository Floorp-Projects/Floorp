diff --git a/browser/components/extensions/test/browser/browser_ext_floorp_sidePanel.js b/browser/components/extensions/test/browser/browser_ext_floorp_sidePanel.js
new file mode 100644
index 0000000..e2b870a
--- /dev/null
+++ b/browser/components/extensions/test/browser/browser_ext_floorp_sidePanel.js
@@ -0,0 +1,159 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+add_task(async function chrome_side_panel_lifecycle() {
+  const originalId = "a".repeat(32);
+  const extension = ExtensionTestUtils.loadExtension({
+    useAddonManager: "temporary",
+    manifest: {
+      manifest_version: 3,
+      permissions: ["sidePanel", "tabs"],
+      action: {},
+      side_panel: { default_path: "global.html" },
+      browser_specific_settings: {
+        gecko: {
+          id: `${originalId}@chromium-extension`,
+          floorp_chrome_extension: {
+            schema_version: 1,
+            original_id: originalId,
+          },
+        },
+      },
+    },
+    files: {
+      "global.html": '<script src="panel.js"></script>',
+      "tab.html": '<script src="panel.js"></script>',
+      "panel.js": () => {
+        browser.test.sendMessage("panel-loaded", location.pathname);
+      },
+    },
+    background() {
+      let activeTab;
+      let inactiveTab;
+      browser.test.onMessage.addListener(async (command) => {
+        try {
+          if (command === "configure") {
+            [activeTab] = await browser.tabs.query({
+              active: true,
+              currentWindow: true,
+            });
+            inactiveTab = await browser.tabs.create({ active: false });
+            await browser.sidePanel.setOptions({
+              tabId: activeTab.id,
+              path: "tab.html",
+            });
+            browser.test.assertEq(
+              "global.html",
+              (await browser.sidePanel.getOptions({})).path,
+            );
+            browser.test.assertEq(
+              "tab.html",
+              (await browser.sidePanel.getOptions({ tabId: activeTab.id }))
+                .path,
+            );
+            await browser.test.assertRejects(
+              browser.sidePanel.setOptions({ path: "https://example.com/" }),
+              /relative|extension|format/i,
+              "Remote panel URLs are rejected",
+            );
+            await browser.test.assertRejects(
+              browser.sidePanel.open({ windowId: activeTab.windowId }),
+              /user input|user gesture/i,
+              "Opening requires user interaction",
+            );
+            await browser.test.assertRejects(
+              browser.test.withHandlingUserInput(() =>
+                browser.sidePanel.open({ tabId: inactiveTab.id })
+              ),
+              /inactive tabs/,
+              "Unsupported inactive-tab opening rejects",
+            );
+          } else if (command === "open-global") {
+            await browser.test.withHandlingUserInput(() =>
+              browser.sidePanel.open({ windowId: activeTab.windowId })
+            );
+          } else if (command === "open-tab") {
+            await browser.test.withHandlingUserInput(() =>
+              browser.sidePanel.open({ tabId: activeTab.id })
+            );
+          } else if (command === "disable-tab") {
+            await browser.sidePanel.setOptions({
+              tabId: activeTab.id,
+              enabled: false,
+            });
+          } else if (command === "enable-action") {
+            await browser.sidePanel.setOptions({
+              tabId: activeTab.id,
+              enabled: true,
+            });
+            await browser.sidePanel.setPanelBehavior({
+              openPanelOnActionClick: true,
+            });
+            browser.test.assertTrue(
+              (await browser.sidePanel.getPanelBehavior())
+                .openPanelOnActionClick,
+            );
+          } else if (command === "close") {
+            await browser.sidePanel.close({ tabId: activeTab.id });
+          } else if (command === "cleanup") {
+            await browser.tabs.remove(inactiveTab.id);
+          }
+          browser.test.sendMessage("done");
+        } catch (error) {
+          browser.test.fail(`${command}: ${error}`);
+          browser.test.sendMessage("done");
+        }
+      });
+      browser.test.sendMessage("ready");
+    },
+  });
+  await extension.startup();
+  await extension.awaitMessage("ready");
+  const command = async (name) => {
+    extension.sendMessage(name);
+    await extension.awaitMessage("done");
+  };
+  await command("configure");
+  ok(!SidebarController.isOpen, "Panel stays closed at install");
+  await command("open-global");
+  is(
+    await extension.awaitMessage("panel-loaded"),
+    "/global.html",
+    "Window opening uses the global panel",
+  );
+  await command("open-tab");
+  is(
+    await extension.awaitMessage("panel-loaded"),
+    "/tab.html",
+    "Tab opening uses the tab panel",
+  );
+  await command("disable-tab");
+  ok(
+    !SidebarController.isOpen,
+    "Disabling a tab panel closes its real sidebar",
+  );
+  await command("enable-action");
+  await extension.awaitMessage("panel-loaded");
+  await clickBrowserAction(extension);
+  await TestUtils.waitForCondition(() => !SidebarController.isOpen);
+  await clickBrowserAction(extension);
+  is(
+    await extension.awaitMessage("panel-loaded"),
+    "/tab.html",
+    "Action opens the configured tab panel",
+  );
+  await command("close");
+  await command("close");
+  ok(!SidebarController.isOpen, "Closing hides the sidebar");
+  await command("cleanup");
+  await extension.unload();
+  ok(
+    !SidebarController.sidebars.has(
+      `${makeWidgetId(extension.id)}-sidebar-action`,
+    ),
+    "Unload unregisters the panel",
+  );
+});
