diff --git a/browser/components/extensions/parent/ext-sidePanel.js b/browser/components/extensions/parent/ext-sidePanel.js
new file mode 100644
index 0000000..a8a46b2
--- /dev/null
+++ b/browser/components/extensions/parent/ext-sidePanel.js
@@ -0,0 +1,436 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const floorpSidePanels = new WeakMap();
+
+this.sidePanel = class extends ExtensionAPIPersistent {
+  PERSISTENT_EVENTS = {
+    onOpened({ fire }) {
+      return this.registerPanelEvent("opened", fire);
+    },
+    onClosed({ fire }) {
+      return this.registerPanelEvent("closed", fire);
+    },
+  };
+
+  registerPanelEvent(name, fire) {
+    const listener = async (event, info) => {
+      try {
+        if (fire.wakeup) await fire.wakeup();
+        await fire.async(info);
+      } catch (error) {
+        Cu.reportError(error);
+      }
+    };
+    this.on(name, listener);
+    return {
+      unregister: () => this.off(name, listener),
+      convert: (newFire) => {
+        fire = newFire;
+      },
+    };
+  }
+
+  isChromeExtension() {
+    const { extension } = this;
+    const metadata = extension.manifest.browser_specific_settings?.gecko
+      ?.floorp_chrome_extension;
+    return metadata?.schema_version === 1 &&
+      /^[a-p]{32}$/.test(metadata.original_id) &&
+      extension.id === `${metadata.original_id}@chromium-extension`;
+  }
+
+  onStartup() {
+    if (this.isChromeExtension()) this.getAction();
+  }
+
+  getAction() {
+    if (!this.isChromeExtension()) {
+      throw new ExtensionUtils.ExtensionError(
+        "sidePanel requires a converted Chrome extension.",
+      );
+    }
+    if (!this.action) {
+      const { extension } = this;
+      this.states = new Map();
+      this.behaviorPref =
+        `extensions.floorp.sidePanel.openOnAction.${extension.id}`;
+      this.openPanelOnActionClick = Services.prefs.getBoolPref(
+        this.behaviorPref,
+        false,
+      );
+      this.action = extension.apiManager.getAPI("sidebarAction", extension);
+      this.action.isChromeSidePanel = true;
+      this.action.chromeSidePanel = this;
+      const path = extension.manifest.side_panel?.default_path;
+      this.action.initialize({
+        default_panel: path ? this.resolvePath(path) : "",
+        default_icon: extension.manifest.icons,
+        open_at_install: false,
+        browser_style: false,
+      });
+      this.action.defaults.sidePanelPath = path;
+      floorpSidePanels.set(extension, this);
+      this.windowClosed = (window) => {
+        const state = this.states.get(window);
+        if (state?.visible) this.emit("closed", state.visible);
+        state?.cleanup?.();
+        this.states.delete(window);
+      };
+      windowTracker.addCloseListener(this.windowClosed);
+    }
+    return this.action;
+  }
+
+  resolvePath(path) {
+    const { extension } = this;
+    const resource = ExtensionUtils.canonicalizeChromeExtensionResourceURL(extension, path);
+    const url = extension.baseURI.resolve(resource);
+    const uri = Services.io.newURI(url);
+    if (
+      !path || uri.scheme !== extension.baseURI.scheme ||
+      uri.host !== extension.baseURI.host
+    ) {
+      throw new ExtensionUtils.ExtensionError(
+        "Side panel path must be a page within the extension.",
+      );
+    }
+    return url;
+  }
+
+  getState(window) {
+    if (!this.states.has(window)) {
+      const state = {
+        global: false,
+        contextual: false,
+        closed: new WeakSet(),
+        tabs: new Set(),
+        scope: null,
+        visible: null,
+        updating: false,
+      };
+      this.states.set(window, state);
+      const close = (event) => {
+        const tab = event.target;
+        const key = `tab:${tabTracker.getId(tab)}`;
+        this.releaseScope(window, key);
+        state.tabs.delete(tab);
+      };
+      window.gBrowser.tabContainer.addEventListener("TabClose", close);
+      state.cleanup = () =>
+        window.gBrowser.tabContainer.removeEventListener("TabClose", close);
+    }
+    return this.states.get(window);
+  }
+
+  getWindow(options, context) {
+    if (options.tabId == null && options.windowId == null) {
+      throw new ExtensionUtils.ExtensionError(
+        "At least one of tabId and windowId must be specified.",
+      );
+    }
+    const tab = options.tabId != null
+      ? this.getAction().getTargetFromDetails({ tabId: options.tabId })
+      : null;
+    const window = tab?.documentGlobal ??
+      windowTracker.getWindow(options.windowId, context);
+    if (
+      tab && options.windowId != null &&
+      windowTracker.getWindow(options.windowId, context) !== window
+    ) {
+      throw new ExtensionUtils.ExtensionError(
+        "The tab does not belong to the specified window.",
+      );
+    }
+    if (!context.canAccessWindow(window) || !window.SidebarController) {
+      throw new ExtensionUtils.ExtensionError("Invalid side panel window.");
+    }
+    return { window, tab };
+  }
+
+  scopeFor(tab) {
+    return tab && this.action.getContextData(tab).sidePanelConfigured
+      ? { key: `tab:${tabTracker.getId(tab)}`, target: tab }
+      : { key: "global", target: null };
+  }
+
+  getScope(window) {
+    return this.getState(window).scope?.key ?? "global";
+  }
+
+  releaseScope(window, key) {
+    const host = window.SidebarController._floorpSidePanelBrowsers?.get(
+      this.action.id,
+    );
+    host?.contentWindow?.releaseSidePanel?.(key);
+  }
+
+  infoFor(window, scope) {
+    const data = this.action.getContextData(scope.target);
+    return {
+      windowId: windowTracker.getId(window),
+      path: Services.io.newURI(data.panel).filePath,
+      ...(scope.target ? { tabId: tabTracker.getId(scope.target) } : {}),
+    };
+  }
+
+  setVisible(window, scope) {
+    const state = this.getState(window);
+    const next = scope ? this.infoFor(window, scope) : null;
+    if (JSON.stringify(next) === JSON.stringify(state.visible)) return;
+    if (state.visible) this.emit("closed", state.visible);
+    state.visible = next;
+    if (next) {
+      this.emit("opened", next);
+      window.gFloorpLastChromeSidePanelId = this.extension.id;
+    }
+    window.dispatchEvent(
+      new window.CustomEvent("FloorpChromeSidePanelChanged", {
+        detail: { extensionId: this.extension.id, opened: !!next },
+      }),
+    );
+  }
+
+  onPanelShown(window) {
+    const state = this.getState(window);
+    if (!state.scope) {
+      state.contextual = true;
+      state.scope = this.scopeFor(window.gBrowser.selectedTab);
+    }
+    this.setVisible(window, state.scope);
+  }
+
+  onVisibilityChanged(window) {
+    const state = this.getState(window);
+    if (state.updating || !state.scope || this.action.isOpen(window)) return;
+    if (state.scope?.target) state.closed.add(state.scope.target);
+    else state.global = false;
+    state.contextual = false;
+    this.setVisible(window, null);
+  }
+
+  async updateWindow(window) {
+    if (!this.extension.canAccessWindow(window)) return;
+    const state = this.getState(window);
+    const tab = window.gBrowser.selectedTab;
+    const data = this.action.getContextData(tab);
+    let scope = null;
+    if (state.contextual && !state.closed.has(tab)) scope = this.scopeFor(tab);
+    else if (state.tabs.has(tab) && !state.closed.has(tab)) {
+      scope = this.scopeFor(tab);
+    } else if (state.global && !state.closed.has(tab)) {
+      scope = { key: "global", target: null };
+    }
+    const selected = scope ? this.action.getContextData(scope.target) : data;
+    if (scope && (!selected.enabled || !selected.panel)) scope = null;
+    state.updating = true;
+    try {
+      state.scope = scope;
+      this.action.chromePanelTargets.set(window, scope?.target ?? null);
+      // Keep the native entry discoverable even when this tab has no panel.
+      this.action.updateButton(window, selected);
+      if (!scope) {
+        if (this.action.isOpen(window)) {
+          window.SidebarController.hide({ dismissPanel: false });
+        }
+        this.setVisible(window, null);
+      } else if (!this.action.isOpen(window)) {
+        if (!(await window.SidebarController.show(this.action.id))) {
+          throw new ExtensionUtils.ExtensionError(
+            "The side panel could not be opened.",
+          );
+        }
+        this.setVisible(window, scope);
+      } else {
+        this.setVisible(window, scope);
+      }
+    } finally {
+      state.updating = false;
+    }
+  }
+
+  async openInWindow(window, target = null) {
+    this.getAction();
+    const scope = this.scopeFor(target);
+    const data = this.action.getContextData(scope.target);
+    if (!data.enabled || !data.panel) {
+      throw new ExtensionUtils.ExtensionError(
+        "No enabled side panel is available.",
+      );
+    }
+    const state = this.getState(window);
+    if (target) {
+      if (target.selected) state.contextual = true;
+      state.closed.delete(target);
+      state.tabs.add(target);
+    } else {
+      state.global = true;
+      state.contextual = false;
+      state.closed.delete(window.gBrowser.selectedTab);
+    }
+    await this.updateWindow(window);
+  }
+
+  async closeInWindow(window, target = null) {
+    const data = this.action.getContextData(target);
+    if (!data.enabled || !data.panel || (target && !data.sidePanelConfigured)) {
+      throw new ExtensionUtils.ExtensionError(
+        target
+          ? "No active tab-specific side panel is available."
+          : "No active global side panel is available.",
+      );
+    }
+    const state = this.getState(window);
+    if (target) {
+      const scope = this.scopeFor(target);
+      if (scope.key === "global" && state.global) {
+        throw new ExtensionUtils.ExtensionError(
+          "No tab-specific side panel is open in this tab.",
+        );
+      }
+      state.tabs.delete(target);
+      state.closed.add(target);
+    } else {
+      state.global = false;
+      if (state.scope?.key === "global") state.contextual = false;
+    }
+    await this.updateWindow(window);
+  }
+
+  openForAction(tab) {
+    const window = tab.documentGlobal;
+    const state = this.getState(window);
+    if (this.action.isOpen(window)) {
+      if (state.scope?.target) {
+        this.closeInWindow(window, state.scope.target).catch(Cu.reportError);
+      } else {
+        // A tab opening may use the global fallback scope.
+        state.tabs.delete(tab);
+        this.closeInWindow(window).catch(Cu.reportError);
+      }
+    } else this.openInWindow(window, tab).catch(Cu.reportError);
+  }
+
+  static onUninstall(id) {
+    Services.prefs.clearUserPref(
+      `extensions.floorp.sidePanel.openOnAction.${id}`,
+    );
+  }
+
+  onShutdown() {
+    floorpSidePanels.delete(this.extension);
+    if (!this.states) return;
+    windowTracker.removeCloseListener(this.windowClosed);
+    for (const [window, state] of this.states) {
+      state.cleanup?.();
+      if (!window.closed) {
+        window.dispatchEvent(
+          new window.CustomEvent("FloorpChromeSidePanelChanged", {
+            detail: { extensionId: this.extension.id, opened: false },
+          }),
+        );
+      }
+    }
+    this.states.clear();
+  }
+
+  getAPI(context) {
+    const event = (name) =>
+      new EventManager({
+        context,
+        module: "sidePanel",
+        event: name,
+        extensionApi: this,
+      }).api();
+    return {
+      sidePanel: {
+        setOptions: async (options) => {
+          const action = this.getAction();
+          const target = action.getTargetFromDetails({ tabId: options.tabId });
+          const panel = options.path != null
+            ? this.resolvePath(options.path)
+            : null;
+          const data = action.getContextData(target);
+          if (
+            target && !data.sidePanelConfigured &&
+            (panel !== null || options.enabled != null)
+          ) {
+            data.enabled = true;
+            data.panel = "";
+            data.sidePanelPath = undefined;
+            data.sidePanelConfigured = true;
+          }
+          if (panel !== null) {
+            if (data.panel !== panel) {
+              const key = target ? `tab:${tabTracker.getId(target)}` : "global";
+              for (const window of this.states.keys()) {
+                this.releaseScope(window, key);
+              }
+            }
+            data.panel = panel;
+            data.sidePanelPath = options.path;
+          }
+          if (options.enabled != null) data.enabled = options.enabled;
+          for (const window of windowTracker.browserWindows()) {
+            if (!target || target.documentGlobal === window) {
+              await this.updateWindow(window);
+            }
+          }
+        },
+        getOptions: async (options) => {
+          const action = this.getAction();
+          const data = action.getContextData(
+            action.getTargetFromDetails({ tabId: options.tabId }),
+          );
+          return {
+            ...(options.tabId != null && data.sidePanelConfigured
+              ? { tabId: options.tabId }
+              : {}),
+            ...(data.sidePanelPath != null ? { path: data.sidePanelPath } : {}),
+            enabled: data.enabled,
+          };
+        },
+        open: async (options) => {
+          this.getAction();
+          const { window, tab } = this.getWindow(options, context);
+          await this.openInWindow(window, tab);
+        },
+        close: async (options) => {
+          this.getAction();
+          const { window, tab } = this.getWindow(options, context);
+          await this.closeInWindow(window, tab);
+        },
+        getLayout: async () => {
+          this.getAction();
+          const start = Services.prefs.getBoolPref(
+            "sidebar.position_start",
+            true,
+          );
+          const rtl = Services.locale.isAppLocaleRTL;
+          return { side: start !== rtl ? "left" : "right" };
+        },
+        setPanelBehavior: async (options) => {
+          this.getAction();
+          if (options.openPanelOnActionClick != null) {
+            this.openPanelOnActionClick = options.openPanelOnActionClick;
+            Services.prefs.setBoolPref(
+              this.behaviorPref,
+              this.openPanelOnActionClick,
+            );
+          }
+        },
+        getPanelBehavior: async () => {
+          this.getAction();
+          return { openPanelOnActionClick: this.openPanelOnActionClick };
+        },
+        onOpened: event("onOpened"),
+        onClosed: event("onClosed"),
+      },
+    };
+  }
+};
+
+global.sidePanelFor = (extension) => floorpSidePanels.get(extension);
