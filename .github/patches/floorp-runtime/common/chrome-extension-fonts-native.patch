+static nsCString ChromeScriptFont(Script aScript, const char* aGeneric,
+                                  nsAtom* aLanguage) {
+  uint32_t tag = GetScriptTagForCode(aScript);
+  char code[] = {char(tag >> 24), char(tag >> 16), char(tag >> 8), char(tag),
+                 0};
+  if (code[0] >= 'a' && code[0] <= 'z') {
+    code[0] -= 'a' - 'A';
+  }
+  nsAutoCString language;
+  if (aLanguage) {
+    aLanguage->ToUTF8String(language);
+  }
+  ToLowerCase(language);
+  const char* composite = nullptr;
+  if (aScript == Script::HAN) {
+    if (StringBeginsWith(language, "ja"_ns)) {
+      composite = "Jpan";
+    } else if (StringBeginsWith(language, "ko"_ns)) {
+      composite = "Hang";
+    } else if (StringBeginsWith(language, "zh"_ns)) {
+      composite = language.Find("tw") >= 0 || language.Find("hk") >= 0 ||
+                          language.Find("hant") >= 0
+                      ? "Hant"
+                      : "Hans";
+    }
+  } else if (aScript == Script::HIRAGANA || aScript == Script::KATAKANA) {
+    composite = "Jpan";
+  }
+  nsAutoCString prefix("font.chrome.");
+  prefix.Append(aGeneric);
+  prefix.Append('.');
+  nsAutoCString name;
+  nsAutoCString pref;
+  StaticAutoReadLock lock(sChromeFontConfigLock);
+  if (!sChromeFontConfig) {
+    return name;
+  }
+  const auto lookup = [&](const nsACString& key) {
+    auto entry = sChromeFontConfig->Lookup(key);
+    if (entry) {
+      name = entry.Data();
+    }
+  };
+  if (composite) {
+    pref = prefix + nsDependentCString(composite);
+    lookup(pref);
+  }
+  if (name.IsEmpty()) {
+    pref = prefix + nsDependentCString(code);
+    lookup(pref);
+  }
+  if (name.IsEmpty()) {
+    pref = prefix + "Zyyy"_ns;
+    lookup(pref);
+  }
+  return name;
+}
+
+static const char* ChromeGenericName(StyleGenericFontFamily aGeneric) {
+  switch (aGeneric) {
+    case StyleGenericFontFamily::Serif:
+      return "serif";
+    case StyleGenericFontFamily::SansSerif:
+      return "sansserif";
+    case StyleGenericFontFamily::Monospace:
+      return "fixed";
+    case StyleGenericFontFamily::Cursive:
+      return "cursive";
+    case StyleGenericFontFamily::Fantasy:
+      return "fantasy";
+    case StyleGenericFontFamily::Math:
+      return "math";
+    default:
+      return nullptr;
+  }
+}
