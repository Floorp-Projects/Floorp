+bool nsCSPContext::ChromeDebuggerBypassesCSP(nsILoadInfo* aLoadInfo) const {
+  if (!NS_IsMainThread()) return false;
+  RefPtr<Document> document = do_QueryReferent(mLoadingContext);
+  RefPtr<BrowsingContext> context =
+      document ? document->GetBrowsingContext() : nullptr;
+  if (!context && aLoadInfo) context = aLoadInfo->GetBrowsingContext();
+  return context && context->Top()->GetChromeDebuggerBypassCSP() &&
+         context->ChromeDebuggerOverridesAllowed(mSelfURI);
+}
