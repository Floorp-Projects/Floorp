+bool BrowsingContext::ChromeDebuggerOverridesAllowed(nsIURI* aURI) const {
+  if (!aURI || !NS_IsMainThread()) return false;
+  const auto* top = Top();
+  if (top->GetChromeDebuggerOwner().IsEmpty()) return false;
+  const auto* policy = ExtensionPolicyService::GetSingleton().GetByID(
+      top->GetChromeDebuggerOwner());
+  if (!policy || !policy->Active() || !policy->HasPermission(u"debugger"_ns))
+    return false;
+  if (!(aURI->SchemeIs("http") || aURI->SchemeIs("https") ||
+        aURI->SchemeIs("data") ||
+        (aURI->SchemeIs("file") && policy->FileSchemeAllowed()))) {
+    nsAutoCString spec;
+    if (!aURI->SchemeIs("about") || NS_FAILED(aURI->GetSpec(spec)) ||
+        !spec.EqualsLiteral("about:blank"))
+      return false;
+  }
+  return !extensions::WebExtensionPolicy::IsRestrictedURI(aURI) &&
+         !policy->QuarantinedFromURI(aURI) &&
+         policy->CheckGuarded(aURI).IsNull();
+}
+
+bool BrowsingContext::CanSet(FieldIndex<IDX_ChromeDebuggerOwner>,
+                             const nsString&, ContentParent* aSource) {
+  return IsTop() && XRE_IsParentProcess() && !aSource;
+}
+bool BrowsingContext::CanSet(FieldIndex<IDX_ChromeDebuggerFocusEmulation>, bool,
+                             ContentParent* aSource) {
+  return IsTop() && XRE_IsParentProcess() && !aSource;
+}
+void BrowsingContext::DidSet(FieldIndex<IDX_ChromeDebuggerFocusEmulation>,
+                             bool) {
+  PreOrderWalk([](BrowsingContext* context) {
+    if (auto* window = context->GetDOMWindow()) {
+      if (auto* document = window->GetExtantDoc())
+        document->PostVisibilityUpdateEvent();
+    }
+  });
+}
+
+bool BrowsingContext::CanSet(FieldIndex<IDX_ChromeDebuggerBypassCSP>, bool,
+                             ContentParent* aSource) {
+  return IsTop() && XRE_IsParentProcess() && !aSource;
+}
