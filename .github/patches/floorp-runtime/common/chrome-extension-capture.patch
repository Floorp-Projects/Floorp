+        "Selected desktop source does not provide the requested tracks."
+      );
+    return { close };
+  } catch (error) {
+    close();
+    throw error;
+  }
+}
+
+const states = new WeakMap();
+
+async function consume(context, request) {
+  const state = states.get(context);
+  if (!state || state.closed || context.unloaded)
+    throw new ExtensionError("Capture document is no longer available.");
+  const { token, video, audio, wantsVideo, kind } = videoConstraints(request);
+  const namespace = kind === "desktop" ? "desktopCapture" : "tabCapture";
+  if (!state.stopListeners.has(namespace)) {
+    const stopListener = sessionId => {
+      const active = state.streams.get(sessionId);
+      state.streams.delete(sessionId);
+      if (state.pending.has(sessionId)) state.revoked.add(sessionId);
+      if (active) {
+        clearInterval(active.timer);
+        cleanup([
+          () => stopStream(active.stream),
+          () => active.closeAudio?.(),
+        ]);
+      }
+    };
+    context.childManager
+      .getImplementation(namespace, "_onStreamStop")
+      .addListener(stopListener, []);
+    state.stopListeners.set(namespace, stopListener);
+  }
+  const call = (name, args) =>
+    context.childManager.callParentAsyncFunction(`${namespace}.${name}`, args);
+  const { sessionId, browserId } = await call("_consumeStreamId", [
+    token,
+    { audio, video: wantsVideo },
+  ]);
+  state.pending.add(sessionId);
+  let stream, audioState;
+  try {
+    // Only these sanitized constraints reach the privileged native call. Ordinary
+    // getUserMedia calls below execute with the content principal instead.
+    stream =
+      wantsVideo && kind !== "desktop"
+        ? await state.original.call(state.devices, {
+            audio: false,
+            video: {
+              ...video,
+              mediaSource: "browser",
+              deviceId: { exact: String(browserId) },
+            },
+          })
+        : new context.contentWindow.MediaStream();
+    if (kind === "desktop") {
+      audioState = await receiveDesktop(context, sessionId, call, stream, {
+        audio,
+        video: wantsVideo,
+      });
+    } else if (audio) {
+      audioState = await receiveAudio(context, sessionId, call, stream, state);
+    }
+    if (context.unloaded) {
+      stopStream(stream);
+      throw new ExtensionError("Capture document was closed.");
+    }
+    await call("_streamStarted", [sessionId]);
+    if (context.unloaded || state.revoked.has(sessionId)) {
+      throw new ExtensionError("Capture stopped before stream start.");
+    }
+    const tracks = stream.getTracks();
+    const timer = setInterval(() => {
+      if (
+        context.unloaded ||
+        state.closed ||
+        tracks.some(track => Cu.isDeadWrapper(track)) ||
+        tracks.every(track => track.readyState === "ended")
+      ) {
+        clearInterval(timer);
+        state.streams.delete(sessionId);
+        try {
+          cleanup([() => stopStream(stream), () => audioState?.close()]);
+        } finally {
+          if (!context.unloaded)
+            call("_streamStopped", [sessionId]).catch(Cu.reportError);
+        }
+      }
+    }, 100);
+    state.streams.set(sessionId, {
+      stream,
+      timer,
+      closeAudio: () => audioState?.close(),
+    });
+    return stream;
+  } catch (error) {
+    try {
+      cleanup([() => audioState?.close(), () => stopStream(stream)]);
+    } finally {
+      if (!context.unloaded) await call("_streamStopped", [sessionId, true]);
+    }
+    throw error;
+  } finally {
+    state.pending.delete(sessionId);
+    state.revoked.delete(sessionId);
+  }
+}
+
+export const ChromeExtensionCaptureChild = {
+  install(context) {
+    if (!compatible(context.extension)) return;
+    const devices = context.contentWindow.navigator.mediaDevices;
+    if (!devices) return;
+    const original = devices.getUserMedia;
+    const sandbox = Cu.Sandbox(context.principal, {
+      sandboxPrototype: context.contentWindow,
+      wantXrays: false,
+    });
+    // Resolve the ordinary native function entirely inside the content realm;
+    // importing a chrome-side native wrapper would either elevate or deny calls.
+    const forward = Cu.evalInSandbox(
+      "(function() { const devices = navigator.mediaDevices; const original = devices.getUserMedia; return constraints => original.call(devices, constraints); })()",
+      sandbox
+    );
+    const state = {
+      closed: false,
+      devices,
+      original,
+      streams: new Map(),
+      pending: new Set(),
+      revoked: new Set(),
+      stopListeners: new Map(),
+      audioSources: new Map(),
+      audioListener: null,
+    };
+    states.set(context, state);
+    const hook = Cu.exportFunction(constraints => {
+      const request = Cu.waiveXrays(constraints);
+      const source =
+        request?.video?.mandatory?.chromeMediaSource ||
+        request?.audio?.mandatory?.chromeMediaSource;
+      if (source === "tab" || source === "desktop")
+        return inContentPromise(context, () => consume(context, request));
+      return forward(constraints);
+    }, context.cloneScope);
+    Object.defineProperty(Cu.waiveXrays(devices), "getUserMedia", {
+      value: hook,
+      configurable: true,
+      writable: true,
+    });
+    context.callOnClose({
+      close() {
+        state.closed = true;
+        const active = [...state.streams.values()];
+        const audio = [...state.audioSources.values()];
+        state.streams.clear();
+        state.audioSources.clear();
+        state.pending.clear();
+        state.revoked.clear();
+        state.stopListeners.clear();
+        state.audioListener = null;
+        states.delete(context);
+        for (const { timer } of active) clearInterval(timer);
+        try {
+          cleanup([
+            ...active.flatMap(({ stream, closeAudio }) => [
+              () => stopStream(stream),
+              () => closeAudio?.(),
+            ]),
+            ...audio.map(source => source.close),
+          ]);
+        } finally {
+          Cu.nukeSandbox(sandbox);
+        }
+      },
+    });
+  },
+  capture(context, options) {
+    const isHandlingUserInput =
+      context.contentWindow.windowUtils.isHandlingUserInput;
+    return inContentPromise(context, async () => {
+      if (!options.video && !options.audio)
+        throw new ExtensionError(
+          "At least one of video:true or audio:true is required for tab capture."
+        );
+      const token = await context.childManager.callParentAsyncFunction(
+        "tabCapture.getMediaStreamId",
+        [{}],
+        null,
+        {
+          isHandlingUserInput,
+        }
+      );
+      return consume(context, {
+        audio: options.audio
+          ? {
+              mandatory: {
+                ...options.audioConstraints?.mandatory,
+                chromeMediaSource: "tab",
+                chromeMediaSourceId: token,
+              },
+            }
+          : false,
+        video: options.video
+          ? {
+              mandatory: {
+                ...options.videoConstraints?.mandatory,
+                chromeMediaSource: "tab",
+                chromeMediaSourceId: token,
+              },
+            }
+          : false,
+      });
+    });
+  },
+};
