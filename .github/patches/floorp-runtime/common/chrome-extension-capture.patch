+  clearTimeout,
+  setInterval,
+  clearInterval,
+} from "resource://gre/modules/Timer.sys.mjs";
+import { ExtensionUtils } from "resource://gre/modules/ExtensionUtils.sys.mjs";
+const { ExtensionError } = ExtensionUtils;
