--- /dev/null
+++ b/toolkit/components/extensions/ChromeExtensionCaptureAudio.sys.mjs
@@ -0,0 +1,130 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+import { setTimeout, clearTimeout } from "resource://gre/modules/Timer.sys.mjs";
+
+async function completeIce(peer) {
+  if (peer.iceGatheringState === "complete") return;
+  await new Promise((resolve, reject) => {
+    const timer = setTimeout(() => {
+      peer.removeEventListener("icegatheringstatechange", changed);
+      reject(new Error("Local audio transport ICE gathering timed out."));
+    }, 10000);
+    function changed() {
+      if (peer.iceGatheringState === "complete") {
+        clearTimeout(timer);
+        peer.removeEventListener("icegatheringstatechange", changed);
+        resolve();
+      }
+    }
+    peer.addEventListener("icegatheringstatechange", changed);
+    changed();
+  });
+}
+
+export class ChromeExtensionCaptureAudioParent extends JSWindowActorParent {}
+
+// Only the privileged parent capture broker can send these messages. No DOM
+// event or content-provided SDP can open a source or select its destination.
+export class ChromeExtensionCaptureAudioChild extends JSWindowActorChild {
+  sessions = new Map();
+  sourcePromise = null;
+
+  stop(id) {
+    const session = this.sessions.get(id);
+    if (!session) return;
+    this.sessions.delete(id);
+    try {
+      session.peer?.close();
+    } catch {}
+    try {
+      session.track?.stop();
+    } catch {}
+    if (!this.sessions.size && this.sourcePromise) {
+      const pending = this.sourcePromise;
+      pending.then(
+        stream => {
+          if (!this.sessions.size && this.sourcePromise === pending) {
+            try {
+              stream.getTracks().forEach(track => track.stop());
+            } catch {}
+            this.sourcePromise = null;
+          }
+        },
+        () => {
+          if (this.sourcePromise === pending) this.sourcePromise = null;
+        }
+      );
+    }
+  }
+
+  didDestroy() {
+    for (const id of this.sessions.keys()) this.stop(id);
+  }
+
+  async receiveMessage({ name, data }) {
+    if (name === "Stop") {
+      this.stop(data.sessionId);
+      return undefined;
+    }
+    if (
+      !this.manager.isCurrentGlobal ||
+      this.manager.innerWindowId !== data.innerWindowId
+    ) {
+      throw new Error("Audio target document is no longer current.");
+    }
+    if (name === "Answer") {
+      const session = this.sessions.get(data.sessionId);
+      if (!session?.peer) throw new Error("Audio session no longer exists.");
+      await session.peer.setRemoteDescription(data.answer);
+      return undefined;
+    }
+    if (name !== "Start" || this.sessions.has(data.sessionId)) {
+      throw new Error("Invalid audio source request.");
+    }
+    const session = {};
+    this.sessions.set(data.sessionId, session);
+    try {
+      // The actual target document owns Gecko's native AudioCaptureTrackSource.
+      // A native peer connection carries its samples across Fission processes;
+      // no page script, microphone source, or synthetic replacement is used.
+      this.sourcePromise ||= Promise.resolve(
+        this.contentWindow.navigator.mediaDevices.getUserMedia({
+          audio: { mediaSource: "audioCapture" },
+          video: false,
+        })
+      );
+      const source = await this.sourcePromise;
+      if (
+        this.sessions.get(data.sessionId) !== session ||
+        !this.manager.isCurrentGlobal
+      ) {
+        throw new Error(
+          "Audio capture was cancelled before source allocation."
+        );
+      }
+      session.track = source.getAudioTracks()[0].clone();
+      session.peer = new this.contentWindow.RTCPeerConnection({
+        iceServers: [],
+      });
+      session.peer.addTrack(
+        session.track,
+        new this.contentWindow.MediaStream([session.track])
+      );
+      await session.peer.setLocalDescription(await session.peer.createOffer());
+      await completeIce(session.peer);
+      if (
+        this.sessions.get(data.sessionId) !== session ||
+        !this.manager.isCurrentGlobal
+      ) {
+        throw new Error(
+          "Audio capture was cancelled before transport allocation."
+        );
+      }
+      return session.peer.localDescription.toJSON();
+    } catch (error) {
+      this.stop(data.sessionId);
+      throw error;
+    }
+  }
+}
diff --git a/toolkit/components/extensions/ChromeExtensionCaptureRegistry.sys.mjs b/toolkit/components/extensions/ChromeExtensionCaptureRegistry.sys.mjs
new file mode 100644
--- /dev/null
+++ b/toolkit/components/extensions/ChromeExtensionCaptureRegistry.sys.mjs
@@ -0,0 +1,218 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+const tokens = new Map();
+const consumers = new Map();
+export const ChromeExtensionCaptureRegistry = {
+  isLiveConsumer(binding) {
+    if (!binding) return true;
+    const global = BrowsingContext.get(
+      binding.browsingContextId
+    )?.currentWindowGlobal;
+    return !!(
+      global?.isCurrentGlobal &&
+      global.innerWindowId === binding.innerWindowId &&
+      binding.principal.equals(global.documentPrincipal)
+    );
+  },
+  register(token, owner) {
+    this.drop(token);
+    const binding = owner.tokens.get(token)?.consumer;
+    const browserId =
+      binding && BrowsingContext.get(binding.browsingContextId)?.top.browserId;
+    const observer = binding
+      ? (subject, topic) => {
+          if (
+            (topic === "window-global-destroyed" &&
+              subject.innerWindowId === binding.innerWindowId) ||
+            (topic === "window-global-created" &&
+              subject.browsingContext.top === subject.browsingContext &&
+              subject.browsingContext.browserId === browserId &&
+              subject.innerWindowId !== binding.innerWindowId)
+          )
+            owner.dropToken(token);
+        }
+      : null;
+    if (observer)
+      for (const topic of ["window-global-created", "window-global-destroyed"])
+        Services.obs.addObserver(observer, topic);
+    tokens.set(token, { owner, observer });
+  },
+  drop(token) {
+    const record = tokens.get(token);
+    tokens.delete(token);
+    if (record?.observer)
+      for (const topic of ["window-global-created", "window-global-destroyed"])
+        Services.obs.removeObserver(record.observer, topic);
+  },
+  shutdown(owner) {
+    for (const [actor, contexts] of consumers) {
+      const context = contexts.get(owner);
+      if (context) {
+        for (const sessionId of context.sessions) {
+          try {
+            actor.sendAsyncMessage("Event", {
+              apiNamespace: owner.apiNamespace || "tabCapture",
+              name: "_onStreamStop",
+              args: [sessionId],
+            });
+          } catch {}
+        }
+        context.close();
+        contexts.delete(owner);
+      }
+      if (!contexts.size) consumers.delete(actor);
+    }
+  },
+  close(actor) {
+    const contexts = consumers.get(actor);
+    consumers.delete(actor);
+    for (const context of contexts?.values() || []) context.close();
+  },
+  async call(actor, name, args, apiNamespace) {
+    const allowed = new Set([
+      "_consumeStreamId",
+      "_streamStarted",
+      "_streamStopped",
+      "_audioOffers",
+      "_audioAnswer",
+      "_desktopOffer",
+      "_desktopAnswer",
+    ]);
+    if (
+      !allowed.has(name) ||
+      !Array.isArray(args) ||
+      args.length > 3 ||
+      typeof args[0] !== "string"
+    ) {
+      throw new Error("Invalid capture operation.");
+    }
+    let owner, binding;
+    const contexts = consumers.get(actor) || new Map();
+    if (name === "_consumeStreamId") {
+      owner = tokens.get(args[0])?.owner;
+      const record = owner?.tokens.get(args[0]);
+      binding = record?.consumer;
+      const global = actor.manager;
+      if (
+        !binding ||
+        !global.isCurrentGlobal ||
+        binding.browsingContextId !== actor.browsingContext.id ||
+        binding.innerWindowId !== global.innerWindowId ||
+        !binding.principal.equals(global.documentPrincipal)
+      ) {
+        throw new Error(
+          "This capture stream ID does not belong to the current consumer document."
+        );
+      }
+      const options = args[1];
+      if (
+        !options ||
+        typeof options.audio !== "boolean" ||
+        typeof options.video !== "boolean" ||
+        !(options.audio || options.video)
+      ) {
+        throw new Error("Invalid capture track selection.");
+      }
+    } else {
+      for (const [candidate, context] of contexts) {
+        if (context.sessions.has(args[0])) {
+          owner = candidate;
+          break;
+        }
+      }
+      if (!owner) throw new Error("Unknown capture session.");
+    }
+    const namespace = owner.apiNamespace || "tabCapture";
+    if (apiNamespace && apiNamespace !== namespace)
+      throw new Error("Capture token belongs to another API.");
+    let context = contexts.get(owner);
+    if (!context) {
+      const closures = new Set();
+      const listeners = [];
+      context = {
+        actor,
+        extension: owner.extension,
+        envType: "addon_parent",
+        browsingContext: actor.browsingContext,
+        captureConsumer: binding,
+        sessions: new Set(),
+        pending: 0,
+        unloaded: false,
+        callOnClose(closure) {
+          closures.add(closure);
+        },
+        forgetOnClose(closure) {
+          closures.delete(closure);
+        },
+        close() {
+          if (this.unloaded) return;
+          this.unloaded = true;
+          Services.obs.removeObserver(observer, "window-global-created");
+          for (const closure of [...closures]) closure.close();
+          closures.clear();
+          for (const [event, listener] of listeners) owner.off(event, listener);
+          contexts.delete(owner);
+          if (!contexts.size) consumers.delete(actor);
+        },
+      };
+      const browserId = actor.browsingContext.top.browserId;
+      const observer = subject => {
+        if (
+          subject.browsingContext.top === subject.browsingContext &&
+          subject.browsingContext.browserId === browserId &&
+          subject.innerWindowId !== binding.innerWindowId
+        ) {
+          for (const sessionId of context.sessions) {
+            try {
+              actor.sendAsyncMessage("Event", {
+                apiNamespace: namespace,
+                name: "_onStreamStop",
+                args: [sessionId],
+              });
+            } catch {}
+          }
+          context.close();
+        }
+      };
+      Services.obs.addObserver(observer, "window-global-created");
+      const stop = (_event, message) => {
+        if (message.context !== context) return;
+        context.sessions.delete(message.sessionId);
+        if (!context.unloaded)
+          actor.sendAsyncMessage("Event", {
+            apiNamespace: owner.apiNamespace || "tabCapture",
+            name: "_onStreamStop",
+            args: [message.sessionId],
+          });
+      };
+      const audio = (_event, message) => {
+        if (message.context === context && !context.unloaded)
+          actor.sendAsyncMessage("Event", {
+            apiNamespace: owner.apiNamespace || "tabCapture",
+            name: "_onAudioSource",
+            args: [message.sessionId, message.sourceId, message.offer],
+          });
+      };
+      owner.on("capture-stop", stop);
+      listeners.push(["capture-stop", stop]);
+      owner.on("capture-audio-source", audio);
+      listeners.push(["capture-audio-source", audio]);
+      contexts.set(owner, context);
+      consumers.set(actor, contexts);
+    }
+    context.pending++;
+    try {
+      const api = owner.getAPI(context)[namespace];
+      if (!api) throw new Error("Capture permission is no longer available.");
+      const result = await api[name](...args);
+      if (context.unloaded)
+        throw new Error("Capture consumer navigated during allocation.");
+      if (name === "_consumeStreamId") context.sessions.add(result.sessionId);
+      return result;
+    } finally {
+      context.pending--;
+      if (!context.pending && !context.sessions.size) context.close();
+    }
+  },
+};
diff --git a/toolkit/components/extensions/ChromeExtensionCaptureConsumer.sys.mjs b/toolkit/components/extensions/ChromeExtensionCaptureConsumer.sys.mjs
new file mode 100644
--- /dev/null
+++ b/toolkit/components/extensions/ChromeExtensionCaptureConsumer.sys.mjs
@@ -0,0 +1,116 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+import { ChromeExtensionCaptureRegistry } from "resource://gre/modules/ChromeExtensionCaptureRegistry.sys.mjs";
+import { ChromeExtensionCaptureChild } from "resource://gre/modules/ChromeExtensionCaptureChild.sys.mjs";
+
+export class ChromeExtensionCaptureConsumerParent extends JSWindowActorParent {
+  didDestroy() {
+    ChromeExtensionCaptureRegistry.close(this);
+  }
+  async receiveMessage({ name, data }) {
+    if (name !== "Call") throw new Error("Invalid consumer message.");
+    try {
+      return {
+        ok: true,
+        value: await ChromeExtensionCaptureRegistry.call(
+          this,
+          data.name,
+          data.args,
+          data.apiNamespace
+        ),
+      };
+    } catch (error) {
+      return { ok: false, error: error.message };
+    }
+  }
+}
+export class ChromeExtensionCaptureConsumerChild extends JSWindowActorChild {
+  context = null;
+  listeners = new Map();
+  didDestroy() {
+    this.context?.close();
+    this.listeners.clear();
+  }
+  receiveMessage({ name, data }) {
+    if (name === "Event") {
+      for (const listener of this.listeners.get(
+        `${data.apiNamespace || "tabCapture"}.${data.name}`
+      ) || [])
+        listener(...data.args);
+      return undefined;
+    }
+    if (
+      name !== "Install" ||
+      this.context ||
+      !this.manager.isCurrentGlobal ||
+      this.manager.innerWindowId !== data.innerWindowId
+    )
+      return undefined;
+    if (
+      !this.contentWindow.isSecureContext ||
+      !this.contentWindow.navigator.mediaDevices
+    )
+      throw new Error("Capture consumer requires a secure document.");
+    const closures = new Set();
+    const window = this.contentWindow;
+    const context = {
+      contentWindow: window,
+      cloneScope: Cu.waiveXrays(window),
+      principal: window.document.nodePrincipal,
+      unloaded: false,
+      extension: {
+        id: data.extensionId,
+        manifest: {
+          browser_specific_settings: {
+            gecko: { floorp_chrome_extension: data.marker },
+          },
+        },
+        permissions: new Set(["tabCapture", "desktopCapture"]),
+      },
+      normalizeError(error) {
+        return new window.Error(error.message);
+      },
+      callOnClose(closure) {
+        closures.add(closure);
+      },
+      close() {
+        if (this.unloaded) return;
+        this.unloaded = true;
+        for (const closure of closures) closure.close();
+        closures.clear();
+      },
+      childManager: {
+        callParentAsyncFunction: (path, args) => {
+          const [apiNamespace, name] = path.split(".");
+          if (!["tabCapture", "desktopCapture"].includes(apiNamespace) || !name)
+            throw new Error("Invalid consumer API.");
+          return this.sendQuery("Call", { name, apiNamespace, args }).then(
+            result => {
+              if (!result.ok) throw new Error(result.error);
+              return result.value;
+            }
+          );
+        },
+        getImplementation: (namespace, event) => {
+          if (!["tabCapture", "desktopCapture"].includes(namespace))
+            throw new Error("Invalid consumer event.");
+          return {
+            addListener: listener => {
+              const key = namespace + "." + event;
+              let listeners = this.listeners.get(key);
+              if (!listeners) {
+                listeners = new Set();
+                this.listeners.set(key, listeners);
+              }
+              listeners.add(listener);
+            },
+          };
+        },
+      },
+    };
+    this.context = context;
+    ChromeExtensionCaptureChild.install(context);
+    return undefined;
+  }
+}
