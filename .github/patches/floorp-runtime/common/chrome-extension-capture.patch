+      await new Promise((resolve, reject) => {
+        const timer = setTimeout(() => {
+          peer.removeEventListener("connectionstatechange", changed);
+          reject(
+            new ExtensionError("Local audio transport connection timed out.")
+          );
+        }, 10000);
+        function changed() {
+          if (
+            ["connected", "failed", "closed"].includes(peer.connectionState)
+          ) {
+            clearTimeout(timer);
+            peer.removeEventListener("connectionstatechange", changed);
+            if (peer.connectionState === "connected") resolve();
