+
+async function receiveAudio(context, sessionId, call, stream, state) {
+  const window = context.contentWindow;
+  const audioContext = new window.AudioContext();
+  const destination = audioContext.createMediaStreamDestination();
+  const peers = new Map();
+  let closed = false;
+  const close = () => {
+    if (closed) return;
+    closed = true;
+    state.audioSources.delete(sessionId);
+    const currentPeers = [...peers.values()];
+    peers.clear();
+    cleanup([
+      ...currentPeers.flatMap(({ peer, source }) => [
+        () => disconnectSource(source),
+        () => closePeer(peer),
+      ]),
