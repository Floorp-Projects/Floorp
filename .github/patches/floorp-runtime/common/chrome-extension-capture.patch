diff --git a/toolkit/components/extensions/parent/ext-tabCapture.js b/toolkit/components/extensions/parent/ext-tabCapture.js
new file mode 100644
--- /dev/null
+++ b/toolkit/components/extensions/parent/ext-tabCapture.js
@@ -0,0 +1,631 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+
+var { setTimeout: captureSetTimeout, clearTimeout: captureClearTimeout } =
+  ChromeUtils.importESModule("resource://gre/modules/Timer.sys.mjs");
+
+var { ChromeExtensionCaptureRegistry } = ChromeUtils.importESModule(
+  "resource://gre/modules/ChromeExtensionCaptureRegistry.sys.mjs"
+);
+this.tabCapture = class extends ExtensionAPIPersistent {
+  PERSISTENT_EVENTS = {
+    onStatusChanged({ fire }) {
+      const listener = (_event, details) => fire.async(details);
+      this.on("capture-status", listener);
+      return {
+        unregister: () => this.off("capture-status", listener),
+        convert(newFire) {
+          fire = newFire;
+        },
+      };
+    },
+  };
+  tokens = new Map();
+  streams = new Map();
+
+  constructor(extension) {
+    super(extension);
+    try {
+      ChromeUtils.registerWindowActor("ChromeExtensionCaptureAudio", {
+        parent: {
+          esModuleURI:
+            "resource://gre/modules/ChromeExtensionCaptureAudio.sys.mjs",
+        },
+        child: {
+          esModuleURI:
+            "resource://gre/modules/ChromeExtensionCaptureAudio.sys.mjs",
+        },
+        allFrames: true,
+        safeForUntrustedWebProcess: true,
+      });
+    } catch (error) {
+      if (!String(error).includes("already")) throw error;
+    }
+    try {
+      ChromeUtils.registerWindowActor("ChromeExtensionCaptureConsumer", {
+        parent: {
+          esModuleURI:
+            "resource://gre/modules/ChromeExtensionCaptureConsumer.sys.mjs",
+        },
+        child: {
+          esModuleURI:
+            "resource://gre/modules/ChromeExtensionCaptureConsumer.sys.mjs",
+        },
+        allFrames: true,
+        safeForUntrustedWebProcess: true,
+      });
+    } catch (error) {
+      if (!String(error).includes("already")) throw error;
+    }
+    this.permissionsRemoved = (_event, removed) => {
+      if (removed.permissions.includes("tabCapture")) {
+        for (const token of this.tokens.keys()) this.dropToken(token);
+        for (const session of [...this.streams.values()]) session.stop();
+      }
+    };
+    extension.on("remove-permissions", this.permissionsRemoved);
+  }
+
+  dropToken(token) {
+    ChromeExtensionCaptureRegistry.drop(token);
+    const record = this.tokens.get(token);
+    captureClearTimeout(record?.timer);
+    record?.context.forgetOnClose(record.contextClose);
+    this.tokens.delete(token);
+  }
+
+  onShutdown() {
+    ChromeExtensionCaptureRegistry.shutdown(this);
+    this.extension.off("remove-permissions", this.permissionsRemoved);
+    for (const token of this.tokens.keys()) this.dropToken(token);
+    for (const session of this.streams.values()) {
+      session.unobserve();
+      session.context.forgetOnClose(session.contextClose);
+      session.clearBackendPermission();
+    }
+    this.streams.clear();
+  }
+
+  getAPI(context) {
+    const { extension } = this;
+    const marker =
+      extension.manifest.browser_specific_settings?.gecko
+        ?.floorp_chrome_extension;
+    if (
+      marker?.schema_version !== 1 ||
+      !/^[a-p]{32}$/.test(marker.original_id) ||
+      extension.id !== `${marker.original_id}@chromium-extension` ||
+      !extension.hasPermission("tabCapture")
+    ) {
+      return {};
+    }
+    const error = message => new ExtensionUtils.ExtensionError(message);
+    const ownDocument = () => {
+      const window = context.browsingContext?.currentWindowContext;
+      const global = context.actor?.manager;
+      const topPrincipal =
+        context.browsingContext?.top.currentWindowContext?.documentPrincipal;
+      if (
+        !topPrincipal?.equals(window?.documentPrincipal) ||
+        !global?.isCurrentGlobal ||
+        global.innerWindowId !== window?.innerWindowId ||
+        !extension.hasPermission("tabCapture") ||
+        context.unloaded ||
+        context.envType !== "addon_parent" ||
+        !window ||
+        (window.documentPrincipal.originNoSuffix !==
+          extension.baseURI.prePath &&
+          !(
+            context.captureConsumer?.browsingContextId ===
+              context.browsingContext.id &&
+            context.captureConsumer.innerWindowId === window.innerWindowId &&
+            context.captureConsumer.principal.equals(window.documentPrincipal)
+          ))
+      ) {
+        throw error(
+          "Tab capture requires a live document belonging to the extension."
+        );
+      }
+      return window;
+    };
+    const ownIssuer = () => {
+      if (context.viewType !== "background_worker") return ownDocument();
+      if (
+        context.unloaded ||
+        !extension.workerBackground ||
+        extension.backgroundContext !== context ||
+        !context.principal?.equals(extension.principal) ||
+        !extension.hasPermission("tabCapture")
+      ) {
+        throw error(
+          "Tab capture requires the active extension background worker."
+        );
+      }
+      const manager = Cc["@mozilla.org/serviceworkers/manager;1"].getService(
+        Ci.nsIServiceWorkerManager
+      );
+      const registration = manager.getRegistrationForAddonPrincipal(
+        extension.principal
+      );
+      const worker = registration?.getWorkerByID(context.workerDescriptorId);
+      if (
+        !worker ||
+        worker.id !== registration.activeWorker?.id ||
+        worker.state !== Ci.nsIServiceWorkerInfo.STATE_ACTIVATED
+      ) {
+        throw error(
+          "Tab capture requires the current activated background worker."
+        );
+      }
+    };
+    const validTarget = target =>
+      target?.documentPrincipal &&
+      !target.documentPrincipal.isSystemPrincipal &&
+      !target.documentPrincipal.isExpandedPrincipal &&
+      !target.documentPrincipal.addonPolicy;
+    const status = (session, value) => {
+      session.status = value;
+      this.emit("capture-status", {
+        tabId: session.tabId,
+        status: value,
+        fullscreen: false,
+      });
+    };
+    const finish = (sessionId, value = "stopped") => {
+      const session = this.streams.get(sessionId);
+      if (session?.context === context) {
+        this.streams.delete(sessionId);
+        session.unobserve();
+        context.forgetOnClose(session.contextClose);
+        session.clearBackendPermission();
+        status(session, value);
+        if (!context.unloaded)
+          this.emit("capture-stop", { context, sessionId });
+      }
+    };
+    return {
+      tabCapture: {
+        getMediaStreamId: async (options = {}) => {
+          ownIssuer();
+          if (!context.callContextData?.isHandlingUserInput) {
+            throw error("getMediaStreamId requires a user gesture.");
+          }
+          let consumer, consumerGlobal;
+          if (options.consumerTabId != null) {
+            const nativeConsumer = extension.tabManager.get(
+              options.consumerTabId
+            )?.nativeTab;
+            const global =
+              nativeConsumer?.linkedBrowser.browsingContext
+                ?.currentWindowGlobal;
+            if (
+              !nativeConsumer ||
+              !extension.tabManager.canAccessTab(nativeConsumer) ||
+              !global?.isCurrentGlobal ||
+              global.documentPrincipal.isNullPrincipal ||
+              !global.documentPrincipal.isOriginPotentiallyTrustworthy ||
+              !(
+                validTarget(global) ||
+                global.documentPrincipal.originNoSuffix ===
+                  extension.baseURI.prePath
+              )
+            ) {
+              throw error(
+                "consumerTabId requires an accessible secure current document."
+              );
+            }
+            consumer = {
+              browsingContextId: global.browsingContext.id,
+              innerWindowId: global.innerWindowId,
+              principal: global.documentPrincipal,
+            };
+            if (
+              global.documentPrincipal.originNoSuffix !==
+              extension.baseURI.prePath
+            )
+              consumerGlobal = global;
+          }
+          const nativeTab =
+            options.targetTabId == null
+              ? tabTracker.activeTab
+              : extension.tabManager.get(options.targetTabId)?.nativeTab;
+          if (
+            !nativeTab ||
+            !extension.tabManager.canAccessTab(nativeTab) ||
+            nativeTab !== nativeTab.documentGlobal.gBrowser.selectedTab ||
+            (context.pendingEventBrowser
+              ? context.pendingEventBrowser !== nativeTab.linkedBrowser
+              : nativeTab !== tabTracker.activeTab)
+          ) {
+            throw error(
+              "Tab capture requires the active tab selected by the user."
+            );
+          }
+          const browser = nativeTab.linkedBrowser;
+          const uri = browser.currentURI;
+          if (
+            !["http", "https", "data", "blob", "file"].some(scheme =>
+              uri.schemeIs(scheme)
+            ) &&
+            uri.spec !== "about:blank"
+          ) {
+            throw error("Privileged browser pages cannot be captured.");
+          }
+          const target = browser.browsingContext.currentWindowGlobal;
+          if (!validTarget(target))
+            throw error(
+              "Target document is privileged or no longer available."
+            );
+          const grant = extension.floorpTabCaptureGrant;
+          if (
+            !(
+              grant?.browsingContextId === browser.browsingContext.id &&
+              grant.innerWindowId === target.innerWindowId
+            )
+          ) {
+            throw error(
+              "Tab capture requires a real extension action invocation."
+            );
+          }
+          if (consumerGlobal) {
+            await consumerGlobal
+              .getActor("ChromeExtensionCaptureConsumer")
+              .sendQuery("Install", {
+                innerWindowId: consumerGlobal.innerWindowId,
+                extensionId: extension.id,
+                marker,
+              });
+            ownIssuer();
+            if (
+              !consumerGlobal.isCurrentGlobal ||
+              browser.browsingContext.currentWindowGlobal?.innerWindowId !==
+                target.innerWindowId
+            ) {
+              throw error(
+                "Capture consumer or source navigated before stream ID issuance."
+              );
+            }
+          }
+          const token = `floorp-tab-capture-${Services.uuid.generateUUID()}`;
+          const contextClose = { close: () => this.dropToken(token) };
+          this.tokens.set(token, {
+            context,
+            contextClose,
+            browser,
+            consumer,
+            tabId: tabTracker.getId(nativeTab),
+            innerWindowId: target.innerWindowId,
+            expires: Date.now() + 10000,
+            timer: captureSetTimeout(() => this.dropToken(token), 10000),
+          });
+          ChromeExtensionCaptureRegistry.register(token, this);
+          context.callOnClose(contextClose);
+          return token;
+        },
+        _consumeStreamId: async (
+          token,
+          options = { video: true, audio: false }
+        ) => {
+          ownDocument();
+          const record = this.tokens.get(token);
+          this.dropToken(token); // A stream ID is single-use, including failed starts.
+          if (
+            record?.consumer &&
+            (record.consumer.browsingContextId !== context.browsingContext.id ||
+              record.consumer.innerWindowId !== ownDocument().innerWindowId ||
+              !record.consumer.principal.equals(
+                ownDocument().documentPrincipal
+              ))
+          ) {
+            throw error(
+              "Capture stream ID belongs to another consumer document."
+            );
+          }
+          if (
+            !record ||
+            record.expires < Date.now() ||
+            record.browser.browsingContext?.currentWindowGlobal
+              ?.innerWindowId !== record.innerWindowId
+          ) {
+            throw error(
+              "Invalid, expired, or navigated tab capture stream ID."
+            );
+          }
+          if (
+            [...this.streams.values()].some(
+              stream => stream.tabId === record.tabId
+            )
+          ) {
+            throw error("This extension is already capturing the tab.");
+          }
+          const sessionId = String(Services.uuid.generateUUID());
+          const consumerInnerWindowId = ownDocument().innerWindowId;
+          const targetContext = record.browser.browsingContext;
+          const targetBrowserId = targetContext.browserId;
+          const audioSources = new Map();
+          const audioSource = async global => {
+            if (
+              !global?.isCurrentGlobal ||
+              !validTarget(global) ||
+              !this.streams.has(sessionId)
+            )
+              return null;
+            const sourceId = String(global.innerWindowId);
+            if (audioSources.has(sourceId)) return null;
+            const source = {
+              actor: global.getActor("ChromeExtensionCaptureAudio"),
+              innerWindowId: global.innerWindowId,
+            };
+            audioSources.set(sourceId, source);
+            try {
+              const offer = await source.actor.sendQuery("Start", {
+                sessionId,
+                innerWindowId: source.innerWindowId,
+              });
+              if (!this.streams.has(sessionId) || !global.isCurrentGlobal)
+                throw error("Audio source document changed.");
+              return { sourceId, offer };
+            } catch (failure) {
+              audioSources.delete(sourceId);
+              try {
+                source.actor.sendAsyncMessage("Stop", { sessionId });
+              } catch {}
+              if (!global.isCurrentGlobal || !this.streams.has(sessionId))
+                return null;
+              throw failure;
+            }
+          };
+          const observer = (subject, topic) => {
+            if (
+              options.audio &&
+              topic === "window-global-created" &&
+              subject.browsingContext.top.browserId === targetBrowserId &&
+              subject.browsingContext !== subject.browsingContext.top
+            ) {
+              audioSource(subject).then(
+                source => {
+                  if (source)
+                    this.emit("capture-audio-source", {
+                      context,
+                      sessionId,
+                      ...source,
+                    });
+                },
+                () => finish(sessionId, "error")
+              );
+            }
+            if (topic === "window-global-destroyed") {
+              const sourceId = String(subject.innerWindowId);
+              if (audioSources.delete(sourceId))
+                this.emit("capture-audio-source", {
+                  context,
+                  sessionId,
+                  sourceId,
+                  offer: null,
+                });
+              return;
+            }
+            const observed =
+              topic === "browsing-context-discarded"
+                ? subject
+                : subject.browsingContext;
+            if (
+              observed?.top === observed &&
+              observed.browserId === targetBrowserId &&
+              (topic === "browsing-context-discarded" ||
+                subject.innerWindowId !== record.innerWindowId)
+            )
+              finish(sessionId);
+          };
+          const progress = {
+            QueryInterface: ChromeUtils.generateQI([
+              "nsIWebProgressListener",
+              "nsISupportsWeakReference",
+            ]),
+            onStateChange(webProgress, _request, flags) {
+              if (
+                webProgress.isTopLevel &&
+                flags & Ci.nsIWebProgressListener.STATE_START &&
+                flags & Ci.nsIWebProgressListener.STATE_IS_DOCUMENT
+              )
+                finish(sessionId);
+            },
+            onLocationChange(webProgress) {
+              if (
+                webProgress.isTopLevel &&
+                record.browser.browsingContext?.currentWindowGlobal
+                  ?.innerWindowId !== record.innerWindowId
+              )
+                finish(sessionId);
+            },
+          };
+          record.browser.addProgressListener(
+            progress,
+            Ci.nsIWebProgress.NOTIFY_STATE_DOCUMENT |
+              Ci.nsIWebProgress.NOTIFY_LOCATION
+          );
+          Services.obs.addObserver(observer, "window-global-destroyed");
+          Services.obs.addObserver(observer, "window-global-created");
+          Services.obs.addObserver(observer, "browsing-context-discarded");
+          const session = {
+            context,
+            record,
+            audioSources,
+            audioSource,
+            options,
+            consumerInnerWindowId,
+            tabId: record.tabId,
+            status: "pending",
+            contextClose: { close: () => finish(sessionId) },
+            stop: () => finish(sessionId),
+            permissionPrincipal: ownDocument().documentPrincipal,
+            permissionExpires: Date.now() + 10000,
+            backendPermissionInstalled: false,
+            clearBackendPermission() {
+              if (!this.backendPermissionInstalled) return;
+              this.backendPermissionInstalled = false;
+              const permission = Services.perms.getPermissionObject(
+                this.permissionPrincipal,
+                "MediaManagerVideo",
+                true
+              );
+              if (
+                permission?.expireType === Services.perms.EXPIRE_TIME &&
+                permission.expireTime === this.permissionExpires
+              ) {
+                Services.perms.removeFromPrincipal(
+                  this.permissionPrincipal,
+                  "MediaManagerVideo"
+                );
+              }
+            },
+            unobserve() {
+              for (const source of audioSources.values()) {
+                try {
+                  source.actor.sendAsyncMessage("Stop", { sessionId });
+                } catch {}
+              }
+              audioSources.clear();
+              Services.obs.removeObserver(observer, "window-global-destroyed");
+              if (record.browser.webProgress)
+                record.browser.removeProgressListener(progress);
+              Services.obs.removeObserver(observer, "window-global-created");
+              Services.obs.removeObserver(
+                observer,
+                "browsing-context-discarded"
+              );
+            },
+          };
+          this.streams.set(sessionId, session);
+          context.callOnClose(session.contextClose);
+          status(session, "pending");
+          if (
+            options.video &&
+            Services.perms.testExactPermissionFromPrincipal(
+              session.permissionPrincipal,
+              "MediaManagerVideo"
+            ) !== Services.perms.UNKNOWN_ACTION
+          ) {
+            finish(sessionId, "error");
+            throw error("Another video permission request is pending.");
+          }
+          // CamerasParent consumes this internal permission after exactly one
+          // allocation, as it does for a user-approved native WebRTC request.
+          try {
+            if (options.video) {
+              Services.perms.addFromPrincipal(
+                session.permissionPrincipal,
+                "MediaManagerVideo",
+                Services.perms.ALLOW_ACTION,
+                Services.perms.EXPIRE_TIME,
+                session.permissionExpires
+              );
+              session.backendPermissionInstalled = true;
+            }
+          } catch (failure) {
+            finish(sessionId, "error");
+            throw failure;
+          }
+          return {
+            sessionId,
+            browserId: record.browser.browsingContext.browserId,
+          };
+        },
+        _audioOffers: async sessionId => {
+          ownDocument();
+          const session = this.streams.get(sessionId);
+          if (!session || session.context !== context || !session.options.audio)
+            throw error("Invalid audio session.");
+          const contexts = [session.record.browser.browsingContext];
+          const offers = [];
+          while (contexts.length) {
+            const current = contexts.shift();
+            contexts.push(...current.children);
+            const offer = await session.audioSource(
+              current.currentWindowGlobal
+            );
+            if (offer) offers.push(offer);
+          }
+          return offers;
+        },
+        _audioAnswer: async (sessionId, sourceId, answer) => {
+          ownDocument();
+          const session = this.streams.get(sessionId);
+          const source = session?.audioSources.get(sourceId);
+          if (session?.context !== context || !source)
