+  } catch (error) {
+    close();
+    throw error;
+  }
+}
+
+async function receiveDesktop(context, sessionId, call, stream, options) {
+  const peer = new context.contentWindow.RTCPeerConnection({ iceServers: [] });
+  let closed = false;
+  const close = () => {
+    if (closed) return;
+    closed = true;
+    cleanup([() => closePeer(peer), () => stopStream(stream)]);
+  };
+  peer.addEventListener("track", event => {
+    if (closed) {
+      stopTrack(event.track);
+      return;
+    }
+    if (
+      (event.track.kind === "audio" && options.audio) ||
+      (event.track.kind === "video" && options.video)
+    )
+      stream.addTrack(event.track);
+    else stopTrack(event.track);
+  });
+  try {
+    await peer.setRemoteDescription(await call("_desktopOffer", [sessionId]));
+    await peer.setLocalDescription(await peer.createAnswer());
+    if (peer.iceGatheringState !== "complete")
+      await new Promise((resolve, reject) => {
+        const timer = setTimeout(() => {
+          peer.removeEventListener("icegatheringstatechange", changed);
+          reject(new ExtensionError("Desktop transport gathering timed out."));
+        }, 10000);
+        function changed() {
+          if (peer.iceGatheringState === "complete") {
+            clearTimeout(timer);
+            peer.removeEventListener("icegatheringstatechange", changed);
+            resolve();
+          }
+        }
+        peer.addEventListener("icegatheringstatechange", changed);
+        changed();
+      });
+    await call("_desktopAnswer", [sessionId, peer.localDescription.toJSON()]);
+    if (peer.connectionState !== "connected")
+      await new Promise((resolve, reject) => {
+        const timer = setTimeout(() => {
+          peer.removeEventListener("connectionstatechange", changed);
+          reject(new ExtensionError("Desktop transport connection timed out."));
+        }, 10000);
+        function changed() {
+          if (
+            ["connected", "failed", "closed"].includes(peer.connectionState)
+          ) {
+            clearTimeout(timer);
+            peer.removeEventListener("connectionstatechange", changed);
+            if (peer.connectionState === "connected") resolve();
+            else reject(new ExtensionError("Desktop transport failed."));
+          }
+        }
+        peer.addEventListener("connectionstatechange", changed);
+        changed();
+      });
