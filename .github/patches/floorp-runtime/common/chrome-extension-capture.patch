+function inContentPromise(context, operation) {
+  return new context.cloneScope.Promise(
+    Cu.exportFunction((resolve, reject) => {
+      Promise.resolve()
+        .then(operation)
+        .then(resolve, error => reject(context.normalizeError(error)));
+    }, context.cloneScope)
+  );
+}
+
+// A context can be destroyed before its parent-side stop notification arrives.
+// Drop our ownership first, then dispose every still-live native resource. A
+// dead wrapper has already lost its document; touching it would abort cleanup
+// of the other sessions. Unexpected failures are reported after all operations.
+function cleanup(operations) {
+  const errors = [];
+  for (const operation of operations) {
+    try {
+      operation();
+    } catch (error) {
+      errors.push(error);
+    }
+  }
+  if (errors.length === 1) throw errors[0];
+  if (errors.length) throw new AggregateError(errors, "Capture cleanup failed.");
