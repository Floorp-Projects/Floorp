+            !validTarget(
+              session.record.browser.browsingContext?.currentWindowGlobal
+            ) ||
+            session.record.browser.browsingContext?.currentWindowGlobal
+              ?.innerWindowId !== session.record.innerWindowId ||
+            ownDocument().innerWindowId !== session.consumerInnerWindowId
+          ) {
+            finish(sessionId, "error");
+            throw error(
+              "Capture document or target navigated before stream start."
+            );
+          }
+          session.clearBackendPermission();
+          status(session, "active");
+        },
+        _streamStopped: async (sessionId, failed = false) =>
+          finish(sessionId, failed ? "error" : "stopped"),
+        getCapturedTabs: async () =>
+          [...this.streams.values()].map(session => ({
+            tabId: session.tabId,
+            status: session.status,
+            fullscreen: false,
+          })),
+        onStatusChanged: new EventManager({
+          context,
+          module: "tabCapture",
+          event: "onStatusChanged",
+          extensionApi: this,
+        }).api(),
+        _onAudioSource: new EventManager({
+          context,
+          name: "tabCapture._onAudioSource",
+          register: fire => {
+            const listener = (_event, source) => {
+              if (source.context === context)
+                return fire.async(
+                  source.sessionId,
+                  source.sourceId,
+                  source.offer
+                );
+            };
+            this.on("capture-audio-source", listener);
+            return () => this.off("capture-audio-source", listener);
+          },
+        }).api(),
+        _onStreamStop: new EventManager({
+          context,
+          name: "tabCapture._onStreamStop",
+          register: fire => {
+            const listener = (_event, stopped) => {
+              if (stopped.context === context)
+                return fire.async(stopped.sessionId);
+            };
+            this.on("capture-stop", listener);
+            return () => this.off("capture-stop", listener);
+          },
+        }).api(),
+      },
+    };
+  }
+};
