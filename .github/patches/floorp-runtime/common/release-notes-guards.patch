+++ b/toolkit/components/extensions/test/xpcshell/test_ext_floorp_release_notes_dnr.js
@@ -0,0 +1,69 @@
+"use strict";
+
+add_task(async function floorp_dnr_frame_scope_and_restore() {
+  const { ExtensionDNR } = ChromeUtils.importESModule(
+    "resource://gre/modules/ExtensionDNR.sys.mjs"
+  );
+  const modePref = "floorp.releaseNotes.mode";
+  const confirmPref = "floorp.releaseNotes.choiceConfirmed";
+  const oldMode = Services.prefs.getStringPref(modePref, "blocking");
+  const oldConfirmed = Services.prefs.getBoolPref(confirmPref, false);
+  const hadMode = Services.prefs.prefHasUserValue(modePref);
+  const hadConfirmed = Services.prefs.prefHasUserValue(confirmPref);
+  const ids = [
+    "uBlock0@raymondhill.net", "adguardadblocker@adguard.com",
+    "{d10d0bf8-f5b5-c8b4-a8b2-2b9879e08c5d}",
+    "jid1-NIfFY2CA8fy1tg@jetpack", "firefox@ghostery.com", "control@test",
+  ];
+  try {
+    for (const id of ids) {
+      const extension = ExtensionTestUtils.loadExtension({
+        manifest: {
+          manifest_version: 3,
+          browser_specific_settings: { gecko: { id } },
+          permissions: ["declarativeNetRequest"],
+          host_permissions: ["<all_urls>"],
+          declarative_net_request: {
+            rule_resources: [{ id: "probe", enabled: true, path: "rules.json" }],
+          },
+        },
+        files: {
+          "rules.json": JSON.stringify([{
+            id: 1, priority: 1, action: { type: "block" },
+            condition: { urlFilter: "floorp-probe", resourceTypes: ["script"] },
+          }]),
+        },
+      });
+      await extension.startup();
+      try {
+        await ExtensionDNR.ensureInitialized(extension.extension);
+        for (const confirmed of [false, true]) {
+          Services.prefs.setBoolPref(confirmPref, confirmed);
+          for (const mode of ["support", "blocking", "disabled"]) {
+            Services.prefs.setStringPref(modePref, mode);
+            for (const top of ["https://blog.floorp.app/", "https://example.org/",
+              "https://blog.floorp.app.example.org/"]) {
+              const matches = ExtensionDNR.getMatchedRulesForRequest({
+                requestURI: Services.io.newURI("https://example.org/floorp-probe.js"),
+                initiatorURI: Services.io.newURI("https://ads.example.net/"),
+                type: "script", method: "get", tabId: -1,
+                browsingContext: { top: { currentURI: Services.io.newURI(top) } },
+              }, extension.extension);
+              const restricted = id !== "control@test" && confirmed &&
+                mode === "support" && top === "https://blog.floorp.app/";
+              Assert.equal(matches.length, restricted ? 0 : 1,
+                `${id}, ${mode}, confirmed=${confirmed}, top=${top}`);
+            }
+          }
+        }
+      } finally {
+        await extension.unload();
+      }
+    }
+  } finally {
+    if (hadMode) Services.prefs.setStringPref(modePref, oldMode);
+    else Services.prefs.clearUserPref(modePref);
+    if (hadConfirmed) Services.prefs.setBoolPref(confirmPref, oldConfirmed);
+    else Services.prefs.clearUserPref(confirmPref);
+  }
+});
