+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "ExtensionOmnibox.h"
+#include "ExtensionEventManager.h"
+#include "ExtensionAPICallFunctionNoReturn.h"
+#include "jsapi.h"
+#include "jsfriendapi.h"
+#include "js/CallArgs.h"
+#include "mozilla/dom/WorkerPrivate.h"
+#include "mozilla/dom/WorkerScope.h"
+
+#include "mozilla/dom/ExtensionOmniboxBinding.h"
+#include "nsIGlobalObject.h"
+
+namespace mozilla::extensions {
+
+namespace {
+bool SubmitOmniboxSuggestions(JSContext* aCx, unsigned aArgc, JS::Value* aVp) {
+  JS::CallArgs args = JS::CallArgsFromVp(aArgc, aVp);
+  dom::Sequence<JS::Value> callArgs;
+  dom::SequenceRooter<JS::Value> argsRooter(aCx, &callArgs);
+  if (!callArgs.AppendElement(js::GetFunctionNativeReserved(&args.callee(), 0),
+                              fallible) ||
+      !callArgs.AppendElement(args.get(0), fallible)) {
+    JS_ReportOutOfMemory(aCx);
+    return false;
+  }
+  auto* worker = dom::GetCurrentThreadWorkerPrivate();
+  auto request = MakeRefPtr<ExtensionAPICallFunctionNoReturn>(
+      u"omnibox"_ns, u"__submitSuggestions"_ns);
+  ErrorResult rv;
+  request->Run(worker->GlobalScope(), aCx, callArgs, rv);
+  if (rv.MaybeSetPendingException(aCx, "omnibox suggestion callback")) {
+    return false;
+  }
+  args.rval().setUndefined();
+  return true;
+}
+}  // namespace
+
+void ExtensionOmnibox::CreateSuggestCallback(
+    JSContext* aCx, JS::Handle<JS::Value> aDescriptor,
+    JS::MutableHandle<JS::Value> aRetval, ErrorResult& aRv) {
+  if (!aDescriptor.isInt32() || aDescriptor.toInt32() <= 0) {
+    aRv.Throw(NS_ERROR_UNEXPECTED);
+    return;
+  }
+  JS::Rooted<JSFunction*> function(
+      aCx, js::NewFunctionWithReserved(aCx, SubmitOmniboxSuggestions, 1, 0,
+                                       "suggest"));
+  if (!function) {
+    aRv.MightThrowJSException();
+    aRv.StealExceptionFromJSContext(aCx);
+    return;
+  }
+  JS::Rooted<JSObject*> object(aCx, JS_GetFunctionObject(function));
+  js::SetFunctionNativeReserved(object, 0, aDescriptor);
+  aRetval.setObject(*object);
+}
+
+NS_IMPL_CYCLE_COLLECTING_ADDREF(ExtensionOmnibox)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(ExtensionOmnibox)
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(
+    ExtensionOmnibox, mGlobal, mExtensionBrowser, mOnInputStartedEventMgr,
+    mOnInputChangedEventMgr, mOnInputEnteredEventMgr, mOnInputCancelledEventMgr,
+    mOnDeleteSuggestionEventMgr)
+
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(ExtensionOmnibox)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+ExtensionOmnibox::ExtensionOmnibox(nsIGlobalObject* aGlobal,
+                                   ExtensionBrowser* aExtensionBrowser)
+    : mGlobal(aGlobal), mExtensionBrowser(aExtensionBrowser) {
+  MOZ_DIAGNOSTIC_ASSERT(mGlobal);
+  MOZ_DIAGNOSTIC_ASSERT(mExtensionBrowser);
+}
