+namespace {
+// Tracing this reserved slot retains the real DOM helper and its SDK caches.
+// The helper's cycle-collection trace retains the root in the opposite
+// direction.
+ExtensionBrowser* ChromeRootOwner(JS::Handle<JSObject*> aRoot) {
+  const JS::Value& value = JS::GetReservedSlot(aRoot, 0);
+  MOZ_ASSERT(value.isObject());
+  return dom::UnwrapPossiblyNotInitializedDOMObject<ExtensionBrowser>(
+      &value.toObject());
+}
+
+bool ChromeRootResolve(JSContext* aCx, JS::Handle<JSObject*> aRoot,
+                       JS::Handle<jsid> aId, bool* aResolved) {
+  return ChromeRootOwner(aRoot)->ResolveChromeNamespace(aCx, aRoot, aId,
+                                                        aResolved);
