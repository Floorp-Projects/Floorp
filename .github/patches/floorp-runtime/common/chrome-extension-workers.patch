+
+#ifndef mozilla_extensions_PortDisconnectObserver_h
+#define mozilla_extensions_PortDisconnectObserver_h
+
+#include "mozIExtensionAPIRequestHandling.h"
+#include "mozilla/Mutex.h"
+#include "mozilla/WeakPtr.h"
+#include "mozilla/dom/WorkerRef.h"
+
+namespace mozilla {
+
+class ErrorResult;
+
+namespace dom {
+class WorkerPrivate;
+}
+
+namespace extensions {
+
+class ExtensionPort;
+
+// Internal disconnect bookkeeping, independent of public Port listeners.
+// Neither the Port nor its worker is kept alive by this observer.
+class PortDisconnectObserver final
+    : public mozIExtensionEventListener {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+  NS_DECL_MOZIEXTENSIONEVENTLISTENER
+
+  // All methods except CallListener are called only on the owning worker.
+  static already_AddRefed<PortDisconnectObserver> Create(
+      ExtensionPort* aPort, ErrorResult& aRv);
+  void Cleanup();
+  bool NotifyOnWorker();
+
+ private:
+  PortDisconnectObserver(ExtensionPort* aPort,
+                                  dom::WorkerPrivate* aWorkerPrivate);
+  ~PortDisconnectObserver();
+
+  // Accessed and released only on the owning worker. Cleanup clears both
+  // before the observer can be destroyed on another thread.
+  WeakPtr<ExtensionPort> mPort;
+  RefPtr<dom::WeakWorkerRef> mWorkerRef;
+
+  Mutex mMutex{"PortDisconnectObserver::mMutex"};
+
+  // The weak notification clears this under mMutex before the worker can
+  // finish shutting down. Main-thread dispatch is bounded by the same lock.
+  // This is never obtained through WeakWorkerRef::GetUnsafePrivate().
+  dom::WorkerPrivate* mWorkerPrivate MOZ_GUARDED_BY(mMutex);
+};
+
+}  // namespace extensions
+}  // namespace mozilla
+
+#endif  // mozilla_extensions_PortDisconnectObserver_h
