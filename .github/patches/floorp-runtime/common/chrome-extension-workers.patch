+++ b/toolkit/components/extensions/webidl-api/ExtensionDesktopCapture.cpp
@@ -0,0 +1,116 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "ExtensionDesktopCapture.h"
+#include "jsapi.h"
+#include "ExtensionAPICallAsyncFunction.h"
+#include "js/CallAndConstruct.h"
+#include "js/Conversions.h"
+#include "mozilla/dom/ExtensionDesktopCaptureBinding.h"
+#include "mozilla/dom/Promise.h"
+#include "mozilla/dom/WorkerPrivate.h"
+#include "mozilla/dom/WorkerScope.h"
+#include "nsIGlobalObject.h"
+
+namespace mozilla::extensions {
+NS_IMPL_CYCLE_COLLECTING_ADDREF(ExtensionDesktopCapture)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(ExtensionDesktopCapture)
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(ExtensionDesktopCapture, mGlobal,
+                                      mExtensionBrowser)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(ExtensionDesktopCapture)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+ExtensionDesktopCapture::ExtensionDesktopCapture(nsIGlobalObject* aGlobal,
+                                                 ExtensionBrowser* aBrowser)
+    : mGlobal(aGlobal), mExtensionBrowser(aBrowser) {}
+
+bool ExtensionDesktopCapture::IsAllowed(JSContext* aCx, JSObject* aGlobal) {
+  auto* worker = dom::GetWorkerPrivateFromContext(aCx);
+  return worker && worker->ExtensionChromeCompatibilityEnabled();
+}
+JSObject* ExtensionDesktopCapture::WrapObject(
+    JSContext* aCx, JS::Handle<JSObject*> aGivenProto) {
+  return dom::ExtensionDesktopCapture_Binding::Wrap(aCx, this, aGivenProto);
+}
+nsIGlobalObject* ExtensionDesktopCapture::GetParentObject() const {
+  return mGlobal;
+}
+
+int32_t ExtensionDesktopCapture::CallWebExtMethodChooseDesktopMedia(
+    JSContext* aCx, const nsAString& aApiMethod,
+    const dom::Sequence<JS::Value>& aArgs, ErrorResult& aRv) {
+  if (aArgs.Length() < 2 || aArgs.Length() > 3 ||
+      !aArgs.LastElement().isObject() ||
+      !JS::IsCallable(&aArgs.LastElement().toObject())) {
+    aRv.ThrowTypeError("chooseDesktopMedia requires sources and a callback");
+    return 0;
+  }
+  JS::Rooted<JSObject*> callbackObject(aCx, &aArgs.LastElement().toObject());
+  JS::Rooted<JSObject*> global(aCx, JS::CurrentGlobalOrNull(aCx));
+  RefPtr<dom::Function> callback =
+      new dom::Function(aCx, callbackObject, global, dom::GetIncumbentGlobal());
+  do {
+    mNextRequestId = mNextRequestId == INT32_MAX ? 1 : mNextRequestId + 1;
+  } while (mPendingRequests.Contains(mNextRequestId));
+  const int32_t requestId = mNextRequestId;
+  mPendingRequests.Insert(requestId);
+  dom::Sequence<JS::Value> args;
+  dom::SequenceRooter<JS::Value> argsRooter(aCx, &args);
+  if (!args.AppendElement(JS::Int32Value(requestId), fallible) ||
+      !args.AppendElement(aArgs[0], fallible) ||
+      (aArgs.Length() == 3 && !args.AppendElement(aArgs[1], fallible))) {
+    mPendingRequests.Remove(requestId);
+    aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return 0;
+  }
+  RefPtr<dom::Promise> promise = dom::Promise::Create(mGlobal, aRv);
+  if (aRv.Failed()) {
+    mPendingRequests.Remove(requestId);
+    return 0;
+  }
+  auto request = CallAsyncFunction(u"_choose"_ns);
+  request->Run(mGlobal, aCx, args, promise, aRv);
+  if (aRv.Failed()) {
+    mPendingRequests.Remove(requestId);
+    return 0;
+  }
+  ChromeCompatCallbackHandler::Create(
+      mExtensionBrowser, promise, callback,
+      ChromeCompatCallbackHandler::ResultMode::DesktopStream,
+      [self = RefPtr{this}, requestId]() {
+        return self->TakePendingRequest(requestId);
+      });
+  return requestId;
+}
+
+void ExtensionDesktopCapture::CallWebExtMethodCancelDesktopMedia(
+    JSContext* aCx, const nsAString& aApiMethod,
+    const dom::Sequence<JS::Value>& aArgs, ErrorResult& aRv) {
+  MOZ_ASSERT(aArgs.Length() == 1);
+  int32_t aRequestId;
+  JS::Rooted<JS::Value> requestValue(aCx, aArgs[0]);
+  if (!requestValue.isNumber() ||
+      !JS::ToInt32(aCx, requestValue, &aRequestId) ||
+      requestValue.toNumber() != aRequestId) {
+    aRv.ThrowTypeError(
+        "cancelChooseDesktopMedia requires an integer request ID");
+    return;
+  }
+  mPendingRequests.Remove(aRequestId);
+  dom::Sequence<JS::Value> args;
+  dom::SequenceRooter<JS::Value> argsRooter(aCx, &args);
+  if (!args.AppendElement(JS::Int32Value(aRequestId), fallible)) {
+    aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return;
+  }
+  RefPtr<dom::Promise> promise = dom::Promise::Create(mGlobal, aRv);
+  if (aRv.Failed()) return;
+  auto request = CallAsyncFunction(u"_cancel"_ns);
+  request->Run(mGlobal, aCx, args, promise, aRv);
+  // Cancellation is synchronous in Chrome. Backend errors remain reported on
+  // the rejected native promise, while cancellation suppresses its callback.
+}
+}  // namespace mozilla::extensions
