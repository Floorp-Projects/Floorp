+
+bool ServiceWorkerPrivate::RenewExtensionActivity() {
+  AssertIsOnMainThread();
+  // Termination clears the controller synchronously. In particular, a delayed
+  // parent idle notification must never create a replacement worker.
+  if (!mInfo || !mControllerChild ||
+      mInfo->State() != ServiceWorkerState::Activated) {
+    return false;
+  }
+  auto* policy = BasePrincipal::Cast(mInfo->Principal())->AddonPolicy();
+  if (!policy || !policy->Active() ||
+      !policy->BackgroundServiceWorkerAllowed() ||
+      !policy->ChromeCompatibilityEnabled()) {
+    return false;
+  }
+  RenewKeepAliveToken(ServiceWorkerLifetimeExtension(FullLifetimeExtension{}));
+  return true;
 }
 
