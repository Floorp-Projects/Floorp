+      Assert.equal(testError, null);
+      Assert.deepEqual(testResult, [
+        [{ target: { tabId: 7 }, files: ["script.js"] }, null],
+        [
+          {
+            target: { tabId: 7 },
+            func: { source: "() => 'must not become callable'" },
+          },
+          null,
+        ],
+      ]);
+    },
+  });
+});
+
+add_task(async function test_execute_script_serialization_rejections() {
+  await runExtensionAPITest("executeScript rejects unserializable arguments", {
+    async backgroundScript({ testAsserts }) {
+      const cyclic = {};
+      cyclic.self = cyclic;
+      const messages = [];
+      for (const args of [[cyclic], [1n], {}]) {
+        const promise = browser.scripting.executeScript({
+          target: { tabId: 7 },
+          func: () => 1,
+          args,
+        });
+        testAsserts.isInstanceOf(promise, "Promise");
+        await promise.then(
+          () => {
+            throw new Error("Unexpected successful serialization");
+          },
+          error => messages.push(error.message)
+        );
+      }
+      const badSource = () => 1;
+      badSource.toString = () => {
+        throw new Error("source serialization failed");
+      };
+      await browser.scripting
+        .executeScript({ target: { tabId: 7 }, func: badSource })
+        .then(
+          () => {
+            throw new Error("Unexpected successful function serialization");
+          },
+          error => messages.push(error.message)
+        );
+      const callbackError = await new Promise(resolve => {
+        const result = chrome.scripting.executeScript(
+          { target: { tabId: 7 }, func: () => 1, args: [cyclic] },
+          value => {
+            testAsserts.equal(value, undefined);
+            resolve(chrome.runtime.lastError?.message);
+          }
+        );
+        testAsserts.equal(result, undefined);
+      });
+      testAsserts.equal(chrome.runtime.lastError, undefined);
+      return { messages, callbackError };
+    },
+    mockAPIRequestHandler() {
+      throw new Error("Unserializable arguments must not reach the main thread");
+    },
+    assertResults({ testResult, testError }) {
+      Assert.equal(testError, null);
+      Assert.deepEqual(testResult, {
+        messages: [
+          "Unserializable arguments.",
+          "Unserializable arguments.",
+          "'args' must be an array.",
+          "Unserializable arguments.",
+        ],
+        callbackError: "Unserializable arguments.",
+      });
+    },
+  });
+});
