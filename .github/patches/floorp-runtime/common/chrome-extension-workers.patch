+void RejectExecuteScript(
+    JSContext* aCx, nsIGlobalObject* aGlobal,
+    ExtensionBrowser* aExtensionBrowser,
+    const dom::Optional<OwningNonNull<dom::Function>>& aCallback,
+    JS::MutableHandle<JS::Value> aRetval, ErrorResult& aRv) {
+  JS::Rooted<JS::Value> error(aCx);
+  if (!JS_GetPendingException(aCx, &error)) {
+    aRv.Throw(NS_ERROR_UNEXPECTED);
+    return;
+  }
+  JS_ClearPendingException(aCx);
+
+  RefPtr<dom::Promise> promise = dom::Promise::Create(aGlobal, aRv);
+  if (aRv.Failed()) {
+    return;
+  }
+  promise->MaybeReject(error);
+  if (aCallback.WasPassed()) {
+    RefPtr<dom::Function> callback = &aCallback.Value();
+    ChromeCompatCallbackHandler::Create(aExtensionBrowser, promise, callback);
+  } else if (!dom::ToJSValue(aCx, promise, aRetval)) {
+    aRv.MightThrowJSException();
+    aRv.StealExceptionFromJSContext(aCx);
+  }
+}
+
+bool SerializeScriptInjection(JSContext* aCx,
+                              const dom::Sequence<JS::Value>& aArgs,
+                              dom::Sequence<JS::Value>& aSerializedArgs) {
+  if (aArgs.Length() != 1 || !aArgs[0].isObject()) {
+    JS_ReportErrorASCII(aCx, "Invalid scripting.executeScript injection.");
+    return false;
+  }
+
+  JS::Rooted<JSObject*> injection(aCx, &aArgs[0].toObject());
+  bool isArray;
+  if (!JS::IsArrayObject(aCx, injection, &isArray)) {
+    return false;
+  }
+  if (isArray || JS::IsCallable(injection)) {
+    JS_ReportErrorASCII(aCx, "Invalid scripting.executeScript injection.");
+    return false;
+  }
+
+  JS::Rooted<JSObject*> nullPrototype(aCx);
+  JS::Rooted<JSObject*> serialized(
+      aCx, JS_NewObjectWithGivenProto(aCx, nullptr, nullPrototype));
+  if (!serialized || !JS_AssignObject(aCx, serialized, injection)) {
+    return false;
+  }
+
+  JS::Rooted<JS::Value> func(aCx);
+  JS::Rooted<JS::Value> source(aCx, JS::NullValue());
+  if (!JS_GetProperty(aCx, serialized, "func", &func)) {
+    return false;
+  }
+  if (func.isObject() && JS::IsCallable(&func.toObject())) {
+    JS::Rooted<JSObject*> functionObject(aCx, &func.toObject());
+    JS::Rooted<JS::Value> toString(aCx);
+    JS::Rooted<JS::Value> functionSource(aCx);
+    if (!JS_GetProperty(aCx, functionObject, "toString", &toString) ||
+        !JS::Call(aCx, func, toString, JS::HandleValueArray::empty(),
+                  &functionSource)) {
+      JS_ClearPendingException(aCx);
+      JS_ReportErrorASCII(aCx, "Unserializable arguments.");
+      return false;
+    }
+    JS::Rooted<JSString*> sourceString(aCx, JS::ToString(aCx, functionSource));
+    if (!sourceString) {
+      JS_ClearPendingException(aCx);
+      JS_ReportErrorASCII(aCx, "Unserializable arguments.");
+      return false;
+    }
+    source.setString(sourceString);
+    if (!JS_DefineProperty(aCx, serialized, "func", JS::NullHandleValue,
+                           JSPROP_ENUMERATE)) {
+      return false;
+    }
+  }
+
+  JS::Rooted<JS::Value> args(aCx);
+  if (!JS_GetProperty(aCx, serialized, "args", &args)) {
+    return false;
+  }
+  if (!args.isNullOrUndefined()) {
+    JS::Rooted<JSObject*> argsObject(
+        aCx, args.isObject() ? &args.toObject() : nullptr);
+    if (!argsObject || !JS::IsArrayObject(aCx, argsObject, &isArray)) {
+      if (!JS_IsExceptionPending(aCx)) {
+        JS_ReportErrorASCII(aCx, "'args' must be an array.");
+      }
+      return false;
+    }
+    if (!isArray) {
+      JS_ReportErrorASCII(aCx, "'args' must be an array.");
+      return false;
+    }
