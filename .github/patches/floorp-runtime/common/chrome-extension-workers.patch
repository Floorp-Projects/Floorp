diff --git a/toolkit/components/extensions/webidl-api/PortDisconnectObserver.cpp b/toolkit/components/extensions/webidl-api/PortDisconnectObserver.cpp
new file mode 100644
--- /dev/null
+++ b/toolkit/components/extensions/webidl-api/PortDisconnectObserver.cpp
@@ -0,0 +1,184 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "PortDisconnectObserver.h"
+
+#include "ExtensionPort.h"
+#include "mozilla/ErrorResult.h"
+#include "mozilla/dom/Promise.h"
+#include "mozilla/dom/ScriptSettings.h"
+#include "mozilla/dom/WorkerPrivate.h"
+#include "mozilla/dom/WorkerRunnable.h"
+#include "nsIGlobalObject.h"
+#include "nsProxyRelease.h"
+#include "nsThreadUtils.h"
+#include "xpcpublic.h"
+
+namespace mozilla::extensions {
+
+namespace {
+
+class ExtensionPortDisconnectRunnable final : public dom::WorkerThreadRunnable {
+ public:
+  ExtensionPortDisconnectRunnable(PortDisconnectObserver* aObserver,
+                                  dom::Promise* aPromise)
+      : WorkerThreadRunnable("ExtensionPortDisconnectRunnable"),
+        mObserver(aObserver),
+        mPromise(new nsMainThreadPtrHolder<dom::Promise>(
+            "ExtensionPortDisconnectRunnable::mPromise", aPromise)) {
+    MOZ_ASSERT(NS_IsMainThread());
+  }
+
+  bool WorkerRun(JSContext* aCx, dom::WorkerPrivate* aWorkerPrivate) override {
+    aWorkerPrivate->AssertIsOnWorkerThread();
+    // Only native state changes here. Do not call an extension callback or
+    // create a public event listener to receive this notification.
+    Finish(mObserver->NotifyOnWorker());
+    return true;
+  }
+
+  nsresult Cancel() override {
+    // Cancellation does not run WorkerRun and must still settle the main
+    // caller's ACK. In particular, no control runnable may resurrect a worker.
+    Finish(false);
+    return NS_OK;
+  }
+
+ private:
+  ~ExtensionPortDisconnectRunnable() {
+    // Also covers failed dispatch, pre-start cleanup, failed PreRun and an
+    // accepted runnable discarded during worker shutdown without Cancel().
+    Finish(false);
+  }
+
+  void Finish(bool aDelivered) {
+    if (mPromise == nullptr) {
+      return;
+    }
+    auto promise = std::move(mPromise);
+    auto settle = [promise = std::move(promise), aDelivered]() {
+      MOZ_ASSERT(NS_IsMainThread());
+      if (aDelivered) {
+        promise->MaybeResolveWithUndefined();
+      } else {
+        promise->MaybeReject(NS_ERROR_ABORT);
+      }
+    };
+    if (NS_IsMainThread()) {
+      settle();
+    } else {
+      // The handle never AddRefs, Releases or dereferences Promise on a worker.
+      // Its final release is proxied even if main-thread shutdown rejects the
+      // dispatch. While the main loop exists, every exit path settles the ACK.
+      nsresult rv = NS_DispatchToMainThread(NS_NewRunnableFunction(
+          "ExtensionPortDisconnectRunnable::Finish", std::move(settle)));
+      NS_WARNING_ASSERTION(NS_SUCCEEDED(rv),
+                           "Failed to dispatch Port disconnect ACK");
+      (void)rv;
+    }
+  }
+
+  RefPtr<PortDisconnectObserver> mObserver;
+  nsMainThreadPtrHandle<dom::Promise> mPromise;
+};
+
+}  // namespace
+
+NS_IMPL_ISUPPORTS(PortDisconnectObserver, mozIExtensionEventListener)
+
+PortDisconnectObserver::PortDisconnectObserver(
+    ExtensionPort* aPort, dom::WorkerPrivate* aWorkerPrivate)
+    : mPort(aPort), mWorkerPrivate(aWorkerPrivate) {
+  aWorkerPrivate->AssertIsOnWorkerThread();
+}
+
+PortDisconnectObserver::~PortDisconnectObserver() {
+  // This object has a thread-safe refcount but its weak references do not.
+  // Cleanup on the worker is mandatory before the last remote reference dies.
+  MOZ_ASSERT(!mWorkerRef);
+  MOZ_ASSERT(!mPort);
+  MutexAutoLock lock(mMutex);
+  MOZ_ASSERT(!mWorkerPrivate);
+}
+
+// static
+already_AddRefed<PortDisconnectObserver>
+PortDisconnectObserver::Create(ExtensionPort* aPort, ErrorResult& aRv) {
+  MOZ_ASSERT(aPort);
+  auto* workerPrivate = dom::GetCurrentThreadWorkerPrivate();
+  MOZ_ASSERT(workerPrivate);
+  workerPrivate->AssertIsOnWorkerThread();
+  RefPtr<PortDisconnectObserver> observer =
+      new PortDisconnectObserver(aPort, workerPrivate);
+  observer->mWorkerRef = dom::WeakWorkerRef::Create(
+      workerPrivate, [observer]() { observer->Cleanup(); });
+  if (!observer->mWorkerRef) {
+    observer->Cleanup();
+    aRv.Throw(NS_ERROR_ABORT);
+    return nullptr;
+  }
+  return observer.forget();
+}
+
+void PortDisconnectObserver::Cleanup() {
+  MOZ_ASSERT(dom::IsCurrentThreadRunningWorker());
+  // Releasing the WeakWorkerRef also releases its self-capturing callback.
+  RefPtr<PortDisconnectObserver> kungFuGrip = this;
+  {
+    MutexAutoLock lock(mMutex);
+    if (mWorkerPrivate) {
+      mWorkerPrivate->AssertIsOnWorkerThread();
+      mWorkerPrivate = nullptr;
+    }
+  }
+  mPort = nullptr;
+  mWorkerRef = nullptr;
+}
+
+bool PortDisconnectObserver::NotifyOnWorker() {
+  MOZ_ASSERT(dom::IsCurrentThreadRunningWorker());
+  const bool delivered = !!mPort;
+  if (delivered) {
+    mPort->MarkDisconnected();
+  }
+  Cleanup();
+  return delivered;
+}
+
+NS_IMETHODIMP PortDisconnectObserver::CallListener(
+    const nsTArray<JS::Value>& aArgs,
+    mozIExtensionListenerCallOptions* aCallOptions, JSContext* aCx,
+    dom::Promise** aPromiseResult) {
+  MOZ_ASSERT(NS_IsMainThread());
+  NS_ENSURE_ARG_POINTER(aPromiseResult);
+  *aPromiseResult = nullptr;
+
+  nsIGlobalObject* global = xpc::CurrentNativeGlobal(aCx);
+  if (NS_WARN_IF(!global)) {
+    return NS_ERROR_FAILURE;
+  }
+  IgnoredErrorResult rv;
+  RefPtr<dom::Promise> promise = dom::Promise::Create(global, rv);
+  if (rv.Failed()) {
+    return rv.StealNSResult();
+  }
+
+  {
+    MutexAutoLock lock(mMutex);
+    if (!mWorkerPrivate) {
+      promise->MaybeReject(NS_ERROR_ABORT);
+    } else {
+      RefPtr<ExtensionPortDisconnectRunnable> runnable =
+          new ExtensionPortDisconnectRunnable(this, promise);
+      // The weak notification cannot clear mWorkerPrivate until Dispatch
+      // returns. No raw WorkerPrivate escapes this bounded critical section.
+      // A dispatch failure destroys the runnable on main and rejects its ACK.
+      (void)runnable->Dispatch(mWorkerPrivate);
+    }
+  }
+  promise.forget(aPromiseResult);
+  return NS_OK;
+}
+
+}  // namespace mozilla::extensions
