+
+add_task(async function test_execute_script_worker_serialization() {
+  await runExtensionAPITest("executeScript serializes in the worker", {
+    async backgroundScript({ testAsserts }) {
+      let called = false;
+      const func = value => {
+        called = true;
+        return value;
+      };
+      const args = [
+        { text: "日本語\n\"", nested: [1, true] },
+        new Date("2025-01-02T03:04:05Z"),
+        undefined,
+        () => 1,
+        NaN,
+      ];
+      const injection = {
+        target: { tabId: 7, documentIds: ["native-document-id"] },
+        func,
+        args,
+        world: "MAIN",
+      };
+      const result = await browser.scripting.executeScript(injection);
+      testAsserts.equal(called, false, "serialization must not invoke func");
+      testAsserts.equal(injection.func, func, "original func is unchanged");
+      testAsserts.equal(injection.args, args, "original args are unchanged");
+      testAsserts.isInstanceOf(args[1], "Date");
+      return result;
+    },
+    mockAPIRequestHandler(policy, request) {
+      if (
+        request.apiNamespace !== "scripting" ||
+        request.apiName !== "executeScript" ||
+        request.requestType !== "callAsyncFunction"
+      ) {
+        throw new Error("Unexpected API request");
+      }
+      const [injection, source] = request.args;
+      if (
+        injection.func !== null ||
+        !source.includes("called = true") ||
+        request.args.length !== 2
+      ) {
+        throw new Error("Function source was not serialized");
+      }
+      return {
+        type: Ci.mozIExtensionAPIRequestResult.RETURN_VALUE,
+        value: injection,
+      };
+    },
+    assertResults({ testResult, testError }) {
+      Assert.equal(testError, null);
+      Assert.deepEqual(testResult, {
+        target: { tabId: 7, documentIds: ["native-document-id"] },
+        func: null,
+        args: [
+          { text: "日本語\n\"", nested: [1, true] },
+          "2025-01-02T03:04:05.000Z",
+          null,
+          null,
+          null,
+        ],
+        world: "MAIN",
+      });
+    },
+  });
+});
+
+add_task(async function test_execute_script_files_and_invalid_func() {
+  await runExtensionAPITest("executeScript preserves file and type validation", {
+    async backgroundScript() {
+      return Promise.all([
+        browser.scripting.executeScript({
+          target: { tabId: 7 },
+          files: ["script.js"],
+        }),
+        browser.scripting.executeScript({
+          target: { tabId: 7 },
+          func: { source: "() => 'must not become callable'" },
+        }),
+      ]);
+    },
+    mockAPIRequestHandler(policy, request) {
+      return {
+        type: Ci.mozIExtensionAPIRequestResult.RETURN_VALUE,
+        value: request.args,
+      };
+    },
