+// Chrome's root is a native JS object with ordinary property descriptors.
+// Resolving a known namespace installs its genuine SDK object as an own data
+// property. Resolve hooks keep missing-property lookups live after permissions
+// are granted; they do not replace the root or captured SDK objects.
+#define CHROME_WORKER_NAMESPACES(X)                                         \
+  X(action, Action, u"manifest:action", u"manifest:browser_action")         \
+  X(alarms, Alarms, u"alarms")                                              \
+  X(bookmarks, Bookmarks, u"bookmarks")                                     \
+  X(commands, Commands, u"manifest:commands")                               \
+  X(contextMenus, ContextMenus, u"contextMenus")                            \
+  X(cookies, Cookies, u"cookies")                                           \
+  X(debugger, Debugger, u"debugger")                                        \
+  X(declarativeContent, DeclarativeContent, u"declarativeContent")          \
+  X(declarativeNetRequest, DeclarativeNetRequest, u"declarativeNetRequest", \
+    u"declarativeNetRequestWithHostAccess")                                 \
+  X(desktopCapture, DesktopCapture, u"desktopCapture")                      \
+  X(downloads, Downloads, u"downloads")                                     \
+  X(extension, Extension)                                                   \
+  X(fontSettings, FontSettings, u"fontSettings")                            \
+  X(history, History, u"history")                                           \
+  X(i18n, I18n)                                                             \
+  X(identity, Identity, u"identity")                                        \
+  X(idle, Idle, u"idle")                                                    \
+  X(management, Management)                                                 \
+  X(notifications, Notifications, u"notifications")                         \
+  X(offscreen, Offscreen, u"offscreen")                                     \
+  X(omnibox, Omnibox, u"manifest:omnibox")                                  \
+  X(permissions, Permissions)                                               \
+  X(power, Power, u"power")                                                 \
+  X(privacy, Privacy, u"privacy")                                           \
+  X(proxy, Proxy, u"proxy")                                                 \
+  X(runtime, Runtime)                                                       \
+  X(scripting, Scripting, u"scripting")                                     \
+  X(sessions, Sessions, u"sessions")                                        \
+  X(sidePanel, SidePanel, u"sidePanel")                                     \
+  X(storage, Storage, u"storage")                                           \
+  X(tabCapture, TabCapture, u"tabCapture")                                  \
+  X(tabGroups, TabGroups, u"tabGroups")                                     \
+  X(tabs, Tabs)                                                             \
+  X(topSites, TopSites, u"topSites")                                        \
+  X(tts, Tts, u"tts")                                                       \
+  X(userScripts, UserScripts, u"userScripts", u"manifest:user_scripts")     \
+  X(webNavigation, WebNavigation, u"webNavigation")                         \
+  X(webRequest, WebRequest, u"webRequest")                                  \
+  X(windows, Windows)
+
+namespace {
+enum class ChromeNamespaceIndex : size_t {
+#define CHROME_NAMESPACE_INDEX(name, accessor, ...) name,
+  CHROME_WORKER_NAMESPACES(CHROME_NAMESPACE_INDEX)
+#undef CHROME_NAMESPACE_INDEX
+};
+struct ChromeNamespace {
+  const char* name;
+  std::initializer_list<const char16_t*> permissions;
+};
+#define CHROME_NAMESPACE_METADATA(name, accessor, ...) {#name, {__VA_ARGS__}},
+const ChromeNamespace kChromeNamespaces[] = {
+    CHROME_WORKER_NAMESPACES(CHROME_NAMESPACE_METADATA)};
+#undef CHROME_NAMESPACE_METADATA
+constexpr size_t kChromeNamespaceCount =
+    sizeof(kChromeNamespaces) / sizeof(ChromeNamespace);
+static_assert(kChromeNamespaceCount <= 64);
+
+uint64_t ChromeNamespaceMask(const nsTArray<nsString>& aPermissions) {
+  uint64_t result = 0;
+  for (size_t i = 0; i < kChromeNamespaceCount; ++i) {
+    const auto& entry = kChromeNamespaces[i];
+    bool visible = !entry.permissions.size();
+    for (const auto* permission : entry.permissions) {
+      if (aPermissions.Contains(nsDependentString(permission))) {
+        visible = true;
+        break;
+      }
+    }
+    if (i == size_t(ChromeNamespaceIndex::userScripts)) {
+      visible =
+          aPermissions.Contains(u"userScripts"_ns) &&
+          aPermissions.Contains(u"internal:floorpChromeUserScriptsAllowed"_ns);
+    }
+    if (visible) result |= uint64_t(1) << i;
+  }
