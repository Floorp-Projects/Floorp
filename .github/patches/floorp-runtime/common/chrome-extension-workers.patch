+NS_IMPL_CYCLE_COLLECTING_RELEASE(ExtensionTabCapture)
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(ExtensionTabCapture, mGlobal,
+                                      mExtensionBrowser,
+                                      mOnStatusChangedEventMgr)
+
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(ExtensionTabCapture)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+ExtensionTabCapture::ExtensionTabCapture(nsIGlobalObject* aGlobal,
+                                         ExtensionBrowser* aExtensionBrowser)
+    : mGlobal(aGlobal), mExtensionBrowser(aExtensionBrowser) {
+  MOZ_DIAGNOSTIC_ASSERT(mGlobal);
+  MOZ_DIAGNOSTIC_ASSERT(mExtensionBrowser);
+}
+
+bool ExtensionTabCapture::IsAllowed(JSContext* aCx, JSObject* aGlobal) {
+  auto* worker = dom::GetWorkerPrivateFromContext(aCx);
+  return worker && worker->ExtensionChromeCompatibilityEnabled();
+}
+
+JSObject* ExtensionTabCapture::WrapObject(JSContext* aCx,
+                                          JS::Handle<JSObject*> aGivenProto) {
+  JS::Rooted<JS::Value> value(aCx);
+  ErrorResult rv;
+  auto request = GetProperty(u"TabCaptureState"_ns);
+  request->Run(GetGlobalObject(), aCx, &value, rv);
+  if (rv.MaybeSetPendingException(aCx, "TabCapture.TabCaptureState")) {
+    return nullptr;
+  }
+  if (!value.isObject()) {
+    JS_ReportErrorASCII(aCx, "Invalid TabCapture.TabCaptureState schema value");
+    return nullptr;
+  }
+  JS::Rooted<JSObject*> wrapper(
+      aCx, dom::ExtensionTabCapture_Binding::Wrap(aCx, this, aGivenProto));
+  if (!wrapper || !JS_DefineProperty(aCx, wrapper, "TabCaptureState", value,
+                                     JSPROP_ENUMERATE)) {
+    return nullptr;
+  }
+  return wrapper;
+}
+
+nsIGlobalObject* ExtensionTabCapture::GetParentObject() const {
+  return mGlobal;
+}
+
+NS_IMPL_WEBEXT_EVENTMGR(ExtensionTabCapture, u"onStatusChanged"_ns,
+                        OnStatusChanged)
+
+}  // namespace mozilla::extensions
