+const JSClassOps kChromeRootOps = {
+    nullptr,           ChromeRootDelete, nullptr, ChromeRootEnumerate,
+    ChromeRootResolve, nullptr,          nullptr, nullptr,
+    nullptr,           nullptr};
+const JSClass kChromeRootClass = {"Object", JSCLASS_HAS_RESERVED_SLOTS(1),
+                                  &kChromeRootOps};
+}  // namespace
+
+uint64_t ExtensionBrowser::ChromeNamespaceExposure() {
+  auto* worker = dom::GetCurrentThreadWorkerPrivate();
+  if (!worker || !worker->ExtensionChromeCompatibilityEnabled() ||
+      !worker->GetPrincipal()) {
+    return 0;
+  }
+  if (auto core =
+          BasePrincipal::Cast(worker->GetPrincipal())->AddonPolicyCore()) {
+    nsTArray<nsString> permissions;
+    core->GetPermissionsGrantedSince(mChromeExposureGeneration, permissions);
+    constexpr auto userScriptsMask =
+        uint64_t(1) << size_t(ChromeNamespaceIndex::userScripts);
+    mChromeExposedNamespaces |=
+        ChromeNamespaceMask(permissions) & ~userScriptsMask;
+    permissions.Clear();
+    core->GetPermissions(permissions);
+    return (mChromeExposedNamespaces |
+            (ChromeNamespaceMask(permissions) & userScriptsMask)) &
+           ~mChromeDeletedNamespaces;
+  }
+  return mChromeExposedNamespaces & ~mChromeDeletedNamespaces;
+}
+
+bool ExtensionBrowser::ResolveChromeNamespace(JSContext* aCx,
+                                              JS::Handle<JSObject*> aRoot,
+                                              JS::Handle<jsid> aId,
+                                              bool* aResolved) {
+  *aResolved = false;
+  if (!aId.isString()) return true;
+  const auto visible = ChromeNamespaceExposure();
+#define CHROME_NAMESPACE_RESOLVE(name, accessor, ...)                        \
+  {                                                                          \
+    bool matches;                                                            \
+    if (!JS_StringEqualsAscii(aCx, aId.toString(), #name, &matches))         \
+      return false;                                                          \
+    if (matches) {                                                           \
+      constexpr size_t index = size_t(ChromeNamespaceIndex::name);           \
+      if (!(visible & (uint64_t(1) << index))) return true;                  \
+      RefPtr api = GetExtension##accessor();                                 \
+      JS::Rooted<JS::Value> value(aCx);                                      \
+      if (!dom::GetOrCreateDOMReflector(aCx, api.get(), &value) ||           \
+          !JS_DefinePropertyById(aCx, aRoot, aId, value, JSPROP_ENUMERATE))  \
+        return false;                                                        \
+      JS::Rooted<JSObject*> reflector(aCx, &value.toObject());               \
+      if (!ExtensionAPIBase::OwnChromeMethods(aCx, reflector)) return false; \
+      mChromeExposedNamespaces |= uint64_t(1) << index;                      \
+      *aResolved = true;                                                     \
+      return true;                                                           \
+    }                                                                        \
+  }
+  CHROME_WORKER_NAMESPACES(CHROME_NAMESPACE_RESOLVE)
+#undef CHROME_NAMESPACE_RESOLVE
+  return true;
+}
+
+bool ExtensionBrowser::EnumerateChromeNamespaces(
+    JSContext* aCx, JS::Handle<JSObject*> aRoot,
+    JS::MutableHandleIdVector aProperties) {
+  const auto visible = ChromeNamespaceExposure();
+  for (size_t i = 0; i < kChromeNamespaceCount; ++i) {
+    if (!(visible & (uint64_t(1) << i))) continue;
+    JS::Rooted<JSString*> name(
+        aCx, JS_NewStringCopyZ(aCx, kChromeNamespaces[i].name));
+    if (!name) return false;
+    JS::Rooted<jsid> id(aCx);
+    if (!JS_StringToId(aCx, name, &id)) return false;
+    bool exists;
+    if (!JS_AlreadyHasOwnPropertyById(aCx, aRoot, id, &exists)) return false;
+    // Report lazy, enumerable names without resolving their genuine SDK
+    // objects. Chrome snapshots member permissions when the namespace is first
+    // read; Object.keys/Reflect.ownKeys must not take that snapshot. Real own
+    // properties are enumerated by SpiderMonkey with their actual descriptors.
+    if (!exists && !aProperties.append(id)) return false;
+  }
+  return true;
+}
+
+void ExtensionBrowser::DeleteChromeNamespace(JS::Handle<jsid> aId) {
+  if (!aId.isString()) return;
+  JSLinearString* name = JS_ASSERT_STRING_IS_LINEAR(aId.toString());
+  for (size_t i = 0; i < kChromeNamespaceCount; ++i) {
+    if (JS_LinearStringEqualsAscii(name, kChromeNamespaces[i].name)) {
+      mChromeDeletedNamespaces |= uint64_t(1) << i;
+      return;
+    }
+  }
+}
+
+void ExtensionBrowser::GetAPIObject(JSContext* aCx,
+                                    JS::MutableHandle<JS::Value> aResult,
+                                    ErrorResult& aRv) {
+  auto* worker = dom::GetWorkerPrivateFromContext(aCx);
+  if (!worker->ExtensionChromeCompatibilityEnabled()) {
+    if (!dom::GetOrCreateDOMReflector(aCx, this, aResult)) {
+      aRv.StealExceptionFromJSContext(aCx);
+    }
+    return;
+  }
+  if (!mChromeAPIObject) {
+    JS::Rooted<JS::Value> helper(aCx);
+    if (!dom::GetOrCreateDOMReflector(aCx, this, &helper)) {
+      aRv.StealExceptionFromJSContext(aCx);
+      return;
+    }
+    JS::Rooted<JSObject*> object(aCx, JS_NewObject(aCx, &kChromeRootClass));
+    if (!object) {
+      aRv.StealExceptionFromJSContext(aCx);
+      return;
+    }
+    JS::SetReservedSlot(object, 0, helper);
+    if (!mHoldsChromeJSObjects) {
+      mozilla::HoldJSObjects(this);
+      mHoldsChromeJSObjects = true;
+    }
+    mChromeAPIObject = object;
+  }
+  aResult.setObject(*mChromeAPIObject);
+}
+#undef CHROME_WORKER_NAMESPACES
