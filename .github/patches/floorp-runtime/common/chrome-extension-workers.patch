+                                      mExtensionBrowser)
+
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(ExtensionPower)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+ExtensionPower::ExtensionPower(nsIGlobalObject* aGlobal,
+                               ExtensionBrowser* aExtensionBrowser)
+    : mGlobal(aGlobal), mExtensionBrowser(aExtensionBrowser) {
+  MOZ_DIAGNOSTIC_ASSERT(mGlobal);
+  MOZ_DIAGNOSTIC_ASSERT(mExtensionBrowser);
+}
+
+bool ExtensionPower::IsAllowed(JSContext* aCx, JSObject* aGlobal) {
+  auto* worker = dom::GetWorkerPrivateFromContext(aCx);
+  return worker && worker->ExtensionChromeCompatibilityEnabled();
+}
+
+JSObject* ExtensionPower::WrapObject(JSContext* aCx,
+                                     JS::Handle<JSObject*> aGivenProto) {
+  JS::Rooted<JS::Value> value(aCx);
+  ErrorResult rv;
+  auto request = GetProperty(u"Level"_ns);
+  request->Run(GetGlobalObject(), aCx, &value, rv);
+  if (rv.MaybeSetPendingException(aCx, "Power.Level")) {
+    return nullptr;
+  }
+  if (!value.isObject()) {
+    JS_ReportErrorASCII(aCx, "Invalid Power.Level schema value");
+    return nullptr;
+  }
+  JS::Rooted<JSObject*> wrapper(
+      aCx, dom::ExtensionPower_Binding::Wrap(aCx, this, aGivenProto));
+  if (!wrapper ||
+      !JS_DefineProperty(aCx, wrapper, "Level", value, JSPROP_ENUMERATE)) {
+    return nullptr;
+  }
+  return wrapper;
+}
+
+nsIGlobalObject* ExtensionPower::GetParentObject() const { return mGlobal; }
+
+}  // namespace mozilla::extensions
