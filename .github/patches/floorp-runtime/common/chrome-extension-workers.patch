diff --git a/toolkit/components/extensions/webidl-api/ExtensionDeclarativeContent.cpp b/toolkit/components/extensions/webidl-api/ExtensionDeclarativeContent.cpp
new file mode 100644
index 0000000..bde69fc
--- /dev/null
+++ b/toolkit/components/extensions/webidl-api/ExtensionDeclarativeContent.cpp
@@ -0,0 +1,157 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "ExtensionDeclarativeContent.h"
+#include <iterator>
+#include "ExtensionAPICallSyncFunction.h"
+#include "jsapi.h"
+#include "jsfriendapi.h"
+#include "js/CallArgs.h"
+#include "js/PropertyAndElement.h"
+#include "js/Realm.h"
+#include "mozilla/dom/ExtensionDeclarativeContentBinding.h"
+#include "mozilla/dom/WorkerPrivate.h"
+#include "mozilla/dom/WorkerScope.h"
+#include "nsIGlobalObject.h"
+#include "ExtensionDeclarativeContentRuleEvent.h"
+
+namespace mozilla::extensions {
+namespace {
+constexpr const char* kFactoryNames[] = {"PageStateMatcher", "ShowAction",
+                                         "ShowPageAction", "SetIcon",
+                                         "RequestContentScript"};
+bool ConstructDeclarativeRecord(JSContext* aCx, unsigned aArgc,
+                                JS::Value* aVp) {
+  JS::CallArgs args = JS::CallArgsFromVp(aArgc, aVp);
+  if (!args.isConstructing()) {
+    JS_ReportErrorASCII(aCx, "declarativeContent factories require new");
+    return false;
+  }
+  const uint32_t kind =
+      js::GetFunctionNativeReserved(&args.callee(), 0).toInt32();
+  MOZ_RELEASE_ASSERT(kind < std::size(kFactoryNames));
+  dom::Sequence<JS::Value> callArgs;
+  dom::SequenceRooter<JS::Value> argsRooter(aCx, &callArgs);
+  if (!callArgs.AppendElements(args.array(), args.length(), fallible)) {
+    JS_ReportOutOfMemory(aCx);
+    return false;
+  }
+  auto* worker = dom::GetCurrentThreadWorkerPrivate();
+  nsAutoString method;
+  method.AssignASCII(kFactoryNames[kind]);
+  auto request = MakeRefPtr<ExtensionAPICallSyncFunction>(
+      u"declarativeContent"_ns, method);
+  JS::Rooted<JS::Value> record(aCx);
+  ErrorResult rv;
+  request->Run(worker->GlobalScope(), aCx, callArgs, &record, rv);
+  if (rv.MaybeSetPendingException(aCx, kFactoryNames[kind])) {
+    return false;
+  }
+  if (!record.isObject()) {
+    JS_ReportErrorASCII(aCx, "Invalid declarativeContent constructor result");
+    return false;
+  }
+  // Structured clone preserves own record fields but drops custom prototypes.
+  // SetIcon deliberately returns a plain record in Chrome.
+  if (kind != 3) {
+    JS::Rooted<JSObject*> target(aCx, &args.newTarget().toObject());
+    JS::Rooted<JS::Value> prototype(aCx);
+    if (!JS_GetProperty(aCx, target, "prototype", &prototype)) return false;
+    JS::Rooted<JSObject*> proto(aCx, prototype.isObject()
+                                         ? &prototype.toObject()
+                                         : JS::GetRealmObjectPrototype(aCx));
+    JS::Rooted<JSObject*> object(aCx, &record.toObject());
+    if (!JS_SetPrototype(aCx, object, proto)) return false;
+  }
+  args.rval().set(record);
+  return true;
+}
+}  // namespace
+
+void ExtensionDeclarativeContent::GetConstructor(
+    JSContext* aCx, uint32_t aKind, JS::MutableHandle<JS::Value> aRetval,
+    ErrorResult& aRv) {
+  JS::Rooted<JSFunction*> function(
+      aCx,
+      js::NewFunctionWithReserved(aCx, ConstructDeclarativeRecord, 1,
+                                  JSFUN_CONSTRUCTOR, kFactoryNames[aKind]));
+  JS::Rooted<JSObject*> prototype(aCx, JS_NewPlainObject(aCx));
+  if (!function || !prototype) {
+    aRv.MightThrowJSException();
+    aRv.StealExceptionFromJSContext(aCx);
+    return;
+  }
+  JS::Rooted<JSObject*> object(aCx, JS_GetFunctionObject(function));
+  js::SetFunctionNativeReserved(object, 0, JS::Int32Value(aKind));
+  JS::Rooted<JS::Value> constructor(aCx, JS::ObjectValue(*object));
+  JS::Rooted<JS::Value> prototypeValue(aCx, JS::ObjectValue(*prototype));
+  JS::Rooted<JSObject*> wrapper(aCx, GetWrapper());
+  if (!JS_DefineProperty(aCx, prototype, "constructor", constructor, 0) ||
+      !JS_DefineProperty(aCx, object, "prototype", prototypeValue,
+                         JSPROP_PERMANENT) ||
+      !JS_DefineProperty(aCx, wrapper, kFactoryNames[aKind], constructor,
+                         JSPROP_ENUMERATE)) {
+    aRv.MightThrowJSException();
+    aRv.StealExceptionFromJSContext(aCx);
+    return;
+  }
+  aRetval.set(constructor);
+}
+
+ExtensionDeclarativeContentRuleEvent*
+ExtensionDeclarativeContent::OnPageChanged() {
+  if (!mRuleEvent) {
+    mRuleEvent =
+        new ExtensionDeclarativeContentRuleEvent(mGlobal, mExtensionBrowser);
+  }
+  return mRuleEvent;
+}
+
+NS_IMPL_CYCLE_COLLECTING_ADDREF(ExtensionDeclarativeContent)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(ExtensionDeclarativeContent)
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(ExtensionDeclarativeContent, mGlobal,
+                                      mExtensionBrowser, mRuleEvent)
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(ExtensionDeclarativeContent)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+ExtensionDeclarativeContent::ExtensionDeclarativeContent(
+    nsIGlobalObject* aGlobal, ExtensionBrowser* aBrowser)
+    : mGlobal(aGlobal), mExtensionBrowser(aBrowser) {}
+bool ExtensionDeclarativeContent::IsAllowed(JSContext* aCx, JSObject* aGlobal) {
+  auto* worker = dom::GetWorkerPrivateFromContext(aCx);
+  return worker && worker->ExtensionChromeCompatibilityEnabled();
+}
+JSObject* ExtensionDeclarativeContent::WrapObject(
+    JSContext* aCx, JS::Handle<JSObject*> aGivenProto) {
+  return dom::ExtensionDeclarativeContent_Binding::Wrap(aCx, this, aGivenProto);
+}
+nsIGlobalObject* ExtensionDeclarativeContent::GetParentObject() const {
+  return mGlobal;
+}
+void ExtensionDeclarativeContent::GetPageStateMatcher(
+    JSContext* aCx, JS::MutableHandle<JS::Value> aRetval, ErrorResult& aRv) {
+  GetConstructor(aCx, 0, aRetval, aRv);
+}
+
+void ExtensionDeclarativeContent::GetShowAction(
+    JSContext* aCx, JS::MutableHandle<JS::Value> aRetval, ErrorResult& aRv) {
+  GetConstructor(aCx, 1, aRetval, aRv);
+}
+
+void ExtensionDeclarativeContent::GetShowPageAction(
+    JSContext* aCx, JS::MutableHandle<JS::Value> aRetval, ErrorResult& aRv) {
+  GetConstructor(aCx, 2, aRetval, aRv);
+}
+
+void ExtensionDeclarativeContent::GetSetIcon(
+    JSContext* aCx, JS::MutableHandle<JS::Value> aRetval, ErrorResult& aRv) {
+  GetConstructor(aCx, 3, aRetval, aRv);
+}
+
+void ExtensionDeclarativeContent::GetRequestContentScript(
+    JSContext* aCx, JS::MutableHandle<JS::Value> aRetval, ErrorResult& aRv) {
+  GetConstructor(aCx, 4, aRetval, aRv);
+}
+}  // namespace mozilla::extensions
