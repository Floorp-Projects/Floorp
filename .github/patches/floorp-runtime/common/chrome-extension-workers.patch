+                      JS::Handle<jsid> aId, JS::ObjectOpResult& aResult) {
+  bool exists;
+  if (!JS_AlreadyHasOwnPropertyById(aCx, aRoot, aId, &exists)) return false;
+  if (exists) ChromeRootOwner(aRoot)->DeleteChromeNamespace(aId);
+  return aResult.succeed();
+}
