+                                "name": "register",
+                                "type": "function",
+                                "max_manifest_version": 2,
+                                "async": True,
+                                "parameters": [{"name": "options", "type": "object"}],
+                            },
+                            {
+                                "name": "register",
+                                "type": "function",
+                                "min_manifest_version": 3,
+                                "async": True,
+                                "parameters": [
+                                    {
+                                        "name": "scripts",
+                                        "type": "array",
+                                        "items": {"type": "object"},
+                                    }
+                                ],
+                            },
+                        ],
+                    }
+                ]
+            ),
+        }
+    )
+    schemas = Schemas()
+    schemas.load_schemas(schema_dir, "toolkit")
+    schemas.parse_schemas()
+    register = schemas.get_namespace("userScripts").functions["register"]
+    assert register.get_schema_data()["parameters"][0]["name"] == "scripts"
+    generated = WebIDLHelpers.to_webidl_definition(register, None)
+    assert 'WebExtensionStub="Async"' in generated
+    assert "any register(any scripts, optional Function callback);" in generated
+
+
+def test_worker_namespaces_generate_valid_webidl():
+    sys.path.insert(0, os.path.join(buildconfig.topsrcdir, "dom", "bindings", "parser"))
+    import WebIDL
+
+    schemas = load_and_parse_JSONSchema()
+    parser = WebIDL.Parser()
+    parser.parse(
+        "[Global=ServiceWorker, Exposed=ServiceWorker] interface ServiceWorkerGlobalScope {};\n"
+        "callback Function = any(any... arguments);\n"
+        "[Exposed=ServiceWorker] interface ExtensionEventManager {};\n"
+        "[Exposed=ServiceWorker] interface ExtensionPort {};\n"
+        "[Exposed=ServiceWorker] interface ExtensionStorageArea {};\n"
+        "[Exposed=ServiceWorker] interface ExtensionSetting {};\n"
+        "[Exposed=ServiceWorker] interface ExtensionDeclarativeContentRuleEvent {};\n",
+        "worker-global.webidl",
+    )
+    namespaces = [
+        'action',
+        'debugger',
+        'declarativeNetRequest',
+        'offscreen',
+        'runtime',
+        'sidePanel',
+        'storage',
+        'tabs',
+        'userScripts',
+        'identity',
+        'notifications',
+        'tabGroups',
+        'permissions',
+        'cookies',
+        'webRequest',
+        'management',
+        'privacy',
+        'privacy.network',
+        'privacy.services',
+        'privacy.websites',
+        'menus',
+        'downloads',
+        'webNavigation',
+        'tabCapture',
+        'desktopCapture',
+        'fontSettings',
+        'tts',
+        'declarativeContent',
+        'windows',
+        'extension',
+        'power',
+        'omnibox',
+        'bookmarks',
+        'commands',
+        'history',
+        'i18n',
+        'idle',
+        'sessions',
+        'topSites',
+    ]
+    for name in namespaces:
+        generated = WebIDLHelpers.to_webidl_definition(
+            schemas.get_namespace(name), None
+        )
+        assert "NotImplemented" not in generated
+        preprocessor = Preprocessor()
+        preprocessor.out = io.StringIO()
+        stream = io.StringIO(generated)
+        stream.name = name + ".webidl"
+        preprocessor.do_include(stream)
+        parser.parse(preprocessor.out.getvalue(), name + ".webidl")
+    definitions = parser.finish()
+    assert len(definitions) >= len(namespaces)
+
+
+
+def test_member_permissions_preserve_chrome_visibility(write_jsonschema_fixtures):
+    schemas_data = [
+        {
+            "namespace": "management",
+            "functions": [
+                {"name": "getSelf", "type": "function", "async": True, "parameters": []},
+                {"name": "getAll", "type": "function", "async": True,
+                 "permissions": ["management"], "parameters": []},
+            ],
+            "events": [
+                {"name": "onInstalled", "type": "function",
+                 "permissions": ["management"], "parameters": []},
+            ],
+        },
+        {
+            "namespace": "runtime",
+            "functions": [
+                {"name": "sendNativeMessage", "type": "function", "async": True,
+                 "permissions": ["nativeMessaging"], "parameters": []},
+            ],
+        },
+        {
+            "namespace": "tabs",
+            "functions": [
+                {"name": "captureVisibleTab", "type": "function", "async": True,
+                 "permissions": ["<all_urls>", "activeTab"], "parameters": []},
+            ],
+        },
+        {
+            "namespace": "declarativeNetRequest",
+            "functions": [
+                {"name": "testMatchOutcome", "type": "function", "async": True,
+                 "permissions": ["declarativeNetRequestFeedback"], "parameters": []},
+                {"name": "getMatchedRules", "type": "function", "async": True,
+                 "permissions": ["declarativeNetRequestFeedback", "activeTab"], "parameters": []},
+            ],
+            "events": [
+                {"name": "onRuleMatchedDebug", "type": "function",
+                 "permissions": ["declarativeNetRequestFeedback"], "parameters": []},
+            ],
+        },
+        {
+            "namespace": "downloads",
+            "functions": [
+                {"name": "open", "type": "function", "async": True,
+                 "permissions": ["downloads.open"], "parameters": []},
+            ],
+        },
+    ]
+    schema_dir = write_jsonschema_fixtures({"snapshot.json": json.dumps(schemas_data)})
+    schemas = Schemas()
+    schemas.load_schemas(schema_dir, "toolkit")
+    schemas.parse_schemas()
+    helpers = WebIDLHelpers
+    management = schemas.get_namespace("management")
+    assert helpers.member_permission_attribute(management.functions["getSelf"]) is None
+    assert "HasManagementPermission" in helpers.to_webidl_definition(management.functions["getAll"], None)
+    assert "HasManagementPermission" in helpers.to_webidl_definition(management.events["onInstalled"], None)
+    native_message = schemas.get_namespace("runtime").functions["sendNativeMessage"]
+    assert "HasNativeMessagingPermission" in helpers.to_webidl_definition(native_message, None)
+    for namespace, method in [
+        ("tabs", "captureVisibleTab"), ("downloads", "open"),
+        ("declarativeNetRequest", "testMatchOutcome"), ("declarativeNetRequest", "getMatchedRules"),
+    ]:
+        assert helpers.member_permission_attribute(schemas.get_namespace(namespace).functions[method]) is None
+    debug_event = schemas.get_namespace("declarativeNetRequest").events["onRuleMatchedDebug"]
+    assert "HasDNRFeedbackPermission" in helpers.to_webidl_definition(debug_event, None)
+
+
+if __name__ == "__main__":
+    mozunit.main()
