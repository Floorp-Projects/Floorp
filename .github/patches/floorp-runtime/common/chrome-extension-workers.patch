+bool ExtensionAPIBase::HasAnyChromePermission(
+    JSContext* aCx, std::initializer_list<const char16_t*> aPermissions) {
+  auto* worker = dom::GetWorkerPrivateFromContext(aCx);
+  if (!worker) return false;
+  if (!worker->ExtensionChromeCompatibilityEnabled()) return true;
+  if (!worker->GetPrincipal()) return false;
+  auto core = BasePrincipal::Cast(worker->GetPrincipal())->AddonPolicyCore();
+  if (!core) return false;
+  for (const auto* permission : aPermissions) {
+    RefPtr<nsAtom> atom = NS_Atomize(nsDependentString(permission));
+    if (core->HasPermission(atom)) return true;
+  }
+  return false;
+}
