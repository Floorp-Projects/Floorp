+
+namespace mozilla::extensions {
+namespace {
+void CleanupTtsListener(JSContext* aCx, nsIGlobalObject* aGlobal,
+                        ExtensionEventListener* aListener, uint32_t aSourceId) {
+  if (!aListener) {
+    return;
+  }
+  nsAutoString sourceId;
+  sourceId.AppendInt(aSourceId);
+  auto request = MakeRefPtr<ExtensionAPIAddRemoveListener>(
+      ExtensionAPIAddRemoveListener::EType::eRemoveListener, u"tts"_ns,
+      u"onEvent"_ns, VoidString(), sourceId);
+  IgnoredErrorResult rv;
+  request->Run(aGlobal, aCx, {}, aListener, rv);
+  aListener->Cleanup();
+}
+
+class TtsListenerCleanupHandler final : public dom::PromiseNativeHandler {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+  TtsListenerCleanupHandler(nsIGlobalObject* aGlobal,
+                            ExtensionEventListener* aListener,
+                            uint32_t aSourceId)
+      : mGlobal(aGlobal), mListener(aListener), mSourceId(aSourceId) {}
+  void ResolvedCallback(JSContext*, JS::Handle<JS::Value>,
+                        ErrorResult&) override {}
+  void RejectedCallback(JSContext* aCx, JS::Handle<JS::Value>,
+                        ErrorResult&) override {
+    CleanupTtsListener(aCx, mGlobal, mListener, mSourceId);
+  }
+
+ private:
+  ~TtsListenerCleanupHandler() = default;
+  nsCOMPtr<nsIGlobalObject> mGlobal;
+  RefPtr<ExtensionEventListener> mListener;
+  uint32_t mSourceId;
+};
+NS_IMPL_ISUPPORTS0(TtsListenerCleanupHandler)
+}  // namespace
+
+void ExtensionTts::CallWebExtMethodSpeak(JSContext* aCx,
+                                         const nsAString& aApiMethod,
+                                         const dom::Sequence<JS::Value>& aArgs,
+                                         JS::MutableHandle<JS::Value> aRetval,
+                                         ErrorResult& aRv) {
+  RefPtr<dom::Function> completionCallback;
+  size_t length = aArgs.Length();
+  auto makeFunction = [&](JSObject* aObject) -> RefPtr<dom::Function> {
+    JS::Rooted<JSObject*> object(aCx, aObject);
+    JS::Rooted<JSObject*> global(aCx, JS::CurrentGlobalOrNull(aCx));
+    return new dom::Function(aCx, object, global, dom::GetIncumbentGlobal());
+  };
+  if (length && aArgs[length - 1].isObject() &&
+      JS::IsCallable(&aArgs[length - 1].toObject())) {
+    completionCallback = makeFunction(&aArgs[--length].toObject());
+  }
+  if (length < 1 || length > 2) {
+    aRv.ThrowTypeError("tts.speak requires text and optional options");
+    return;
+  }
+  JS::Rooted<JSObject*> options(aCx, JS_NewPlainObject(aCx));
+  if (!options ||
+      (length == 2 && !aArgs[1].isNullOrUndefined() &&
+       (!aArgs[1].isObject() ||
+        !JS_AssignObject(aCx, options,
+                         JS::Rooted<JSObject*>(aCx, &aArgs[1].toObject()))))) {
+    aRv.MightThrowJSException();
+    if (JS_IsExceptionPending(aCx))
+      aRv.StealExceptionFromJSContext(aCx);
+    else
+      aRv.ThrowTypeError("tts.speak options must be an object");
+    return;
+  }
+  JS::Rooted<JS::Value> onEvent(aCx);
+  if (!JS_GetProperty(aCx, options, "onEvent", &onEvent)) {
+    aRv.MightThrowJSException();
+    aRv.StealExceptionFromJSContext(aCx);
+    return;
+  }
+  if (!onEvent.isUndefined() &&
+      (!onEvent.isObject() || !JS::IsCallable(&onEvent.toObject()))) {
+    aRv.ThrowTypeError("tts.speak options.onEvent must be a function");
+    return;
+  }
+  if (!JS_DefineProperty(aCx, options, "onEvent", JS::UndefinedHandleValue,
+                         JSPROP_ENUMERATE)) {
+    aRv.MightThrowJSException();
+    aRv.StealExceptionFromJSContext(aCx);
+    return;
+  }
+  mNextSourceId = mNextSourceId == INT32_MAX ? 1 : mNextSourceId + 1;
+  RefPtr<ExtensionEventListener> eventListener;
+  if (onEvent.isObject()) {
+    RefPtr<dom::Function> callback = makeFunction(&onEvent.toObject());
+    eventListener = ExtensionEventListener::Create(
+        mGlobal, mExtensionBrowser, callback, []() {}, aRv);
+    if (aRv.Failed()) return;
+    nsAutoString sourceId;
+    sourceId.AppendInt(mNextSourceId);
+    auto request = MakeRefPtr<ExtensionAPIAddRemoveListener>(
+        ExtensionAPIAddRemoveListener::EType::eAddListener, u"tts"_ns,
+        u"onEvent"_ns, VoidString(), sourceId);
+    request->Run(mGlobal, aCx, {}, eventListener, aRv);
+    if (aRv.Failed()) {
+      CleanupTtsListener(aCx, mGlobal, eventListener, mNextSourceId);
+      return;
+    }
+  }
+  dom::Sequence<JS::Value> args;
+  dom::SequenceRooter<JS::Value> argsRooter(aCx, &args);
+  if (!args.AppendElement(aArgs[0], fallible) ||
+      !args.AppendElement(JS::ObjectValue(*options), fallible) ||
+      !args.AppendElement(JS::Int32Value(mNextSourceId), fallible)) {
+    if (eventListener)
+      CleanupTtsListener(aCx, mGlobal, eventListener, mNextSourceId);
+    aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return;
+  }
+  RefPtr<dom::Promise> promise = dom::Promise::Create(mGlobal, aRv);
+  if (aRv.Failed()) {
+    if (eventListener)
+      CleanupTtsListener(aCx, mGlobal, eventListener, mNextSourceId);
+    return;
+  }
+  auto request = CallAsyncFunction(aApiMethod);
+  request->Run(mGlobal, aCx, args, promise, aRv);
+  if (aRv.Failed()) {
+    if (eventListener)
+      CleanupTtsListener(aCx, mGlobal, eventListener, mNextSourceId);
+    return;
+  }
+  if (eventListener) {
+    promise->AppendNativeHandler(
+        new TtsListenerCleanupHandler(mGlobal, eventListener, mNextSourceId));
+  }
+  if (completionCallback) {
+    ChromeCompatCallbackHandler::Create(
+        mExtensionBrowser, promise, completionCallback,
+        ChromeCompatCallbackHandler::ResultMode::NoArguments);
+  } else if (!dom::ToJSValue(aCx, promise, aRetval)) {
+    aRv.MightThrowJSException();
+    aRv.StealExceptionFromJSContext(aCx);
+  }
+}
+
+NS_IMPL_CYCLE_COLLECTING_ADDREF(ExtensionTts)
+NS_IMPL_CYCLE_COLLECTING_RELEASE(ExtensionTts)
+NS_IMPL_CYCLE_COLLECTION_WRAPPERCACHE(ExtensionTts, mGlobal, mExtensionBrowser,
+                                      mOnEventEventMgr,
+                                      mOnVoicesChangedEventMgr)
+
+NS_INTERFACE_MAP_BEGIN_CYCLE_COLLECTION(ExtensionTts)
+  NS_WRAPPERCACHE_INTERFACE_MAP_ENTRY
+  NS_INTERFACE_MAP_ENTRY(nsISupports)
+NS_INTERFACE_MAP_END
+
+ExtensionTts::ExtensionTts(nsIGlobalObject* aGlobal,
+                           ExtensionBrowser* aExtensionBrowser)
+    : mGlobal(aGlobal), mExtensionBrowser(aExtensionBrowser) {
+  MOZ_DIAGNOSTIC_ASSERT(mGlobal);
+  MOZ_DIAGNOSTIC_ASSERT(mExtensionBrowser);
+}
+
+bool ExtensionTts::IsAllowed(JSContext* aCx, JSObject* aGlobal) {
+  auto* worker = dom::GetWorkerPrivateFromContext(aCx);
+  return worker && worker->ExtensionChromeCompatibilityEnabled();
+}
+
+JSObject* ExtensionTts::WrapObject(JSContext* aCx,
+                                   JS::Handle<JSObject*> aGivenProto) {
+  return dom::ExtensionTts_Binding::Wrap(aCx, this, aGivenProto);
+}
+
+nsIGlobalObject* ExtensionTts::GetParentObject() const { return mGlobal; }
+
+NS_IMPL_WEBEXT_EVENTMGR(ExtensionTts, u"onEvent"_ns, OnEvent)
+
+NS_IMPL_WEBEXT_EVENTMGR(ExtensionTts, u"onVoicesChanged"_ns, OnVoicesChanged)
+
+void ExtensionTts::GetEventType(JSContext* aCx,
+                                JS::MutableHandle<JS::Value> aRetval) {
+  GetWebExtPropertyAsJSValue(aCx, u"EventType"_ns, aRetval);
+}
+
+void ExtensionTts::GetVoiceGender(JSContext* aCx,
+                                  JS::MutableHandle<JS::Value> aRetval) {
+  GetWebExtPropertyAsJSValue(aCx, u"VoiceGender"_ns, aRetval);
+}
+
