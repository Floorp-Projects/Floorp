new file mode 100644
index 0000000..26bb31c
--- /dev/null
+++ b/toolkit/components/extensions/chrome-network/ChromeDNRRegex.cpp
@@ -0,0 +1,62 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "ChromeDNRRegex.h"
+#include "nsString.h"
+#include "nsTArray.h"
+namespace mozilla::extensions {
+NS_IMPL_ISUPPORTS(ChromeDNRRegex, mozIChromeDNRRegex)
+NS_IMETHODIMP ChromeDNRRegex::Init(const nsACString& aPattern,
+                                   bool aCaseSensitive, nsACString& aResult) {
+  // Reuse Gecko's already-linked Rust regex engine. Both compilation and DFA
+  // caches have explicit bounds; matching never uses the JS backtracking
+  // engine.
+  if (aPattern.Length() > 1024 * 1024) {
+    aResult.AssignLiteral("memoryLimitExceeded");
+    return NS_OK;
+  }
+  // Rust and RE2 use different program representations. This 4 KiB bound is
+  // intentionally local to this engine, not a claim of RE2 memory equivalence.
+  RustRegexOptions options;
+  options.Unicode(true)
+      .CaseInsensitive(!aCaseSensitive)
+      .SizeLimit(4 * 1024)
+      .DFASizeLimit(16 * 1024);
+  mRegex =
+      RustRegex(std::string_view(aPattern.Data(), aPattern.Length()), options);
+  if (mRegex) {
+    aResult.Truncate();
+    return NS_OK;
+  }
+  // Distinguish syntax from the bounded program size without running a match.
+  options.SizeLimit(16 * 1024 * 1024);
+  RustRegex probe(std::string_view(aPattern.Data(), aPattern.Length()),
+                  options);
+  aResult.Assign(probe ? "memoryLimitExceeded" : "syntaxError");
+  return NS_OK;
+}
+NS_IMETHODIMP ChromeDNRRegex::Test(const nsACString& aInput, bool* aResult) {
+  NS_ENSURE_TRUE(mRegex, NS_ERROR_NOT_INITIALIZED);
+  *aResult = mRegex.IsMatch(std::string_view(aInput.Data(), aInput.Length()));
+  return NS_OK;
+}
+NS_IMETHODIMP ChromeDNRRegex::Exec(const nsACString& aInput,
+                                   nsTArray<nsCString>& aResult) {
+  NS_ENSURE_TRUE(mRegex, NS_ERROR_NOT_INITIALIZED);
+  aResult.Clear();
+  auto captures =
+      mRegex.FindCaptures(std::string_view(aInput.Data(), aInput.Length()));
+  if (!captures) {
+    return NS_OK;
+  }
+  for (size_t index = 0; index < captures.Length(); ++index) {
+    auto match = captures[index];
+    nsCString value;
+    if (match) {
+      value.Assign(Substring(aInput, match->start, match->end - match->start));
+    }
+    aResult.AppendElement(std::move(value));
+  }
+  return NS_OK;
+}
+}  // namespace mozilla::extensions
