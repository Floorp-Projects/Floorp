+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "nsISupports.idl"
+
+/** Bounded, linear-time regex matching for converted Chrome DNR rules. */
+[scriptable, builtinclass, uuid(235f6f17-de83-4ab6-a699-d3669c0343bd)]
+interface mozIChromeDNRRegex : nsISupports
+{
+  /** Empty string on success; syntaxError or memoryLimitExceeded on failure. */
+  ACString init(in AUTF8String pattern, in boolean caseSensitive);
+  boolean test(in AUTF8String input);
+  /** Empty array for no match; full match followed by capturing groups. */
+  Array<ACString> exec(in AUTF8String input);
+};
diff --git a/toolkit/components/extensions/chrome-network/test/test_chrome_dnr_regex.js b/toolkit/components/extensions/chrome-network/test/test_chrome_dnr_regex.js
new file mode 100644
index 0000000..994928e
--- /dev/null
+++ b/toolkit/components/extensions/chrome-network/test/test_chrome_dnr_regex.js
@@ -0,0 +1,26 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+"use strict";
+function engine(pattern, caseSensitive = true) {
+  const regex = Cc["@floorp.app/extensions/chrome-dnr-regex;1"].createInstance(Ci.mozIChromeDNRRegex);
+  Assert.equal(regex.init(pattern, caseSensitive), "", `Compiles ${pattern}`);
+  return regex;
+}
+add_task(function test_native_linear_regex_and_captures() {
+  const regex = engine("^https?://([^/]+)/capture-([0-9]+)$");
+  Assert.ok(regex.test("https://example.test/capture-42"));
+  Assert.deepEqual(regex.exec("https://example.test/capture-42"), ["https://example.test/capture-42", "example.test", "42"]);
+  Assert.deepEqual(regex.exec("https://example.test/other"), []);
+  Assert.ok(engine("HELLO", false).test("http://example.test/hello"));
+  Assert.ok(!engine("HELLO", true).test("http://example.test/hello"));
+  const linear = engine("(a+)+$");
+  const start = Cu.now();
+  Assert.ok(!linear.test("a".repeat(100000) + "!"));
+  Assert.ok(Cu.now() - start < 2000, "Nested quantifiers use bounded linear native matching");
+});
+add_task(function test_native_compile_failure_reasons() {
+  const regex = Cc["@floorp.app/extensions/chrome-dnr-regex;1"].createInstance(Ci.mozIChromeDNRRegex);
+  Assert.equal(regex.init("a(?=b)", true), "syntaxError");
+  Assert.equal(regex.init("(a)\\1", true), "syntaxError");
+  Assert.equal(regex.init("a".repeat(2000), true), "memoryLimitExceeded");
+});
