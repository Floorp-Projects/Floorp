diff --git a/widget/tests/gtest/TestMacWebAppPanGesture.mm b/widget/tests/gtest/TestMacWebAppPanGesture.mm
new file mode 100644
index 00000000000..3a1c513f17b
--- /dev/null
+++ b/widget/tests/gtest/TestMacWebAppPanGesture.mm
@@ -0,0 +1,78 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "gtest/gtest.h"
+#include "nsCocoaUtils.h"
+
+using namespace mozilla;
+
+TEST(MacWebAppPanGesture, TransportedPhases)
+{
+  using Type = PanGestureInput::PanGestureType;
+  struct Case {
+    NSEventPhase phase;
+    NSEventPhase momentum;
+    Type type;
+    bool zeroDelta;
+  };
+  const Case cases[] = {
+      {NSEventPhaseMayBegin, NSEventPhaseNone,
+       PanGestureInput::PANGESTURE_MAYSTART, true},
+      {NSEventPhaseCancelled, NSEventPhaseNone,
+       PanGestureInput::PANGESTURE_CANCELLED, true},
+      {NSEventPhaseBegan, NSEventPhaseNone, PanGestureInput::PANGESTURE_START,
+       false},
+      {NSEventPhaseChanged, NSEventPhaseNone, PanGestureInput::PANGESTURE_PAN,
+       false},
+      {NSEventPhaseEnded, NSEventPhaseNone, PanGestureInput::PANGESTURE_END,
+       false},
+      {NSEventPhaseNone, NSEventPhaseBegan,
+       PanGestureInput::PANGESTURE_MOMENTUMSTART, false},
+      {NSEventPhaseNone, NSEventPhaseChanged,
+       PanGestureInput::PANGESTURE_MOMENTUMPAN, false},
+      {NSEventPhaseNone, NSEventPhaseEnded,
+       PanGestureInput::PANGESTURE_MOMENTUMEND, false},
+  };
+  const TimeStamp time = TimeStamp::Now();
+  const ScreenPoint position(12, 18);
+  const ScreenPoint displacement(-64, 6);
+  for (const auto& test : cases) {
+    PanGestureInput pan = nsCocoaUtils::CreatePanGestureEvent(
+        test.phase, test.momentum, true, time, position, displacement,
+        gfx::IntPoint(-2, 1), MODIFIER_SHIFT);
+    EXPECT_EQ(pan.mType, test.type);
+    EXPECT_EQ(pan.mTimeStamp, time);
+    EXPECT_EQ(pan.mPanStartPoint, position);
+    EXPECT_EQ(pan.mPanDisplacement,
+              test.zeroDelta ? ScreenPoint() : displacement);
+    EXPECT_EQ(pan.modifiers, MODIFIER_SHIFT);
+    EXPECT_EQ(pan.mLineOrPageDeltaX, test.zeroDelta ? 0 : -2);
+    EXPECT_EQ(pan.mLineOrPageDeltaY, test.zeroDelta ? 0 : 1);
+    pan.SetHandledByAPZ(true);
+    pan.SetOverscrollBehaviorAllowsSwipe(true);
+    EXPECT_EQ(pan.AllowsSwipe(), test.phase == NSEventPhaseBegan);
+  }
+}
+
+TEST(MacWebAppPanGesture, DisabledHistorySwipe)
+{
+  PanGestureInput pan = nsCocoaUtils::CreatePanGestureEvent(
+      NSEventPhaseBegan, NSEventPhaseNone, false, TimeStamp::Now(),
+      ScreenPoint(12, 18), ScreenPoint(-64, 6), gfx::IntPoint(), 0);
+  pan.SetHandledByAPZ(true);
+  pan.SetOverscrollBehaviorAllowsSwipe(true);
+  EXPECT_FALSE(pan.AllowsSwipe());
+  EXPECT_EQ(pan.mPanDisplacement, ScreenPoint(-64, 6));
+}
+
+TEST(MacWebAppPanGesture, VerticalPanDoesNotStartHistorySwipe)
+{
+  PanGestureInput pan = nsCocoaUtils::CreatePanGestureEvent(
+      NSEventPhaseBegan, NSEventPhaseNone, true, TimeStamp::Now(),
+      ScreenPoint(12, 18), ScreenPoint(-19, 6), gfx::IntPoint(), 0);
+  pan.SetHandledByAPZ(true);
+  pan.SetOverscrollBehaviorAllowsSwipe(true);
+  EXPECT_FALSE(pan.AllowsSwipe());
+  EXPECT_EQ(pan.mPanDisplacement, ScreenPoint(-19, 6));
+}
