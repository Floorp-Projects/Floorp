+  return { sansserif: "sans-serif", fixed: "monospace" }[generic] || generic;
+}
+function fontValue(script, generic) {
+  const value = Services.prefs.getStringPref(fontPref(script, generic), "");
+  if (value || script !== "Zyyy") {
+    return value ? FONT_ENUMERATOR.getStandardFamilyName(value) || value : "";
+  }
+  const family = nativeFamily(generic);
+  return Services.prefs.getStringPref(`font.name.${family}.x-western`, "") ||
