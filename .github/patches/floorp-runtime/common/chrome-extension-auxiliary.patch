+this.fontSettings = class extends ExtensionAPIPersistent {
+  PERSISTENT_EVENTS = {
+    onFontChanged: ({ fire }) => this.registerChange(fire, "onFontChanged"),
+    onDefaultFontSizeChanged: ({ fire }) =>
+      this.registerChange(fire, "onDefaultFontSizeChanged"),
+    onDefaultFixedFontSizeChanged: ({ fire }) =>
+      this.registerChange(fire, "onDefaultFixedFontSizeChanged"),
+    onMinimumFontSizeChanged: ({ fire }) =>
+      this.registerChange(fire, "onMinimumFontSizeChanged"),
+  };
+
+  registerChange(fire, event) {
+    let listener = fire;
+    const observer = {
+      observe: (_subject, _topic, pref) => {
+        let details;
+        let name;
+        if (event === "onFontChanged") {
+          const match = /^font\.chrome\.([^.]+)\.([^.]+)$/.exec(pref);
+          if (!match) return;
+          const [, genericFamily, script] = match;
+          name = settingName(script, genericFamily);
+          details = {
+            fontId: fontValue(script, genericFamily),
+            script,
+            genericFamily,
+          };
+        } else {
+          const suffix = event.slice(2, -"Changed".length);
+          const setting = SIZE_SETTINGS[suffix];
+          if (pref !== setting.prefix + "x-western") return;
+          name = `fontSettings.${suffix}`;
+          details = {
+            pixelSize: Services.prefs.getIntPref(pref, setting.fallback),
+          };
+        }
