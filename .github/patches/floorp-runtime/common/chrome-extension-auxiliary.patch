+          .then(async (levelOfControl) => {
+            await listener.wakeup?.();
+            listener.async({ ...details, levelOfControl });
+          }).catch(Cu.reportError);
+      },
+    };
+    const prefix = event === "onFontChanged"
+      ? "font.chrome."
+      : SIZE_SETTINGS[event.slice(2, -"Changed".length)].prefix;
+    Services.prefs.addObserver(prefix, observer);
+    return {
+      unregister: () => Services.prefs.removeObserver(prefix, observer),
+      convert: (newFire) => {
+        listener = newFire;
+      },
+    };
+  }
+
+  getAPI(context) {
+    if (!ExtensionUtils.getChromeExtensionId(this.extension)) {
+      return {};
+    }
+    const id = this.extension.id;
+    const api = {};
+    const assertWritable = async (name) => {
+      if (
+        await ExtensionPreferencesManager.getLevelOfControl(id, name) ===
+          "not_controllable"
+      ) {
+        throw new ExtensionError(
+          "This font preference is locked by browser policy.",
+        );
+      }
+    };
+    api.getFontList = async () =>
+      (await FONT_ENUMERATOR.EnumerateAllFontsAsync())
+        .filter((font) =>
+          !["serif", "sans-serif", "monospace", "math"].includes(font)
+        )
+        .map((font) => ({ fontId: font, displayName: font }));
+    api.getFont = async ({ script = "Zyyy", genericFamily }) => ({
+      fontId: fontValue(script, genericFamily),
+      levelOfControl: await ExtensionPreferencesManager.getLevelOfControl(
+        id,
+        settingName(script, genericFamily),
+      ),
+    });
+    api.setFont = async ({ script = "Zyyy", genericFamily, fontId }) => {
+      if (
+        !Services.prefs.getBoolPref("floorp.chrome.fontSettings.native", false)
+      ) {
+        throw new ExtensionError(
+          "Script font settings require the compiled Floorp font backend.",
+        );
+      }
+      const name = settingName(script, genericFamily);
+      await assertWritable(name);
+      await ExtensionPreferencesManager.setSetting(id, name, fontId);
+    };
+    api.clearFont = async ({ script = "Zyyy", genericFamily }) => {
+      await ExtensionPreferencesManager.removeSetting(
+        id,
+        settingName(script, genericFamily),
+      );
+    };
+    for (
+      const [suffix, { prefix, fallback }] of Object.entries(SIZE_SETTINGS)
+    ) {
+      const name = `fontSettings.${suffix}`;
+      api[`get${suffix}`] = async () => ({
+        pixelSize: Services.prefs.getIntPref(prefix + "x-western", fallback),
+        levelOfControl: await ExtensionPreferencesManager.getLevelOfControl(
+          id,
+          name,
+        ),
+      });
+      api[`set${suffix}`] = async ({ pixelSize }) => {
+        if (pixelSize < 0 || pixelSize > 2147483647) {
+          throw new ExtensionError(
+            "Font size must be between 0 and 2147483647 pixels.",
+          );
+        }
+        await assertWritable(name);
+        await ExtensionPreferencesManager.setSetting(id, name, pixelSize);
+      };
+      api[`clear${suffix}`] = async () =>
+        ExtensionPreferencesManager.removeSetting(id, name);
+    }
+    for (const event of Object.keys(this.PERSISTENT_EVENTS)) {
+      api[event] = new EventManager({
+        context,
+        module: "fontSettings",
+        event,
+        extensionApi: this,
+      }).api();
+    }
+    return { fontSettings: api };
+  }
+};
diff --git a/toolkit/components/extensions/parent/ext-tts.js b/toolkit/components/extensions/parent/ext-tts.js
