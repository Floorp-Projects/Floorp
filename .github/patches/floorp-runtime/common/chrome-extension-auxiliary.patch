+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+this.tts = class extends ExtensionAPI {
+  getAPI(context) {
+    const callbacks = new Map();
+    let nextId = 0;
+    const onEvent = (event) => {
+      const callback = callbacks.get(event.srcId);
+      if (!callback) return;
+      if (event.isFinalEvent) callbacks.delete(event.srcId);
+      const publicEvent = { ...event };
+      delete publicEvent.srcId;
+      delete publicEvent.isFinalEvent;
+      context.runSafe(callback, publicEvent);
+    };
+    context.childManager.getParentEvent("tts.onEvent").addListener(onEvent);
+    context.callOnClose({ close: () => callbacks.clear() });
+    return {
+      tts: {
+        speak(text, options, callback) {
+          const srcId = ++nextId;
+          const cleanOptions = { ...options };
+          if (cleanOptions.onEvent) callbacks.set(srcId, cleanOptions.onEvent);
+          delete cleanOptions.onEvent;
+          const result = context.childManager.callParentAsyncFunction(
+            "tts.speak",
+            [text, cleanOptions, srcId],
+            callback,
+          );
+          result?.catch(() => callbacks.delete(srcId));
+          return result;
+        },
+      },
+    };
+  }
+};
