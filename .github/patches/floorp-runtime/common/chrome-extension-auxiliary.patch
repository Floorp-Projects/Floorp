index 0000000..e1d8a91
--- /dev/null
+++ b/toolkit/components/extensions/parent/ext-tts.js
@@ -0,0 +1,321 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+var { ExtensionError } = ExtensionUtils;
+var { EventManager } = ExtensionCommon;
+const FINAL_EVENTS = new Set(["end", "interrupted", "cancelled", "error"]);
+const TtsEngine = {
+  host: null,
+  pending: [],
+  active: null,
+  paused: false,
+  listeners: new Map(),
+  voiceListeners: new Set(),
+
+  ensureHost() {
+    if (this.host) return;
+    this.host = Services.appShell.createWindowlessBrowser(true);
+    const principal = Services.scriptSecurityManager.getSystemPrincipal();
+    this.host.docShell.createAboutBlankDocumentViewer(principal, principal);
+    this.window = this.host.document.defaultView;
+    this.synth = this.window.speechSynthesis;
+    this.synth.addEventListener("voiceschanged", () => {
+      for (const listener of this.voiceListeners) listener();
+    });
+  },
+
+  async voices() {
+    this.ensureHost();
+    if (!this.synth.getVoices().length) {
+      await new Promise((resolve) => {
+        const done = () => {
+          this.window.clearTimeout(timer);
+          this.synth.removeEventListener("voiceschanged", done);
+          resolve();
+        };
+        const timer = this.window.setTimeout(done, 2000);
+        this.synth.addEventListener("voiceschanged", done);
+      });
+    }
+    return this.synth.getVoices();
+  },
+
+  eventTypes(voice) {
+    const types = ["start", "end", "interrupted", "cancelled", "error"];
+    if (
+      Services.appinfo.OS !== "Linux" ||
+      Services.prefs.getBoolPref("floorp.chrome.tts.native", false)
+    ) {
+      types.push("word", "pause", "resume");
+      if (Services.appinfo.OS === "WINNT" || Services.appinfo.OS === "Linux") {
+        types.push("sentence");
+      }
+    }
+    return types;
+  },
+
+  dispatch(job, type, data = {}) {
+    if (job.finished) return;
+    const isFinalEvent = FINAL_EVENTS.has(type);
+    const event = {
+      type,
+      charIndex: job.charIndex || 0,
+      ...data,
+      srcId: job.srcId,
+      isFinalEvent,
+    };
+    if (isFinalEvent) job.finished = true;
+    if (
+      isFinalEvent || !job.options.desiredEventTypes ||
+      job.options.desiredEventTypes.includes(type)
+    ) {
+      for (const fire of this.listeners.get(job.context) || []) {
+        fire.async(event);
+      }
+    }
+  },
+
+  async speak(context, text, options = {}, srcId = 0) {
+    if (text.length > 32768) {
+      throw new ExtensionError("Utterance exceeds 32768 characters.");
+    }
+    if (options.extensionId) {
+      throw new ExtensionError(
+        "Extension-provided speech engines are not installed.",
+      );
+    }
+    if (options.lang) {
+      try {
+        new Intl.Locale(options.lang);
+      } catch {
+        throw new ExtensionError("Invalid speech language tag.");
+      }
+    }
+    const voices = await this.voices();
+    let voice = options.voiceName
+      ? voices.find((v) => v.name === options.voiceName)
+      : null;
+    if (options.voiceName && !voice) {
+      throw new ExtensionError("Requested speech voice is unavailable.");
+    }
+    if (!voice && options.lang) {
+      voice = voices.find((v) =>
+        v.lang.toLowerCase() === options.lang.toLowerCase()
+      ) ||
+        voices.find((v) =>
+          v.lang.split("-")[0].toLowerCase() ===
+            options.lang.split("-")[0].toLowerCase()
+        );
+    }
+    voice ||= voices.find((v) => v.default) || voices[0];
+    if (!voice) {
+      throw new ExtensionError(
+        "No native speech synthesis voice is available.",
+      );
+    }
+    const supported = this.eventTypes(voice);
+    if (
+      (options.requiredEventTypes || []).some((type) =>
+        !supported.includes(type)
+      )
+    ) {
+      throw new ExtensionError(
+        "No native voice supports all required speech events.",
+      );
+    }
+    if (/^\s*<speak[\s>]/i.test(text)) {
+      const parsed = new this.window.DOMParser().parseFromString(
+        text,
+        "application/xml",
+      );
+      if (
+        parsed.querySelector("parsererror") ||
+        parsed.documentElement.localName !== "speak"
+      ) {
+        throw new ExtensionError("Invalid SSML document.");
+      }
+      text = parsed.documentElement.textContent;
+    }
+    if (!options.enqueue) this.stop();
+    const job = {
+      context,
+      extension: context.extension,
+      srcId,
+      text,
+      options,
+      voice,
+      started: false,
+      finished: false,
+      charIndex: 0,
+    };
+    this.pending.push(job);
+    this.startNext();
+  },
+
+  startNext() {
+    if (this.active || this.paused || !this.pending.length) return;
+    const job = this.active = this.pending.shift();
+    const utterance = job.utterance = new this.window.SpeechSynthesisUtterance(
+      job.text,
+    );
+    utterance.voice = job.voice;
+    for (const key of ["lang", "rate", "pitch", "volume"]) {
+      if (job.options[key] !== undefined) utterance[key] = job.options[key];
+    }
+    utterance.addEventListener("start", () => {
+      job.started = true;
+      this.dispatch(job, "start");
+    });
+    utterance.addEventListener("boundary", (event) => {
+      job.charIndex = event.charIndex;
+      this.dispatch(job, event.name === "sentence" ? "sentence" : "word", {
+        charIndex: event.charIndex,
+        length: event.charLength || -1,
+      });
+    });
+    utterance.addEventListener(
+      "pause",
+      (event) => this.dispatch(job, "pause", { charIndex: event.charIndex }),
+    );
+    utterance.addEventListener(
+      "resume",
+      (event) => this.dispatch(job, "resume", { charIndex: event.charIndex }),
+    );
+    const finish = (type, data) => {
+      if (job.finished) return;
+      this.dispatch(job, type, data);
+      if (this.active === job) this.active = null;
+      this.startNext();
+    };
+    utterance.addEventListener(
+      "end",
+      () => finish("end", { charIndex: job.text.length }),
+    );
+    utterance.addEventListener(
+      "error",
+      (event) => finish("error", { errorMessage: event.error }),
+    );
+    try {
+      this.synth.speak(utterance);
+    } catch (error) {
+      finish("error", { errorMessage: error.message });
+    }
+  },
+
+  stop(extension = null) {
+    this.ensureHost();
+    if (this.active && (!extension || this.active.extension === extension)) {
+      const job = this.active;
+      this.active = null;
+      this.dispatch(job, job.started ? "interrupted" : "cancelled");
+      this.synth.cancel();
+    }
+    this.pending = this.pending.filter((job) => {
+      if (extension && job.extension !== extension) return true;
+      this.dispatch(job, "cancelled");
+      return false;
+    });
+    if (!extension) {
+      this.paused = false;
+      this.synth.resume();
+    }
+    this.startNext();
+  },
+
+  pause() {
+    this.ensureHost();
+    this.assertPauseSupported();
+    this.paused = true;
+    this.synth.pause();
+  },
+  resume() {
+    this.ensureHost();
+    this.assertPauseSupported();
+    this.paused = false;
+    this.synth.resume();
+    this.startNext();
+  },
+  assertPauseSupported() {
+    if (
+      Services.appinfo.OS === "Linux" &&
+      !Services.prefs.getBoolPref("floorp.chrome.tts.native", false)
+    ) {
+      throw new ExtensionError(
+        "Speech pause/resume require the compiled Floorp speech backend.",
+      );
+    }
+  },
+};
+
+this.tts = class extends ExtensionAPIPersistent {
+  PERSISTENT_EVENTS = {
+    onVoicesChanged: ({ fire }) => {
+      let listener = fire;
+      TtsEngine.ensureHost();
+      const notify = async () => {
+        await listener.wakeup?.();
+        listener.async();
+      };
+      TtsEngine.voiceListeners.add(notify);
+      return {
+        unregister: () => TtsEngine.voiceListeners.delete(notify),
+        convert: (newFire) => {
+          listener = newFire;
+        },
+      };
+    },
+  };
+  onShutdown() {
+    TtsEngine.stop(this.extension);
+  }
+  getAPI(context) {
+    if (!ExtensionUtils.getChromeExtensionId(this.extension)) return {};
+    return {
+      tts: {
+        speak: (text, options, srcId) =>
+          TtsEngine.speak(context, text, options || {}, srcId),
+        stop: () => TtsEngine.stop(),
+        pause: () => TtsEngine.pause(),
+        resume: () => TtsEngine.resume(),
+        isSpeaking: async () => {
+          TtsEngine.ensureHost();
+          return !!TtsEngine.active || !!TtsEngine.pending.length ||
+            TtsEngine.synth.speaking;
+        },
+        getVoices: async () =>
+          (await TtsEngine.voices()).map((voice) => ({
+            voiceName: voice.name,
+            lang: voice.lang,
+            remote: !voice.localService,
+            eventTypes: TtsEngine.eventTypes(voice),
+          })),
+        onEvent: new EventManager({
+          context,
+          name: "tts.onEvent",
+          register: (fire) => {
+            let listeners = TtsEngine.listeners.get(context);
+            if (!listeners) {
+              TtsEngine.listeners.set(context, listeners = new Set());
+            }
+            listeners.add(fire);
+            return () => {
+              listeners.delete(fire);
+              if (!listeners.size) {
+                TtsEngine.listeners.delete(context);
+              }
+            };
+          },
+        }).api(),
+        onVoicesChanged: new EventManager({
+          context,
+          module: "tts",
+          event: "onVoicesChanged",
+          extensionApi: this,
+        }).api(),
+      },
+    };
+  }
+};
