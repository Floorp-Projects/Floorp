diff --git a/toolkit/components/extensions/test/xpcshell/test_ext_floorp_offscreen.js b/toolkit/components/extensions/test/xpcshell/test_ext_floorp_offscreen.js
new file mode 100644
--- /dev/null
+++ b/toolkit/components/extensions/test/xpcshell/test_ext_floorp_offscreen.js
@@ -0,0 +1,92 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+add_task(async function test_floorp_offscreen_lifecycle() {
+  const originalId = "abcdefghijklmnopabcdefghijklmnop";
+  const extension = ExtensionTestUtils.loadExtension({
+    manifest: {
+      manifest_version: 3,
+      permissions: ["offscreen", "storage"],
+      browser_specific_settings: {
+        gecko: {
+          id: `${originalId}@chromium-extension`,
+          floorp_chrome_extension: { schema_version: 1, original_id: originalId },
+        },
+      },
+    },
+    background() {
+      browser.test.onMessage.addListener(async command => {
+        try {
+          if (command === "create") {
+            await browser.offscreen.createDocument({
+              url: "offscreen.html", reasons: ["DOM_PARSER"],
+              justification: "Verify independent offscreen lifetime",
+            });
+          } else if (command === "close") {
+            await browser.offscreen.closeDocument();
+          }
+          const contexts = await browser.runtime.getContexts({
+            contextTypes: ["OFFSCREEN_DOCUMENT"],
+          });
+          if (contexts.length) {
+            browser.test.assertEq(1, (await browser.runtime.getContexts({
+              contextIds: [contexts[0].contextId],
+            })).length, "returned contextId is a usable filter");
+          }
+          browser.test.sendMessage("result", {
+            contexts, hasDocument: await browser.offscreen.hasDocument(),
+          });
+        } catch (error) {
+          browser.test.fail(String(error));
+          browser.test.sendMessage("result", { error: String(error) });
+        }
+      });
+      browser.test.sendMessage("background-ready");
+    },
+    files: {
+      "offscreen.html": '<!DOCTYPE html><script src="offscreen.js"></script>',
+      "offscreen.js": function() {
+        browser.test.assertEq(undefined, browser.storage,
+          "offscreen only exposes runtime extension API");
+        browser.test.assertEq(undefined, browser.runtime.getBackgroundPage,
+          "offscreen cannot retrieve a privileged background window");
+        browser.runtime.onMessage.addListener(message => {
+          if (message === "offscreen-ping") {
+            return Promise.resolve("offscreen-pong");
+          }
+        });
+      },
+    },
+  });
+  await extension.startup();
+  await extension.awaitMessage("background-ready");
+  extension.sendMessage("create");
+  let first = await extension.awaitMessage("result");
+  Assert.ok(first.hasDocument, "offscreen exists");
+  Assert.equal(first.contexts.length, 1, "real offscreen context registered");
+  Assert.equal(first.contexts[0].tabId, -1);
+  const documentId = first.contexts[0].documentId;
+
+  await extension.terminateBackground();
+  Assert.equal(extension.extension.backgroundState, "stopped");
+  const page = [...extension.extension.views].find(v => v.viewType === "offscreen");
+  Assert.ok(page && !page.unloaded, "offscreen survives background termination");
+  await extension.wakeupBackground();
+  await extension.awaitMessage("background-ready");
+  extension.sendMessage("query");
+  const restarted = await extension.awaitMessage("result");
+  Assert.equal(restarted.contexts[0].documentId, documentId,
+    "background restart retains the actual offscreen document");
+  extension.sendMessage("close");
+  const closed = await extension.awaitMessage("result");
+  Assert.equal(closed.hasDocument, false);
+  Assert.equal(closed.contexts.length, 0);
+  extension.sendMessage("create");
+  const recreated = await extension.awaitMessage("result");
+  Assert.notEqual(recreated.contexts[0].documentId, documentId,
+    "a replacement document receives a fresh documentId");
+  await extension.unload();
+  Assert.ok(page.unloaded, "unloading extension tears down its host");
+});
