+NS_IMETHODIMP
+PowerManagerService::NewWakeLockForChromeExtension(const nsAString& aTopic,
+                                                   nsIWakeLock** aWakeLock) {
+  if (!aTopic.EqualsLiteral("cpu") && !aTopic.EqualsLiteral("screen")) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  RefPtr<WakeLock> lock = new WakeLock();
+  nsresult rv = lock->Init(aTopic, nullptr, aTopic.EqualsLiteral("screen"));
+  NS_ENSURE_SUCCESS(rv, rv);
+  lock.forget(aWakeLock);
+  return NS_OK;
+}
+
 }  // namespace mozilla::dom::power
