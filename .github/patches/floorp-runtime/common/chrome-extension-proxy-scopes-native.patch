+// A scope owns a separate PAC interpreter and system-resolution context. Cache
+// replacement drops only ownership: an in-flight request retains its old scope.
+class ChromeScopedPAC final {
+ public:
+  NS_INLINE_DECL_REFCOUNTING(ChromeScopedPAC)
+  explicit ChromeScopedPAC(nsProtocolProxyService* aOwner,
+                           nsISerialEventTarget* aTarget)
+      : mOwner(aOwner), mPAC(new nsPACMan(aTarget)) {
+    mOwner->mAllChromePACs.AppendElement(this);
+  }
+  nsresult Init(uint32_t aType, const nsACString& aPACURI) {
+    mPAC->SetProxyConfigTypeOverride(aType);
+    mPAC->SetChromeURLSemantics();
+    nsCOMPtr<nsISystemProxySettings> system;
+    if (aType == nsIProtocolProxyService::PROXYCONFIG_SYSTEM) {
+      system = do_GetService(NS_SYSTEMPROXYSETTINGS_CONTRACTID);
+      if (system) {
+        bool mainOnly = false;
+        system->GetMainThreadOnly(&mainOnly);
+        if (mainOnly) mMainThreadSystem = system;
+      } else {
+        mDirect = true;
+      }
+    }
+    nsresult rv = mPAC->Init(mMainThreadSystem ? nullptr : system.get());
+    NS_ENSURE_SUCCESS(rv, rv);
+    if (aType == nsIProtocolProxyService::PROXYCONFIG_PAC) {
+      return mPAC->LoadPACFromURI(aPACURI);
+    }
+    if (aType == nsIProtocolProxyService::PROXYCONFIG_WPAD) {
+      return mPAC->LoadPACFromURI(EmptyCString());
+    }
+    return NS_OK;
+  }
+  nsresult Resolve(nsIURI* aURI, nsPACManCallback* aCallback, uint32_t aFlags) {
+    if (mDirect) {
+      aCallback->OnQueryComplete(NS_OK, "DIRECT"_ns, EmptyCString());
+      return NS_OK;
+    }
+    if (mMainThreadSystem) {
+      nsAutoCString pacURI;
+      nsresult rv = mMainThreadSystem->GetPACURI(pacURI);
+      NS_ENSURE_SUCCESS(rv, rv);
+      bool wpad = false;
+      mMainThreadSystem->GetSystemWPADSetting(&wpad);
+      if (pacURI.IsEmpty() && !wpad) {
+        nsAutoCString spec, scheme, host, result;
+        int32_t port;
+        MOZ_TRY(aURI->GetAsciiSpec(spec));
+        MOZ_TRY(aURI->GetScheme(scheme));
+        MOZ_TRY(aURI->GetAsciiHost(host));
+        MOZ_TRY(aURI->GetPort(&port));
+        if (!(aFlags & nsIProtocolProxyService::RESOLVE_PREFER_SOCKS_PROXY)) {
+          if (aFlags & nsIProtocolProxyService::RESOLVE_PREFER_HTTPS_PROXY)
+            scheme.AssignLiteral("https");
+          else if (aFlags & nsIProtocolProxyService::RESOLVE_IGNORE_URI_SCHEME)
+            scheme.AssignLiteral("http");
+        }
+        rv =
+            mMainThreadSystem->GetProxyForURI(spec, scheme, host, port, result);
+        if (NS_SUCCEEDED(rv) &&
+            (aFlags & nsIProtocolProxyService::RESOLVE_PREFER_SOCKS_PROXY) &&
+            (aFlags & nsIProtocolProxyService::RESOLVE_PREFER_HTTPS_PROXY) &&
+            StringBeginsWith(result, "direct"_ns,
+                             nsCaseInsensitiveUTF8StringComparator)) {
+          rv = mMainThreadSystem->GetProxyForURI(spec, "https"_ns, host, port,
+                                                 result);
+        }
+        aCallback->OnQueryComplete(rv, result, EmptyCString());
+        return NS_OK;
+      }
+      if (!mSystemPACSet || !mPAC->IsPACURI(pacURI)) {
+        MOZ_TRY(mPAC->LoadPACFromURI(pacURI));
+        mSystemPACSet = true;
+      }
+    }
+    return mPAC->AsyncGetProxyForURI(aURI, aCallback, aFlags, true);
+  }
+  void Shutdown() {
+    mPAC->Shutdown();
+    if (mOwner) {
+      mOwner->ForgetChromePAC(this);
+      mOwner = nullptr;
+    }
+  }
+  bool IsPACURI(nsIURI* aURI) { return mPAC->IsPACURI(aURI); }
+  RefPtr<nsPACMan> mPAC;
+
+ private:
+  ~ChromeScopedPAC() {
+    mPAC->Shutdown();
+    if (mOwner) mOwner->ForgetChromePAC(this);
+  }
+  nsProtocolProxyService* mOwner;
+  nsCOMPtr<nsISystemProxySettings> mMainThreadSystem;
+  bool mDirect{false};
+  bool mSystemPACSet{false};
+};
