new file mode 100644
index 0000000..738cdec
--- /dev/null
+++ b/netwerk/test/unit/test_chrome_proxy_scopes.js
@@ -0,0 +1,165 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+"use strict";
+
+const pps = Cc["@mozilla.org/network/protocol-proxy-service;1"].getService(
+  Ci.nsIProtocolProxyService2
+);
+
+function configuration(key, script, mandatory = false) {
+  return {
+    QueryInterface: ChromeUtils.generateQI(["nsIChromeProxyConfiguration"]),
+    key,
+    type: Ci.nsIProtocolProxyService.PROXYCONFIG_PAC,
+    PACURI:
+      "data:application/x-ns-proxy-autoconfig," + encodeURIComponent(script),
+    mandatory,
+    allowLoopback: false,
+  };
+}
+
+function channel(
+  privateBrowsingId = 0,
+  uri = "http://floorp-scopes.invalid/route"
+) {
+  const principal = Services.scriptSecurityManager.createContentPrincipal(
+    Services.io.newURI("http://floorp-scopes.invalid/"),
+    { privateBrowsingId }
+  );
+  return NetUtil.newChannel({
+    uri,
+    loadingPrincipal: principal,
+    securityFlags: Ci.nsILoadInfo.SEC_ALLOW_CROSS_ORIGIN_SEC_CONTEXT_IS_NULL,
+    contentPolicyType: Ci.nsIContentPolicy.TYPE_OTHER,
+  });
+}
+
+function resolve(target) {
+  return new Promise(resolveResult => {
+    pps.asyncResolve(target, 0, {
+      QueryInterface: ChromeUtils.generateQI(["nsIProtocolProxyCallback"]),
+      onProxyAvailable(_request, _channel, info, status) {
+        resolveResult({ info, status });
+      },
+    });
+  });
+}
+
+add_task(async function private_pac_does_not_share_regular_interpreter() {
+  const source =
+    "var count=0;function FindProxyForURL(){return 'PROXY scoped.invalid:'+(8000+(++count));}";
+  Services.prefs.setIntPref("network.proxy.type", 2);
+  Services.prefs.setStringPref(
+    "network.proxy.autoconfig_url",
+    configuration("unused", source).PACURI
+  );
+  const provider = {
+    QueryInterface: ChromeUtils.generateQI(["nsIChromeProxyScopeProvider"]),
+    getConfiguration(target, callback) {
+      if (!target.loadInfo.originAttributes.privateBrowsingId) return false;
+      callback.onConfiguration(configuration("private-context", source));
+      return true;
+    },
+  };
+  pps.registerChromeScopeProvider(provider);
+  try {
+    Assert.equal((await resolve(channel())).info.port, 8001);
+    Assert.equal((await resolve(channel(1))).info.port, 8001);
+    Assert.equal((await resolve(channel())).info.port, 8002);
+    Assert.equal((await resolve(channel(1))).info.port, 8002);
+    pps.retainChromeScopeCaches(["private-context"]);
+    Assert.equal((await resolve(channel(1))).info.port, 8003);
+    Assert.equal((await resolve(channel())).info.port, 8003);
+    pps.clearChromeScopeCaches();
+    Assert.equal((await resolve(channel(1))).info.port, 8001);
+    Assert.equal((await resolve(channel())).info.port, 8004);
+  } finally {
+    pps.unregisterChromeScopeProvider(provider);
+    Services.prefs.clearUserPref("network.proxy.type");
+    Services.prefs.clearUserPref("network.proxy.autoconfig_url");
+  }
+});
+
+add_task(async function chrome_pac_retains_http_path_and_hides_https_path() {
+  const source =
+    "function FindProxyForURL(url){return url.indexOf('/route')>=0 ? 'PROXY full.invalid:80' : 'PROXY stripped.invalid:80';}";
+  const provider = {
+    QueryInterface: ChromeUtils.generateQI(["nsIChromeProxyScopeProvider"]),
+    getConfiguration(_target, callback) {
+      callback.onConfiguration(configuration("chrome-paths", source));
+      return true;
+    },
+  };
+  pps.registerChromeScopeProvider(provider);
+  try {
+    Assert.equal((await resolve(channel())).info.host, "full.invalid");
+    Assert.equal((await resolve(channel(1))).info.host, "full.invalid");
+    Assert.equal(
+      (await resolve(channel(0, "https://floorp-scopes.invalid/route"))).info
+        .host,
+      "stripped.invalid"
+    );
+  } finally {
+    pps.unregisterChromeScopeProvider(provider);
+  }
+});
+
+add_task(async function mandatory_invalid_pac_cancels_channel() {
+  const provider = {
+    QueryInterface: ChromeUtils.generateQI(["nsIChromeProxyScopeProvider"]),
+    getConfiguration(_target, callback) {
+      callback.onConfiguration(
+        configuration("mandatory", "not valid javascript", true)
+      );
+      return true;
+    },
+  };
+  pps.registerChromeScopeProvider(provider);
+  try {
+    const target = channel();
+    const result = await resolve(target);
+    Assert.ok(!Components.isSuccessCode(result.status));
+    Assert.equal(target.status, Cr.NS_ERROR_PROXY_CONNECTION_REFUSED);
+  } finally {
+    pps.unregisterChromeScopeProvider(provider);
+  }
+});
+
+add_task(
+  async function delayed_configuration_cannot_revive_cancelled_request() {
+    let configurationCallback;
+    const provider = {
+      QueryInterface: ChromeUtils.generateQI(["nsIChromeProxyScopeProvider"]),
+      getConfiguration(_target, callback) {
+        configurationCallback = callback;
+        return true;
+      },
+    };
+    pps.registerChromeScopeProvider(provider);
+    try {
+      let count = 0;
+      const completed = Promise.withResolvers();
+      const request = pps.asyncResolve(channel(1), 0, {
+        QueryInterface: ChromeUtils.generateQI(["nsIProtocolProxyCallback"]),
+        onProxyAvailable(_request, _target, _info, status) {
+          ++count;
+          Assert.equal(status, Cr.NS_BINDING_ABORTED);
+          completed.resolve();
+        },
+      });
+      request.cancel(Cr.NS_BINDING_ABORTED);
+      await completed.promise;
+      configurationCallback.onConfiguration(
+        configuration(
+          "cancelled",
+          "function FindProxyForURL(){return 'DIRECT';}"
+        )
+      );
+      await new Promise(resolveTick => do_timeout(0, resolveTick));
+      Assert.equal(count, 1);
+    } finally {
+      pps.unregisterChromeScopeProvider(provider);
+    }
+  }
+);
