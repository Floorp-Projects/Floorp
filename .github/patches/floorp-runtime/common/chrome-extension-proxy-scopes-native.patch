+NS_IMETHODIMP nsAsyncResolveRequest::OnConfiguration(
+    nsIChromeProxyConfiguration* aConfig) {
+  if (!mCallback || mStatus != NS_OK) return NS_OK;
+  nsresult rv = mPPS->ApplyChromeConfiguration(this, aConfig);
+  if (NS_FAILED(rv)) Cancel(rv);
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsProtocolProxyService::RegisterChromeScopeProvider(
+    nsIChromeProxyScopeProvider* aProvider) {
+  NS_ENSURE_ARG_POINTER(aProvider);
+  NS_ENSURE_TRUE(!mChromeScopeProvider || mChromeScopeProvider == aProvider,
+                 NS_ERROR_ALREADY_INITIALIZED);
+  mChromeScopeProvider = aProvider;
+  return NS_OK;
+}
+NS_IMETHODIMP nsProtocolProxyService::UnregisterChromeScopeProvider(
+    nsIChromeProxyScopeProvider* aProvider) {
+  if (mChromeScopeProvider == aProvider) {
+    mChromeScopeProvider = nullptr;
+    mChromePACs.Clear();
+  }
+  return NS_OK;
+}
+NS_IMETHODIMP nsProtocolProxyService::ClearChromeScopeCaches() {
+  mChromePACs.Clear();
+  return NS_OK;
+}
+NS_IMETHODIMP nsProtocolProxyService::RetainChromeScopeCaches(
+    const nsTArray<nsCString>& aKeys) {
+  for (auto iter = mChromePACs.Iter(); !iter.Done(); iter.Next()) {
+    if (!aKeys.Contains(iter.Key())) iter.Remove();
+  }
+  return NS_OK;
+}
+void nsProtocolProxyService::ForgetChromePAC(ChromeScopedPAC* aPAC) {
+  mAllChromePACs.RemoveElement(aPAC);
+}
+nsresult nsProtocolProxyService::ApplyChromeConfiguration(
+    nsAsyncResolveRequest* ctx, nsIChromeProxyConfiguration* config) {
+  if (!config) return ResolveDefault(ctx);
+  ctx->mChromeScoped = true;
+  MOZ_TRY(config->GetMandatory(&ctx->mChromeMandatory));
+  MOZ_TRY(config->GetAllowLoopback(&ctx->mChromeAllowLoopback));
+  uint32_t type;
+  MOZ_TRY(config->GetType(&type));
+  nsCOMPtr<nsIURI> uri;
+  MOZ_TRY(GetProxyURI(ctx->mChannel, getter_AddRefs(uri)));
+  nsProtocolInfo info;
+  MOZ_TRY(GetProtocolInfo(uri, &info));
+  if (type == PROXYCONFIG_DIRECT)
+    return ctx->ProcessLocally(info, nullptr, ctx->mIsSyncOK);
+  NS_ENSURE_TRUE(type == PROXYCONFIG_PAC || type == PROXYCONFIG_WPAD ||
+                     type == PROXYCONFIG_SYSTEM,
+                 NS_ERROR_INVALID_ARG);
+  nsAutoCString key, pacURI;
+  MOZ_TRY(config->GetKey(key));
+  MOZ_TRY(config->GetPACURI(pacURI));
+  NS_ENSURE_TRUE(!key.IsEmpty(), NS_ERROR_INVALID_ARG);
+  RefPtr<ChromeScopedPAC> scope = mChromePACs.Get(key);
+  if (!scope) {
+    scope = new ChromeScopedPAC(this, ctx->mMainThreadTarget);
+    // Publish before loading: network PAC loads must bypass scope selection.
+    mChromePACs.InsertOrUpdate(key, scope);
+    nsresult rv = scope->Init(type, pacURI);
+    if (NS_FAILED(rv)) {
+      mChromePACs.Remove(key);
+      return rv;
+    }
+  }
+  ctx->mChromePAC = scope;
+  return scope->Resolve(uri, ctx, ctx->mResolveFlags);
+}
