+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "nsISupports.idl"
+interface nsIChannel;
+
+/** Privileged per-profile proxy configuration, selected before any PAC runs. */
+[scriptable, uuid(169b7dd7-96c8-4d38-b2da-d4d54df4e0b8)]
+interface nsIChromeProxyConfiguration : nsISupports {
+  readonly attribute AUTF8String key;
+  readonly attribute unsigned long type;
+  readonly attribute AUTF8String PACURI;
+  readonly attribute boolean mandatory;
+  readonly attribute boolean allowLoopback;
+};
+[scriptable, uuid(0d1d3d89-a13f-46ee-b8a6-60db5a22f715)]
+interface nsIChromeProxyConfigurationCallback : nsISupports {
+  /** null continues normal Firefox proxy selection for this channel. */
+  void onConfiguration(in nsIChromeProxyConfiguration config);
+};
+[scriptable, uuid(e82935ac-bda7-4207-83df-cf71b2a85e03)]
+interface nsIChromeProxyScopeProvider : nsISupports {
+  /** Return true only when callback owns the request; callback may be async. */
+  boolean getConfiguration(in nsIChannel channel,
+      in nsIChromeProxyConfigurationCallback callback);
+};
