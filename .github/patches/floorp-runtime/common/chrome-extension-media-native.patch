+TEST(SckPickerRequestQueue, PendingOwnerAndTombstoneCannotBeReassigned) {
+  webrtc::sck_internal::PickerRequestQueue queue;
+  queue.Register(1);
+  queue.Register(2);
+  ASSERT_TRUE(queue.Enqueue(1));
+  ASSERT_TRUE(queue.Enqueue(2));
+  ASSERT_FALSE(queue.Enqueue(2));
+  auto first = queue.StartNext();
+  ASSERT_TRUE(first);
+  EXPECT_EQ(first->owner, 1);
+  EXPECT_FALSE(queue.BeginTerminal());
+  ASSERT_TRUE(queue.MarkPresented(first->generation));
+  EXPECT_FALSE(queue.DiscardUnpresented(first->generation));
+  queue.Remove(1);
+  ASSERT_TRUE(queue.Active());
+  EXPECT_FALSE(queue.Active()->live);
+  EXPECT_FALSE(queue.StartNext());
+  auto terminal = queue.BeginTerminal();
+  ASSERT_TRUE(terminal);
+  EXPECT_FALSE(terminal->live);
+  EXPECT_FALSE(queue.BeginTerminal());
+  EXPECT_FALSE(queue.CompleteTerminal(terminal->generation + 1));
+  ASSERT_TRUE(queue.CompleteTerminal(terminal->generation));
+  auto second = queue.StartNext();
+  ASSERT_TRUE(second);
+  EXPECT_EQ(second->owner, 2);
+  EXPECT_NE(second->generation, first->generation);
+  EXPECT_FALSE(queue.CompleteTerminal(first->generation));
+  // This owner disappeared before presentation, so no native callback exists.
+  queue.Remove(2);
+  ASSERT_TRUE(queue.DiscardUnpresented(second->generation));
+  EXPECT_TRUE(queue.Idle());
+}
+
