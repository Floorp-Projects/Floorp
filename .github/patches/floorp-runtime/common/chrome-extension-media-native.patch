+#ifndef MODULES_DESKTOP_CAPTURE_MAC_SCK_PICKER_QUEUE_H_
+#define MODULES_DESKTOP_CAPTURE_MAC_SCK_PICKER_QUEUE_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <set>
+
+namespace webrtc::sck_internal {
+
+// Main-executor-only ownership of the one process-wide native picker. A dead
+// active owner remains a tombstone until the actual OS terminal callback. A
+// timeout or handle destruction must never make its result belong to a waiter.
+class PickerRequestQueue {
+public:
+  using Owner = intptr_t;
+  struct Ticket {
+    Owner owner;
+    uint64_t generation;
+    bool live;
+  };
+
+  void Register(Owner owner) { live_.insert(owner); }
+
+  void Remove(Owner owner) {
+    live_.erase(owner);
+    pending_.erase(std::remove(pending_.begin(), pending_.end(), owner),
+                   pending_.end());
+  }
+
+  bool Enqueue(Owner owner) {
+    if (!live_.count(owner) || (active_ && active_->owner == owner) ||
+        std::find(pending_.begin(), pending_.end(), owner) != pending_.end()) {
+      return false;
+    }
+    pending_.push_back(owner);
+    return true;
+  }
+
+  std::optional<Ticket> StartNext() {
+    if (active_ || pending_.empty()) {
+      return std::nullopt;
+    }
+    const Owner owner = pending_.front();
+    pending_.pop_front();
+    active_ = Ticket{owner, ++generation_, true};
+    forwarding_ = false;
+    presented_ = false;
+    return Active();
+  }
+
+  bool MarkPresented(uint64_t generation) {
+    if (!active_ || active_->generation != generation || presented_) {
+      return false;
+    }
+    presented_ = true;
+    return true;
+  }
+
+  bool DiscardUnpresented(uint64_t generation) {
+    if (!active_ || active_->generation != generation || presented_) {
+      return false;
+    }
+    active_.reset();
+    return true;
+  }
+
+  std::optional<Ticket> Active() const {
+    if (!active_) {
+      return std::nullopt;
+    }
+    return Ticket{active_->owner, active_->generation,
+                  live_.count(active_->owner) != 0};
+  }
+
+  std::optional<Ticket> BeginTerminal() {
+    if (!active_ || !presented_ || forwarding_) {
+      return std::nullopt;
+    }
+    forwarding_ = true;
+    return Active();
+  }
+
+  bool CompleteTerminal(uint64_t generation) {
+    if (!active_ || !forwarding_ || active_->generation != generation) {
+      return false;
+    }
+    active_.reset();
+    forwarding_ = false;
+    return true;
+  }
+
+  bool Idle() const { return !active_ && pending_.empty(); }
+
+private:
+  std::set<Owner> live_;
+  std::deque<Owner> pending_;
+  std::optional<Ticket> active_;
+  uint64_t generation_ = 0;
+  bool forwarding_ = false;
+  bool presented_ = false;
+};
+
+} // namespace webrtc::sck_internal
+
+#endif // MODULES_DESKTOP_CAPTURE_MAC_SCK_PICKER_QUEUE_H_
