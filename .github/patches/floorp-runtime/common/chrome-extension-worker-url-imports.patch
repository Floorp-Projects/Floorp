+nsresult WorkerScriptLoader::ResolveOwnChromeImportURI(nsIURI* aURI,
+                                                       nsIURI** aResult) {
+  WorkerPrivate* worker = mWorkerRef->Private();
+  worker->AssertIsOnWorkerThread();
+  MOZ_ASSERT(aURI);
+  MOZ_ASSERT(aResult);
+
+  nsCOMPtr<nsIURI> uri = aURI;
+  if (IsDebuggerScript() || !worker->IsServiceWorker() ||
+      !worker->ExtensionChromeCompatibilityEnabled() ||
+      !uri->SchemeIs("chrome-extension")) {
+    uri.forget(aResult);
+    return NS_OK;
+  }
+
+  // This is the actual worker principal's immutable IPC snapshot, not an
+  // addon-supplied URL or a main-thread-only nsIPrincipal/AddonPolicy access.
+  const PrincipalInfo& principal = worker->GetPrincipalInfo();
+  if (principal.type() != PrincipalInfo::TContentPrincipalInfo) {
+    return NS_ERROR_DOM_BAD_URI;
+  }
+  nsCOMPtr<nsIURI> principalURI;
+  MOZ_TRY(NS_NewURI(getter_AddRefs(principalURI),
+                   principal.get_ContentPrincipalInfo().spec()));
+  RefPtr<extensions::WebExtensionPolicyCore> policy =
+      ExtensionPolicyService::GetCoreByURL(extensions::URLInfo(principalURI));
+  if (!policy || !policy->ChromeCompatibilityEnabled() ||
+      !policy->BackgroundServiceWorkerAllowed()) {
+    return NS_ERROR_DOM_BAD_URI;
+  }
+
+  nsAutoCString host;
+  nsAutoCString credentials;
+  int32_t port;
+  MOZ_TRY(uri->GetAsciiHost(host));
+  MOZ_TRY(uri->GetUserPass(credentials));
+  MOZ_TRY(uri->GetPort(&port));
+  if (!credentials.IsEmpty() || port != -1 || host.Length() != 32) {
+    return NS_ERROR_DOM_BAD_URI;
+  }
+  for (uint32_t index = 0; index < host.Length(); ++index) {
+    const char letter = host.CharAt(index);
+    if (letter < 'a' || letter > 'p') {
+      return NS_ERROR_DOM_BAD_URI;
+    }
+  }
+  nsAutoCString expectedId(host);
+  expectedId.AppendLiteral("@chromium-extension");
+  nsAutoCString actualId;
+  policy->Id()->ToUTF8String(actualId);
+  if (actualId != expectedId) {
+    return NS_ERROR_DOM_BAD_URI;
+  }
+
+  nsAutoCString path;
+  MOZ_TRY(uri->GetPathQueryRef(path));
+  // Keep path/query/ref, including paths beginning with //, inside the actual
+  // source extension. Native channels continue to enforce CSP/private/WAR.
+  return NS_NewURI(aResult, "moz-extension://"_ns +
+                                policy->MozExtensionHostname() + path);
+}
