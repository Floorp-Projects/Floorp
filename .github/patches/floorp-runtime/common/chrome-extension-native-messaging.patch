+          }
+        }
+      }
+    }
+    return null;
+  },
+
+  async _lookupChromeManifest(name, context, chromeOrigin) {
+    let paths;
+    if (AppConstants.platform === "win") {
+      const path = this._chromeManifestRegistryPath(name);
+      paths = path ? [path] : [];
+    } else {
+      paths = this._chromeManifestDirectories().map(dir =>
+        PathUtils.join(dir, `${name}.json`)
+      );
+    }
+    for (const path of paths) {
+      let data;
+      try {
+        data = await IOUtils.readJSON(path);
+      } catch (error) {
+        if (DOMException.isInstance(error) && error.name === "NotFoundError") {
+          continue;
+        }
+        Cu.reportError(error);
+        return null;
+      }
+      if (
+        !data ||
+        data.type !== "stdio" ||
