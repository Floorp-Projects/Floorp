+add_task(async function test_floorp_chrome_native_host() {
+  const id = "a".repeat(32);
+  const origin = `chrome-extension://${id}/`;
+  const metadata = { schema_version: 1, original_id: id };
+  const addonId = `${id}@chromium-extension`;
+  const ctx = {
+    ...context,
+    extension: {
+      id: addonId,
+      manifest: {
+        browser_specific_settings: {
+          gecko: { floorp_chrome_extension: metadata },
+        },
+      },
+    },
+  };
+  const name = "floorpchromehost";
+  const chromeUser = PathUtils.join(userDir.path, "chrome-user");
+  const chromeSystem = PathUtils.join(userDir.path, "chrome-system");
+  await IOUtils.makeDirectory(chromeUser);
+  await IOUtils.makeDirectory(chromeSystem);
+  const userPath = PathUtils.join(chromeUser, `${name}.json`);
+  const systemPath = PathUtils.join(chromeSystem, `${name}.json`);
+  const oldDirectories = NativeManifests._chromeManifestDirectories;
+  const oldRegistryPath = NativeManifests._chromeManifestRegistryPath;
+  NativeManifests._chromeManifestDirectories = () => [chromeUser, chromeSystem];
+  NativeManifests._chromeManifestRegistryPath = () => userPath;
+  let app;
+  try {
+    let scriptPath = PathUtils.join(chromeUser, "echo-arguments.py");
+    const script = String.raw`
+import json
+import struct
+import sys
+stdin = getattr(sys.stdin, 'buffer', sys.stdin)
+stdout = getattr(sys.stdout, 'buffer', sys.stdout)
+while True:
+    rawlen = stdin.read(4)
+    if len(rawlen) != 4:
+        break
+    data = stdin.read(struct.unpack('@I', rawlen)[0])
+    reply = json.dumps({'args': sys.argv[1:], 'message': json.loads(data)}).encode('utf-8')
+    stdout.write(struct.pack('@I', len(reply)))
+    stdout.write(reply)
+    stdout.flush()
+`;
+    let command = scriptPath;
+    if (AppConstants.platform === "win") {
+      await IOUtils.writeUTF8(scriptPath, script);
+      command = PathUtils.join(chromeUser, "echo-arguments.bat");
+      await IOUtils.writeUTF8(
+        command,
+        `@ECHO OFF\n"${PYTHON}" -u "${scriptPath}" %*\n`
+      );
+    } else {
+      await IOUtils.writeUTF8(scriptPath, `#!${PYTHON} -u\n${script}`);
+    }
+    await IOUtils.setPermissions(command, 0o755);
+    const host = {
+      name,
+      description: "Chrome protocol test",
+      type: "stdio",
+      path: command,
+      allowed_origins: [origin],
+    };
+    await writeManifest(userPath, host);
+    let found = await lookupApplication(name, ctx);
+    equal(
+      found.chromeOrigin,
+      origin,
+      "Chrome origin is attached only after authorization"
+    );
+    equal(found.manifest.path, command);
+    equal(
+      await lookupApplication(name, context),
+      null,
+      "Firefox extensions do not search Chrome hosts"
+    );
+    equal(
+      await lookupApplication(name, {
+        ...ctx,
+        extension: { ...ctx.extension, manifest: {} },
+      }),
+      null,
+      "The ID suffix alone does not opt an extension in"
+    );
+
+    const nativeContext = new MockContext(addonId);
+    nativeContext.extension.manifest = ctx.extension.manifest;
+    app = new NativeApp(nativeContext, name);
+    const reply = new Promise((resolve, reject) => {
+      app.on("message", (event, message) => resolve(message));
+      app.on("disconnect", (event, error) =>
+        reject(error || new Error("Host disconnected before replying"))
+      );
+    });
+    app.send(
+      new StructuredCloneHolder(
+        "",
+        null,
+        NativeApp.encodeMessage(nativeContext, "hello")
+      )
+    );
+    const received = await reply;
+    deepEqual(
+      received,
+      {
+        args:
+          AppConstants.platform === "win"
+            ? [origin, "--parent-window=0"]
+            : [origin],
+        message: "hello",
+      },
+      "The executable receives the Chrome argv contract and exchanges framed messages"
+    );
+    await app._cleanup();
+    app = null;
+
+    await writeManifest(systemPath, host);
+    for (const allowed_origins of [
+      ["chrome-extension://" + "b".repeat(32) + "/"],
+      ["chrome-extension://*/"],
+      [],
+    ]) {
+      await writeManifest(userPath, { ...host, allowed_origins });
+      equal(
+        await lookupApplication(name, ctx),
+        null,
+        "Denied user host never falls back to a system host"
+      );
+    }
+    await writeManifest(userPath, "{invalid json");
+    equal(
+      await lookupApplication(name, ctx),
+      null,
+      "Malformed user host never falls back to another executable"
+    );
+    await writeManifest(userPath, host);
+
+    const firefoxPath = PathUtils.join(userDir.path, TYPE_SLUG, `${name}.json`);
+    await writeManifest(firefoxPath, {
+      ...templateManifest,
+      name,
+      path: command,
+    });
+    if (registry) {
+      registry.setValue(
+        Ci.nsIWindowsRegKey.ROOT_KEY_CURRENT_USER,
+        `${REGPATH}\\${name}`,
+        "",
+        firefoxPath
+      );
+    }
+    const separatelyAuthorized = await lookupApplication(name, ctx);
+    equal(
+      separatelyAuthorized.chromeOrigin,
+      origin,
+      "A Firefox-only allowlist cannot deny the separately authorized Chrome namespace"
+    );
+    await writeManifest(userPath, { ...host, allowed_origins: [] });
+    await writeManifest(firefoxPath, {
+      ...templateManifest,
+      name,
+      path: command,
+      allowed_extensions: [addonId],
+    });
+    equal(
+      await lookupApplication(name, ctx),
+      null,
+      "Chrome denial never falls back to an authorized Firefox registration"
+    );
+    await IOUtils.remove(firefoxPath);
+  } finally {
+    await app?._cleanup();
+    NativeManifests._chromeManifestDirectories = oldDirectories;
+    NativeManifests._chromeManifestRegistryPath = oldRegistryPath;
+  }
+});
