+// Chrome host lookup is opt-in and never changes the Gecko addon identity.
+add_task(async function test_floorp_chrome_extension_identity() {
+  const id = "a".repeat(32);
+  const makeContext = (metadata, addonId = `${id}@chromium-extension`) => ({
+    extension: {
+      id: addonId,
+      manifest: {
+        browser_specific_settings: {
+          gecko: { floorp_chrome_extension: metadata },
+        },
+      },
+    },
+  });
+  const metadata = { schema_version: 1, original_id: id };
+  equal(
+    NativeManifests.getChromeExtensionOrigin(makeContext(metadata)),
+    `chrome-extension://${id}/`
+  );
+  for (const invalid of [
+    undefined,
+    {},
+    { ...metadata, schema_version: 2 },
+    { ...metadata, original_id: "z".repeat(32) },
+    { ...metadata, original_id: "A".repeat(32) },
+  ]) {
+    equal(NativeManifests.getChromeExtensionOrigin(makeContext(invalid)), null);
+  }
+  equal(
+    NativeManifests.getChromeExtensionOrigin(
+      makeContext(metadata, "other@tests.mozilla.org")
+    ),
+    null
+  );
+});
