+  bool Accept(const Message& message);
+  bool active() const { return active_; }
+
+ private:
+  __strong NSString* appID_;
+  __strong NSString* profileID_;
+  __strong NSString* nonce_;
+  PeerVerifier verifier_;
+  uint64_t lastSequence_ = 0;
+  bool active_ = false;
+};
