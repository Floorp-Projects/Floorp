+class MacWebAppService final : public nsIMacWebAppService, public nsIObserver {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+  NS_DECL_NSIMACWEBAPPSERVICE
+  NS_DECL_NSIOBSERVER
+
+  static already_AddRefed<MacWebAppService> GetSingleton();
