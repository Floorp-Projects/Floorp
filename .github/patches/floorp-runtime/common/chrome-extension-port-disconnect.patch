+/**
+ * Chrome document disconnect listeners keep lastError through the microtask
+ * checkpoint of their dispatch, but must clear it before another task runs.
+ * The native task wrapper drains microtasks before nsThread drains direct tasks.
+ * WorkerPort supplies its own event manager and transports the error separately.
+ */
+class PortDisconnectEvent extends SimpleEventAPI {
+  emit(port, error = null) {
+    const { context } = this;
+    if (!error || !ExtensionUtils.getChromeExtensionId(context.extension)) {
+      return super.emit(port);
+    }
+
+    const fires = [...this.fires];
+    if (!fires.length) {
+      return [];
+    }
+    const lastError = Cu.cloneInto(
+      { message: context.normalizeError(error).message },
+      context.cloneScope
+    );
+    Services.tm.dispatchToMainThreadWithMicroTask(() => {
+      if (!context.active || context.unloaded) {
+        return;
+      }
+      const previousError = context._lastError;
+      const previousChecked = context.checkedLastError;
+      let checked = false;
+      let fired = false;
+      try {
+        for (const fire of fires) {
+          if (!context.active || context.unloaded || !this.fires.has(fire)) {
+            continue;
+          }
+          context.lastError = lastError;
+          fired = true;
+          fire.syncWithoutClone(port);
+          checked ||= context.checkedLastError;
+        }
+      } finally {
+        if (fired) {
+          context.lastError = lastError;
+          context.checkedLastError = checked;
+          const cleanup = () => {
+            if (context._lastError !== lastError) {
+              return;
+            }
+            try {
+              if (!context.checkedLastError) {
+                Cu.reportError(`Unchecked lastError value: ${lastError.message}`);
+              }
+            } finally {
+              context._lastError = previousError;
+              context.checkedLastError = previousChecked;
+            }
+          };
+          try {
+            Services.tm.dispatchDirectTaskToCurrentThread(cleanup);
+          } catch (dispatchError) {
+            cleanup();
+            throw dispatchError;
+          }
+        }
+      }
+    });
+    return [];
   }
 }
 
