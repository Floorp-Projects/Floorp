@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: MPL-2.0
+#ifndef floorp_DisconnectCause_h
+#define floorp_DisconnectCause_h
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace floorp::shim {
+struct DisconnectCause {
+  std::string reason;
+  int64_t wallTimeMs = 0;
+  bool connected = false;
+
+  void Record(std::string_view aReason, int64_t aTime, bool aConnected) {
+    if (reason.empty()) {
+      reason.assign(aReason);
+      wallTimeMs = aTime;
+      connected = aConnected;
+    }
+  }
+  void Reset() { *this = DisconnectCause{}; }
+};
+}  // namespace floorp::shim
+#endif
